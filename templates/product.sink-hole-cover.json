m/watch?v=svikhmFJXMk&t=1s","ratio":"16:9","image":"shopify://shop_images/metpure-faucet-stallation-video-thumbnail-fa-08-nag1.jpg","video_title":"","text_size":"medium","text_color":"white","play_style":"solid","play_size":"medium","autoplay":false,"loop":false,"muted":false,"show_controls":false,"width":"33%","alignment":"start","block_custom_class":"","animations":"inherit"}},"21cb010d-34d1-4659-8c71-5db8458530d7":{"type":"video","settings":{"video_type":"external","video_link":"https://www.youtube.com/watch?v=m7NEkftR-sA","ratio":"16:9","image":"shopify://shop_images/metpure-faucet-stallation-video-thumbnail-fa-05-nag1.jpg","video_title":"","text_size":"medium","text_color":"white","play_style":"solid","play_size":"medium","autoplay":false,"loop":false,"muted":false,"show_controls":false,"width":"33%","alignment":"start","block_custom_class":"","animations":"inherit"}}},"block_order":["56045232-0159-47c6-96d3-69747473606f","ae57530e-c30a-41e7-a127-a3dbc24e6197","21cb010d-34d1-4659-8c71-5db8458530d7"],"disabled":true,"settings":{"heading":"Installation Videos","heading_size":"h3","subheading":"","description":"","header_alignment":"center","container":"container-fluid","color_scheme":"","content_color_scheme":"","enable_parallax":false,"parallax_direction":"vertical","gap":30,"gap_mobile":16,"use_scroll_mobile":false,"padding_top":0,"padding_bottom":0,"custom_class":""}},"a1e1389b-b57d-4b53-913a-0d151266beca":{"type":"collapsible-tabs","blocks":{"template--16039067123903__a1e1389b-b57d-4b53-913a-0d151266beca-168599458993520f09-0":{"type":"item","settings":{"header":"What size hole do we need to have drilled in our granite counter for this?","text_size":"h5","content":"<p>Since this faucet is a non-air gap faucet, all you need is a diameter of 7/16\" hole to fit the stem. However, with a 3/8\" drill bit, you should be able to make that hole to fit the stem of the faucet.</p>","content_page":"","open":false}},"template--16039067123903__a1e1389b-b57d-4b53-913a-0d151266beca-168599458993520f09-1":{"type":"item","settings":{"header":"Does this item include a filter? What is the blue item on the main picture?","text_size":"h5","content":"<p>No, the blue item in picture is a very convenient wrench to secure the faucet to counter.</p>","content_page":"","open":false}},"66f1d7e0-25de-431e-b019-3496414bcce7":{"type":"item","settings":{"header":"Is the line 1/4 or 3/8 & is it copper or polypro?","text_size":"h5","content":"<p>1/4\" for non-airgap installation. The threaded tube is a plated brass, maybe. You can use a 1/4\" or adapt a 3/8\" poly, PEX or copper supply line. I would not recommend copper for any supply lines after filtration. As it tends to react with some substances in the water and oxidizes, creating bad tasting water and foul tasting ice cubes</p>","content_page":"","open":false}},"28fe1476-8d57-463c-ad0e-900ff000252f":{"type":"item","settings":{"header":"Is the black gasket seal right above the counter compleletey concealed by the bottom round \"skirt\" of the faucet and 100% invisible?","text_size":"h5","content":"<p>The diameter of the black gasket is equal to the diameter of the escutcheon plate; therefore, the black seal becomes hidden and invisible when installed.</p>","content_page":"","open":false}},"f4f92b64-ef61-4de4-84b2-3eb7717b1254":{"type":"item","settings":{"header":"Is this considered to have a 1/4 \u201cquick connect\u201d? My system requires it.","text_size":"h5","content":"<p>The faucet does not come with quick connect fitting but comes with compression fitting that will fit 1/4\" tubing. If you need 1/4\" quick connect faucet adapter, look for item B01HUBVDI4.</p>","content_page":"","open":false}},"8d6491b0-ae90-4fc4-a9fd-971a45e25d8b":{"type":"item","settings":{"header":"what's the difference between dark oil rubbed bronze and venetian bronze with this dispenser?","text_size":"h5","content":"<p>Aside from the subtle difference in color, dark oil rubbed bronze has a matte bronze finish and Venetian bronze has a bronze finish with brushed strokes.</p>","content_page":"","open":false}},"bd5adfef-4748-4ea6-b349-2c43f3da2c69":{"type":"item","settings":{"header":"Is the skinny brass faucet lined in plastic so that lead from the brass will not leach out to the RO water or is it unlined?","text_size":"h5","content":"<p>The faucet is lined with plastic where the water touches, so therefore, the water doesn't come in direct contact with the brass material, but just in the plastic lining material.</p>","content_page":"","open":false}},"item_qjEwXb":{"type":"item","settings":{"header":"How does the Water Filtration Faucet work?","text_size":"h5","content":"<p>A: Our faucet is equipped with a built-in <strong>Faucet Filter</strong> that efficiently removes impurities from your tap water. Simply turn on the faucet, and enjoy clean, filtered water immediately.</p>","content_page":"","open":false}},"item_WYTwi6":{"type":"item","settings":{"header":"Can this faucet be used with a Brita Faucet Filter?","text_size":"h5","content":"<p>\u00a0Absolutely! Our <strong>Water Filtration Faucet</strong> is compatible with major filtration systems, including <strong>Brita Faucet Filter</strong>, ensuring even greater water purity.</p>","content_page":"","open":false}},"item_Nfr3ce":{"type":"item","settings":{"header":"What are the benefits of using a Faucet Water Filter?","text_size":"h5","content":"<p>Using a <strong>Faucet Water Filter</strong> provides cleaner, better-tasting water by removing harmful contaminants, reducing the need for bottled water, and offering a more sustainable option for your household.</p>","content_page":"","open":false}},"item_mDxm3K":{"type":"item","settings":{"header":"How do I maintain the Water Filtration Faucet?","text_size":"h5","content":"<p>Maintenance is minimal. Simply replace the <strong>Faucet Filter</strong> as recommended, and clean the faucet with a mild detergent to keep it looking and functioning like new.</p>","content_page":"","open":false}}},"block_order":["template--16039067123903__a1e1389b-b57d-4b53-913a-0d151266beca-168599458993520f09-0","template--16039067123903__a1e1389b-b57d-4b53-913a-0d151266beca-168599458993520f09-1","66f1d7e0-25de-431e-b019-3496414bcce7","28fe1476-8d57-463c-ad0e-900ff000252f","f4f92b64-ef61-4de4-84b2-3eb7717b1254","8d6491b0-ae90-4fc4-a9fd-971a45e25d8b","bd5adfef-4748-4ea6-b349-2c43f3da2c69","item_qjEwXb","item_WYTwi6","item_Nfr3ce","item_mDxm3K"],"disabled":true,"custom_css":[],"settings":{"container":"container-narrow","color_scheme":"","image_position":"left","column_gap":100,"heading":"","heading_size":"h3","subheading":"","description":"","header_alignment":"center","padding_top":0,"padding_bottom":0,"animations":"inherit","custom_class":""}},"custom_liquid_YR6kUM":{"type":"custom-liquid","settings":{"custom_liquid":"<div data-fera-widget='product_reviews' data-fera-id='fwid_2sgautA' data-product-id='{{ product.id }}'></div>","custom_class":""}},"68f12a04-cbbc-4bc6-b531-5093fbd5ee2b":{"type":"blog-posts","disabled":true,"settings":{"container":"container-fluid","design":"layout1","sidebar_show":false,"sidebar_position":"right_column","blog_show_breadcrumb":false,"blog_show_author":true,"blog_show_date":true,"blog_show_tags":true,"blog_show_social":true,"blog_show_comment":true,"show_related_articles":true,"article_align_content":"text-left","article_show_tags":false,"article_show_date":false,"article_show_excerpt":true,"article_show_button":false,"show_toc":true}},"custom_liquid_ai4XDj":{"type":"custom-liquid","disabled":true,"settings":{"custom_liquid":"<div data-fera-widget='all_reviews' data-fera-id='fwid_2sgbrdu'></div>","custom_class":""}}},"order":["breadcrumb","scrolling_promotion_F6rq7J","main","custom_content_AQCUCC","product-details-tabs","a1aeac2b-f20d-4ef1-8da0-8ab6bd7492b6","custom_content_WqqxMz","custom_content_9wLFNa","product_specifications_UADKXg","divider_LxyjnX","custom_content_amDY3W","custom_content_pEL8aA","product-recommendations","0c7d76cd-5e86-4
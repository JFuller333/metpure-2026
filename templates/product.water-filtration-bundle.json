ans-serif;\n        border-collapse: collapse;\n    }\n\n    .row-mv4 {\n        display: flex;\n        border-bottom: 1px solid #000;\n    }\n\n    .cell-mv4 {\n        flex: 1;\n        padding: 12px;\n        border-right: 1px solid #000;\n    }\n\n    .cell-mv4:last-child {\n        border-right: none;\n    }\n\n    .header2-mv4 {\n        background-color: #6BC2FD;\n        color: white;\n        font-weight: bold;\n        font-size: 30px;\n        text-align: center;\n        padding: 15px;\n    }\n\n    .row-mv4 .cell-mv4:first-child {\n        background-color: #6BC2FD;\n        color: white;\n        font-weight: bold;\n    }\n<\/style>"}},"heading_tab_zyyecP":{"type":"heading_tab","settings":{"tab_title":"User Manual","heading_1":"Download - Metpure Versatile 2-4 Stage System Manual","heading_url_1":"https:\/\/cdn.shopify.com\/s\/files\/1\/0620\/0016\/9151\/files\/Metpure_Versatile_2_4_stage_system_manual_web.pdf?v=1664228020","heading_size_1":20,"heading_color_1":"#000000","heading_alignment_1":"center","heading_2":"","heading_url_2":"","heading_size_2":24,"heading_color_2":"#000000","heading_alignment_2":"left","heading_3":"","heading_url_3":"","heading_size_3":24,"heading_color_3":"#000000","heading_alignment_3":"left","heading_4":"","heading_url_4":"","heading_size_4":24,"heading_color_4":"#000000","heading_alignment_4":"left","heading_5":"","heading_url_5":"","heading_size_5":24,"heading_color_5":"#000000","heading_alignment_5":"center","image":"shopify:\/\/shop_images\/0b71b748-5335-404c-9241-9bd1da38935a.png","image_width":400,"image_height":600,"image_radius":0}},"custom_tab_DQ9Wkw":{"type":"custom_tab","settings":{"tab_title":"Shipping & Return","custom_html":"<p style=\"text-align: left; color: black; font-size: 16px;\">\n    This item ships FREE for orders over $79. For orders under that value, we add a small fee to cover the cost of shipment.\n<\/p>\n\n<p style=\"text-align: left; color: black; font-size: 16px; margin-top: 10px;\">\n    We want you to be 100% satisfied with your purchase, so items can be returned or exchanged within 30 days of delivery per our \n    <a href=\"https:\/\/www.metpure.com\/pages\/shipping-refund-policy\" style=\"color: black; text-decoration: underline;\">\n        shipping &amp; returns policy\n    <\/a>.\n<\/p>","custom_css":"<style>\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n    }\n\n    .table {\n        width: 100%;\n        font-family: Arial, sans-serif;\n        border-collapse: collapse;\n        border: 1px solid #ddd;\n        border-radius: 8px;\n        overflow: hidden;\n    }\n\n    .row {\n        display: flex;\n        border-bottom: 1px solid #eee;\n    }\n\n    .cell {\n        flex: 1;\n        padding: 14px 16px;\n        border-right: 1px solid #eee;\n        font-size: 16px;\n        color: #333;\n        background-color: #fff;\n    }\n\n    .cell:last-child {\n        border-right: none;\n    }\n\n    .header {\n        color: #222;\n        font-weight: bold;\n        font-size: 24px;\n        text-align: center;\n        margin-bottom: 16px;\n        background-color: transparent;\n        padding: 0;\n    }\n\n    .row .cell:first-child {\n        background-color: #fff;\n        color: #333;\n        font-weight: bold;\n    }\n\n    .row:last-child {\n        border-bottom: none;\n    }\n<\/style>"}},"faq_tab_C3LW3h":{"type":"faq_tab","settings":{"tab_title":"FAQ's","question_1":"What size hole do we need to have drilled in our granite counter for this?","answer_1":"<p>Since this faucet is a non-air gap faucet, all you need is a diameter of 7\/16\" hole to fit the stem. However, with a 3\/8\" drill bit, you should be able to make that hole to fit the stem of the faucet.<br\/><br\/><\/p>","question_2":"Does this item include a filter? What is the blue item on the main picture?","answer_2":"<p>No, the blue item in picture is a very convenient wrench to secure the faucet to counter.<br\/><br\/><\/p>","question_3":"How often should the filters be replaced?","answer_3":"<p>Filter life span depends heavily on usage, water quality,<br\/>water pressure, and the type of filters being replaced. Typically, pre-filters<br\/>can last between 6-12 months, and reverse osmosis membranes can last 2-4 years.<br\/><br\/><\/p>","question_4":"What does the Metpure Versatile system come with?","answer_4":"<p>All pre-packaged systems come with all the required parts<br\/>for installation, such as tubings, faucet, valves, fittings, tanks, etc, so you<br\/>don’t have to worry about getting parts separately, costing you extra time and<br\/>money.<br\/><br\/><\/p>","question_5":"What is the warranty on the system?","answer_5":"<p>All our Metpure Versatile systems come with a 1-year<br\/>manufactured warranty + 1 additional year upon system registration.<br\/><br\/><\/p>","question_6":"Are the Metpure Versatile systems easy to be installed?","answer_6":"<p>The systems come with a detailed instructional manual and installation videos that can be easily followed step-by-step. Only basic tools<br\/>are required to install the system. Many first time users and installed find<br\/>our systems very easy to install.<br\/><br\/><\/p>","question_7":"How do I know which system is right for me?","answer_7":"<p>We detail and list every system and its filter specifications with as much information as possible. Please read through the listing of each system and determine which one suites your need the best. Or<br\/>contact our customer support at<a href=\"mailto:support@metpure.com\">support@metpure.com<\/a>or call us at 714-202-0019.<br\/><br\/><\/p>","question_8":"How do you customize the Metpure Versatile systems?","answer_8":"<p>We can customize the system to your specification with the<br\/>existing filters and parts available. If you are a business or reseller and<br\/>would like to private label the Metpure Versatile systems, contact our customer<br\/>support at<a href=\"mailto:support@metpure.com\">support@metpure.com<\/a>or call<br\/>us at 714-202-0019 for more information.<br\/><br\/><\/p>","question_9":"","answer_9":"","question_10":"","answer_10":""}}},"block_order":["product_description_tab_nfCgJz","custom_liquid_BG7gzR","custom_tab_kny4e6","heading_tab_zyyecP","custom_tab_DQ9Wkw","faq_tab_C3LW3h"],"disabled":true,"settings":{"section_margin_top":100,"section_margin_bottom":40,"tabs_gap":50,"tabs_content_gap":30,"tabs_alignment":"center","tab_font_size":20,"tab_font_family":"roboto_n4","tab_border_radius":30,"tab_border_color":"#cccccc","tab_hover_color":"#eeeeee","tab_active_color":"#000000","faq_font_size":16,"faq_text_color":"#000000","faq_active_text_color":"#000000","faq_text_alignment":"left","faq_bg_color":"#000000","faq_item_bg_color":"#f5f5f5","faq_border_width":1,"faq_border_color":"#cccccc","faq_border_radius":4}},"custom_content_AHhfPT":{"type":"custom-content","blocks":{"image_zibNTz":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Vase_Style_Set2.jpg","link":"","width":"66%","alignment":"center","block_custom_class":"","animations":"inherit"}},"text_NDyUAF":{"type":"text","settings":{"title":"<h3 style=\"color: #6BC2FD; font-weight: bold;\">Matching Countertop Fixtures<\/h3>","subheading":"","text":"<h3>Design Your Kitchen Style<\/h3><p><br\/>Our Guarantee Color Match ensures every Metpure branded kitchen fixtures—from faucets to soap dispensers and RO faucets have a perfectly coordinated color scheme. This creates a smooth, seamless look that enhances the overall beauty of your kitchen. By choosing our Guarantee Color Match kitchen fixtures, you’re not just getting a color-matched set; you’re investing in a kitchen design that radiates harmony and sophistication, elevating the entire space to a professional standard. <\/p>","width":"33%","alignment":"center","align_text":"left","text_size":"medium","text_color":"inherit","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"","block_custom_class":"","animations":"inherit"}},"image_dMw8dB":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/5-Second_Filter-Replacement_1.png","link":"","width":"66%","alignment":"center","block_custom_class":"","animations":"inherit"}},"text_Ff98UW":{"type":"text","settings":{"title":"<h3 style=\"color: #6BC2FD; font-weight: bold;\">Quick Twist Filters<\/h3>","subheading":"","text":"<h3>Filter replacement in under 5 seconds <br\/><\/h3><p><br\/><strong>Quick Twist Filters<\/strong> make water filter changes fast and as easy as turning a knob—no tools, no mess, and no need to hire a technician. Designed with a simple twist-off mechanism, they streamline filer replacement process while delivering high-performance water filtration power. Enjoy fresh, purified water and keep your system running smoothly with effortless, do-it-yourself convenience.<\/p>","width":"33%","alignment":"center","align_text":"left","text_size":"medium","text_color":"inherit","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"","block_custom_class":"","animations":"inherit"}},"image_6gEh9C":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Powerful_and_effective.webp","link":"","width":"66%","alignment":"center","block_custom_class":"","animations":"inherit"}},"text_Knr3qN":{"type":"text","settings":{"title":"<h3 style=\"color: #6BC2FD; font-weight: bold;\">Premium Filters<\/h3>","subheading":"","text":"<h3>Powerful & Effective<\/h3><p>All systems deliver premium water purification through a 4-stage reverse osmosis water filtration process, removing up to 99% of contaminants like lead, mercury, chlorine, and more for clean, safe drinking water<\/p><p><\/p><p><\/p>","width":"33%","alignment":"center","align_text":"left","text_size":"medium","text_color":"inherit","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"","block_custom_class":"","animations":"inherit"}},"image_txJcED":{"type":"image","settings":{"image":"sho
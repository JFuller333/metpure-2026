<style>
      body {
        font-family: Arial, sans-serif;
        margin: 0px;
      }
      
      .slider {
        width: 100%;
        height: auto; /* changed height to auto for responsiveness */
        position: relative;
        overflow: hidden;
        margin: 20px 0; /* decreased margin for smaller screens */
      }
      
      .slide-container {
        display: flex;
        position: relative; /* changed position to relative for easier centering */
        top: 0;
        left: 0;
        height: 100%;
        width: 100%; /* added width for responsiveness */
        transition: transform 0.3s ease-in-out;
      }
      
      .slide {
        width: 100%;
        padding: 0 20px;
        flex-shrink: 0;
      }
      
      .slide-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100%;
        background-color: #ffff;
        border-radius: 5px;
        position: relative;
      }
      
      .slide-content h2 {
        margin-top: 0;
      }
      
      .button {
        padding: 10px 20px;
        background-color: #000;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease-in-out;
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
      }
      
      .button:hover {
        background-color: #333;
      }
      
      /* Added media query for smaller screens */
      @media only screen and (max-width: 600px) {
        .slider {
          margin: 10px 0; /* decreased margin even further */
        }
        
        .slide-content {
          padding: 20px; /* added padding for better readability */
        }
        
        .button {
          padding: 8px 16px; /* decreased padding for smaller buttons */
          bottom: 10px; /* moved button closer to the bottom */
        }
      }

/* Card1 Styles Begin */

      .card {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 400px;
      background-color: #ffff;
      animation: slide-in 0.5s ease-out;
  }
  
  .card.hidden {
      display: none;
      animation: slide-out 0.5s ease-in;
  }
  
  @keyframes slide-in {
      from {
          transform: translateX(100%);
      }
      to {
          transform: translateX(0);
      }
  }
  
  @keyframes slide-out {
      from {
          transform: translateX(0);
      }
      to {
          transform: translateX(-100%);
      }
  }
  
  .card-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin: 20px auto;
    padding: 20px;
  }
  .card {
    width: 200px;
    height: 150px;
    background-color: #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    margin: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: transform 0.2s ease-in-out;
  }
  .card:hover {
    transform: translateY(-5px);
  }
  .card.selected {
    background-color: #48bb78;
    color: #fff;
  }
  .card.selected:hover {
    transform: translateY(-5px);
    background-color: #2f855a;
  }
  .card-text {
    text-align: center;
    font-size: 20px;
  }

/* Form Input Styles */

.form-group2 {
  margin-bottom: 1.5rem;
  display: flex;
  direction: row;
}

.form-label {
  display: block;
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: #222222;
}

.form-control {
  display: block;
  width: 100%;
  padding: 0.375rem 0.75rem;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5;
  color: #495057;
  background-color: #ffffff;
  background-clip: padding-box;
  border-radius: 1rem;
  transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
}

.form-control:focus {
  outline: none;
  border-color: #80bdff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.form-control:invalid {
  border-color: #dc3545;
} 
  
</style> 

<script>
      const slideContainer = document.querySelector('.slide-container');
      const slides = document.querySelectorAll('.slide');
      const buttons = document.querySelectorAll('.button');

      let slideIndex = 0;

      for (let i = 0; i < buttons.length; i++) {
        buttons[i].addEventListener('click', () => {
          slideIndex++;
          if (slideIndex === slides.length) {
            slideIndex = 0;
          }
          slideContainer.style.transform = `translateX(-${slideIndex * 100}%)`;
        });
      }
    </script>
  </body>
</html>  
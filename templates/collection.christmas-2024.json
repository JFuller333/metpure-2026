(\"close\")[0];\n\n\/\/ When the user clicks the button, open the modal\nbtn.onclick = function() {\n  modal.style.display = \"block\";\n}\n\n\/\/ When the user clicks on <span> (x), close the modal\nspan.onclick = function() {\n  modal.style.display = \"none\";\n}\n\n\/\/ When the user clicks anywhere outside of the modal, close it\nwindow.onclick = function(event) {\n  if (event.target == modal) {\n    modal.style.display = \"none\";\n  }\n}\n\n\n<!--- Shopify Form - Customer Opt In -->\n\n\n<\/script>\n<style>\n.mp-logo4 {\n  width: 145px;\n  height: auto;\n  vertical-align: middle;\n  display: inline-block;\n  margin-bottom: 5px;\n}\n.heading {\n  font-family: Lemon Milk;\n  font-weight: bold;\n  color: #ffff;\n  font-size: 64px;\n}\n.subheading {\n  font-family: Roboto;\n  font-size: 2em;\n}\n\n.modal {\n  position: fixed;\n  z-index: 9999;\n  left: 0;\n  top: 0;\n  width: 100%;\n  height: 100%;\n  overflow: auto;\n  display: none;\n  margin: 10% auto;\n}\n\n\/* Modal Content *\/\n.modal-content {\n  background: radial-gradient(101.01% 96.32% at 11.11% 9.35%, #B8B8B8 0%, #5F5F5F 100%) \/* warning: gradient uses a rotation that is not supported by CSS and may not behave as expected *\/;\n  margin: auto;\n  padding: 20px;\n  border-radius: 20px;\n  width: 80%;\n  max-width: 700px;\n  position: relative;\n}\n\n\/* Close Button *\/\n.close {\n  position: absolute;\n  top: 0;\n  right: 0;\n  font-size: 28px;\n  font-weight: bold;\n  color: #fff;\n  padding: 12px 16px;\n  transition: all 0.2s ease-in-out;\n}\n\n.close:hover,\n.close:focus {\n  color: #000;\n  text-decoration: none;\n  cursor: pointer;\n}\n\n\/* Responsive Styles *\/\n@media only screen and (max-width: 767px) {\n  .modal {\n    width: 100%;\n    height: 75%;\n    top: 0;\n    left: 0;\n    margin: 0;\n    padding: 0;\n  }\n  .modal-dialog {\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    padding: 0;\n  }\n  .modal-content {\n    width: 100%;\n    height: 100%;\n  }\n  .modal-content iframe {
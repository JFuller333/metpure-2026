{"sections":{"c0ad409d-6c31-4b96-badc-575b00c923fa":{"type":"image-with-text-2","custom_css":[],"settings":{"color_scheme":"","container":"w-full","hero_size":"adapt","show_overlay":false,"image":"shopify:\/\/shop_images\/Year_End_Promo_Banner_Desktop_Size_9566a45e-4377-44fa-b118-57b3b8c59026.webp","image_link":"","parallax":false,"parallax_direction":"vertical","content_in_container":false,"content_position":"center middle","text_alignment":"center","text_size":"medium","text_color":"white","title":"","subtitle":"","text":"","button_label":"","button_link":"","button_style":"sf__btn-primary","button_size":"","text_alignment_mobile":"left","mb_image":"shopify:\/\/shop_images\/Year_End_Promo_Banner_mobile_Size_73d73b59-e665-42f1-841f-64b9a9a0ebcc.webp","use_content_above":false,"custom_class":"","animations":"inherit","enable_bg_zoom_effect":true}},"bf6d4be9-f6a9-462a-9501-e871b8ce3a57":{"type":"divider","settings":{"divider-visibility":"showboth","hd_border_color":"#aaaaaa","divider_border":false,"divider_spacing":53,"div_width":80,"hd_border":2,"border_line":1,"div_style":"solid","border_rad":2}},"custom_liquid_Neyj89":{"type":"custom-liquid","disabled":true,"settings":{"custom_liquid":"<div class=\"gradient-background\" style=\"max-width: 1000px; margin: 0 auto; font-family: Arial, sans-serif; border-radius: 20px; display: flex; padding: 20px; justify-content: space-between;\">\n    <!-- Left Side: Calculator Form -->\n    <div style=\"flex: 1; padding-right: 20px;\">\n        <h3 class=\"title2\">BULK VOLUME SAVINGS CALCULATOR<\/h3>\n\n        <label for=\"product\" style=\"display: block; margin-bottom: 8px; font-size: 16px; color: #fff;\">Select Water Filter<\/label>\n        <!-- Custom Select with Images and Titles -->\n        <div class=\"custom-select\" style=\"position: relative; width: 100%; padding: 10px; margin-bottom: 16px; font-size: 16px; border: 1px solid #ccc; border-radius: 4px;\">\n            <div id=\"productDropdown\" class=\"dropdown-content\">\n                <div class=\"dropdown-item default-item\">\n                    <span>Select option<\/span>\n                <\/div>\n                {% for product in collections['standard-filters'].products %}\n                    <div class=\"dropdown-item\" data-price=\"{{ product.price | money_without_currency }}\" data-image=\"{{ product.featured_image | img_url: 'thumb' }}\" data-id=\"{{ product.id }}\">\n                        <img src=\"{{ product.featured_image | img_url: 'thumb' }}\" alt=\"{{ product.title }}\" style=\"width: 30px; height: 30px; border-radius: 50%; margin-right: 10px;\">\n                        <span>{{ product.title | truncate: 30 }}<\/span> - {{ product.price | money }}\n                    <\/div>\n                {% endfor %}\n            <\/div>\n        <\/div>\n\n        <label for=\"bulkQuantity\" style=\"display: block; margin-bottom: 8px; font-size: 16px; color: #fff;\">Select Quantity<\/label>\n        <input type=\"number\" id=\"bulkQuantity\" value=\"10\" step=\"1\" style=\"width: 100%; padding: 10px; margin-bottom: 16px; font-size: 16px; border: 1px solid #ccc; border-radius: 4px; background-color: white;\" disabled>\n\n        <label for=\"discountPercentage\" style=\"display: block; margin-bottom: 8px; font-size: 16px; color: #fff;\">Discount Percentage (%)<\/label>\n        <!-- Default discount percentage is now set to 15 -->\n        <input type=\"number\" id=\"discountPercentage\" value=\"15\" step=\"1\" style=\"width: 100%; padding: 10px; margin-bottom: 16px; font-size: 16px; border: 1px solid #ccc; border-radius: 4px; background-color: white;\" disabled>\n\n        <!-- Left-aligned totals with color styling -->\n        <p style=\"font-size: 18px; font-weight: bold; text-align: left; color: #fff;\">Total Price: $<span id=\"totalPrice\">0<\/span><\/p>\n        <p style=\"font-size: 18px; font-weight: bold; text-align: left; color:red ;\">Total Savings: $<span id=\"savings\">0<\/span><\/p>\n        <p style=\"font-size: 18px; font-weight: bold; text-align: left; color:green ;\">Discounted Price: $<span id=\"discountedTotal\">0<\/span><\/p>\n    <\/div>\n\n    <!-- Right Side: Placeholder for Image -->\n    <div style=\"flex: 1; text-align: center;\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0620\/0016\/9151\/files\/eoy-discount.webp?v=1731434375\" alt=\"Placeholder Image\" style=\"max-width: 100%; height: auto; border-radius: 12px;\"> \n    <\/div> \n<\/div>\n\n<script>\n    \/\/ Function to handle dropdown interaction\n    document.querySelector('.custom-select').addEventListener('click', function(event) {\n        event.stopPropagation(); \/\/ Prevent click event from propagating to the document\n        document.querySelector('.dropdown-content').classList.toggle('show');\n    });\n\n    \/\/ Event listener to handle product selection\n    document.querySelectorAll('.dropdown-item').forEach(item => {\n        item.addEventListener('click', function() {\n            \/\/ If it's the default \"Select option\" item, do nothing\n            if (item.classList.contains('default-item')) return;\n\n            var selectedProductTitle = item.querySelector('span').innerText;\n            var selectedProductPrice = item.getAttribute('data-price');\n\n            \/\/ Update the dropdown to show the selected product\n            document.querySelector('.dropdown-item.default-item span').innerText = selectedProductTitle;\n\n            \/\/ Enable Bulk Quantity and Discount Percentage inputs after product selection\n            document.getElementById('bulkQuantity').disabled = false;\n            document.getElementById('discountPercentage').disabled = false;\n\n            \/\/ Trigger the calculation with the selected product's price\n            calculateSavings(selectedProductPrice);\n\n            \/\/ Close the dropdown\n            document.querySelector('.dropdown-content').classList.remove('show');\n        });\n    });\n\n    \/\/ Function to calculate the savings and discounted price\n    function calculateSavings(productPrice) {\n        var pricePerUnit = parseFloat(productPrice);\n        var bulkQuantity = parseInt(document.getElementById('bulkQuantity').value);\n        var discountPercentage = parseFloat(document.getElementById('discountPercentage').value);\n\n        \/\/ Calculate the total price before any discounts\n        var totalPrice = pricePerUnit * bulkQuantity;\n\n        \/\/ Apply custom discount percentage\n        var customDiscountSavings = (totalPrice * discountPercentage) \/ 100;\n        var totalAfterCustomDiscount = totalPrice - customDiscountSavings;\n\n        \/\/ Apply an additional 15% discount to the already discounted total\n        var additionalDiscountPercentage = 15;\n        var additionalDiscountSavings = totalAfterCustomDiscount * (additionalDiscountPercentage \/ 100);\n        var discountedTotalPrice = totalAfterCustomDiscount - additionalDiscountSavings;\n\n        \/\/ Display the results\n        document.getElementById('totalPrice').innerText = totalPrice.toFixed(2);\n        document.getElementById('savings').innerText = (customDiscountSavings + additionalDiscountSavings).toFixed(2);\n        document.getElementById('discountedTotal').innerText = discountedTotalPrice.toFixed(2);\n    }\n\n    \/\/ Initial calculation (showing 0 savings until a product is selected)\n    calculateSavings(0);\n\n    \/\/ Close the dropdown if the user clicks outside of it\n    document.addEventListener('click', function(event) {\n        if (!document.querySelector('.custom-select').contains(event.target)) {\n            document.querySelector('.dropdown-content').classList.remove('show');\n        }\n    });\n<\/script>\n\n<style>\n    .gradient-background {\n        background: linear-gradient(135deg, #2698D7, #87CEEB); \/* Gradient from #2698D7 to a light blue *\/\n        background-size: 200% 200%; \/* To enable animation movement *\/\n        animation: gradient-animation 5s ease infinite; \/* Animation effect *\/\n        border-radius: 20px;\n        padding: 20px;\n        display: flex;\n        justify-content: space-between;\n    }\n\n    \/* Animation for gradient movement *\/\n    @keyframes gradient-animation {\n        0% {\n            background-position: 0% 50%;\n        }\n        50% {\n            background-position: 100% 50%;\n        }\n        100% {\n            background-position: 0% 50%;\n        }\n    }\n\n    \/* Style for the title with increased font size (now using .title2) *\/\n    .title2 {\n        text-align: center;\n        color: #f5f90b;\n        font-size: 2em; \/* Set font size to 2em *\/\n        font-weight: bold; \/* Make the title bold *\/\n        margin-bottom: 16px; \/* Adjust spacing as needed *\/\n    }\n\n    .flash-ribbon {\n        display: inline-block;\n        padding: 4px 10px;\n        margin: 0 auto; \/* Center the ribbon *\/\n        background: linear-gradient(45deg, #c6a84b, #8b6914); \/* Gradient for ribbon *\/\n        color: white;\n        font-weight: bold;\n        border-radius: 8px;\n        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2); \/* Shadow for depth *\/\n    }\n\n    .custom-select {\n        position: relative;\n        width: 100%;\n        cursor: pointer;\n    }\n\n    .dropdown-content {\n        position: absolute;\n        width: 100%;\n        background-color: #fff;\n        border: 1px solid #ccc;\n        border-radius: 4px;\n        max-height: 200px;\n        overflow-y: auto;\n        z-index: 99;\n        display: none;\n    }\n\n    .dropdown-item {\n        display: flex;\n        align-items: center;\n        padding: 10px;\n        cursor: pointer;\n    }\n\n    .dropdown-item:hover {\n        background-color: #f0f0f0;\n    }\n\n    .dropdown-item img {\n        width: 30px;\n        height: 30px;\n        border-radius: 50%;\n        margin-right: 10px;\n    }\n\n    .dropdown-item.default-item {\n        color: #aaa;\n        font-style: italic;\n    }\n\n    .dropdown-content.show {\n        display: block;\n    }\n\n    \/* Additional style to make input background white *\/\n    input[type=\"number\"], .custom-select {\n        background-color: white;\n    }\n<\/style>","custom_class":""}},"custom_content_CJJMzG":{"type":"custom-content","blocks":{"text_GTznUQ":{"type":"text","settings":{"title":"Comprehensive Contaminant Removal","subheading":"","text":"","width":"33%","alignment":"center","align_text":"center","text_size":"medium","text_color":"inherit","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"","block_custom_class":"","animations":"inherit"}},"text_BdkwDD":{"type":"text","settings":{"title":"Improved Water Taste and Quality","subheading":"","text":"","width":"33%","alignment":"center","align_text":"left","text_size":"medium","text_color":"inherit","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"","block_custom_class":"","animations":"inherit"}},"text_WzaYjE":{"type":"text","settings":{"title":"Enhanced System Longevity and Efficiency","subheading":"","text":"","width":"33%","alignment":"center","align_text":"left","text_size":"medium","text_color":"inherit","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"","block_custom_class":"","animations":"inherit"}},"image_with_text_UQ7pzJ":{"type":"image_with_text","settings":{"width":"50%","link":"","layout":"left","image_column_size":"6","hover_effect":false,"title":"Image with text","sub_title":"","text":"<p>Pair large text with an image to give focus to your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.<\/p>","text_size":"medium","content_alignment":"left","button_label":"Shop Collection","button_link":"","button_style":"m-button--link","button_size":"","block_custom_class":"","animations":"inherit"}}},"block_order":["text_GTznUQ","text_BdkwDD","text_WzaYjE","image_with_text_UQ7pzJ
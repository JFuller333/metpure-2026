r_alignment":"center","container":"container-fluid","color_scheme":"","content_color_scheme":"","enable_parallax":false,"parallax_direction":"vertical","gap":30,"gap_mobile":10,"use_scroll_mobile":true,"padding_top":0,"padding_bottom":0,"custom_class":""}},"c9acc830-beba-4465-a65f-ea784fc99840":{"type":"custom-content","blocks":{"template--15970753740991__c9acc830-beba-4465-a65f-ea784fc99840-167485415232c88360-0":{"type":"text","settings":{"title":"Metpure Faucet Catalog","subheading":"","text":"<p>Take a look at our various styles, models, and finishes in our exclusive RO Faucets catalog brochure. Be sure to find the right faucet to suit your needs.<\/p>","width":"50%","alignment":"center","align_text":"left","text_size":"medium","text_color":"black","button_label":"Download","button_link":"https:\/\/cdn.shopify.com\/s\/files\/1\/0620\/0016\/9151\/files\/wholesale_faucet_catalog_0123.pdf?v=1674862603","button_style":"sf__btn-primary","button_size":"","block_custom_class":"","animations":"inherit"}},"5aaa8f60-5c71-4df5-90c9-2cf606b84f77":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/metpure-ro-faucet-catalog.webp","link":"","width":"50%","alignment":"center","block_custom_class":"","animations":"inherit"}}},"block_order":["template--15970753740991__c9acc830-beba-4465-a65f-ea784fc99840-167485415232c88360-0","5aaa8f60-5c71-4df5-90c9-2cf606b84f77"],"settings":{"heading":"","heading_size":"h3","subheading":"","description":"","header_alignment":"center","container":"container-fluid","color_scheme":"","content_color_scheme":"","enable_parallax":false,"parallax_direction":"vertical","gap":30,"gap_mobile":16,"use_scroll_mobile":false,"padding_top":0,"padding_bottom":0,"custom_class":""}},"custom_content_BgnCkF":{"type":"custom-content","blocks":{"text_NeKPPf":{"type":"text","settings":{"title":"Talk about your brand","subheading":"","text":"<p><strong>What is Air Gap faucets? <\/strong>Air Gap faucets dispense water just like standard Non-Air Gap faucets, but have an Air Gap drip venting built into the base of the faucet. Air Gap faucets are designed to prevent backflow of drain\/rejected water into your reverse osmosis water filtration unit by incorporating a \"backflow prevention\" method called an \"Air gap\". In the event of clogging of the drain pipe, a small amount of air, rather than drain water, would go back into the RO system, thus protecting the system from contamination.<\/p><p><\/p><p><strong>Do I need an Air Gap faucet ?<\/strong>Some reverse osmosis (RO) systems may be designed with tubings ready to be attached to an Air Gap faucet or a Non-Air Gap faucet. However, generally speaking,  all RO systems can work with either an Air Gap or a Non-Air Gap faucet. With this in mind, the need for an Air Gap faucet is not dictated by the RO system installed, but rather the municipal building code <em>where <\/em>the system is installed. Some jurisdiction only allows for the use of an Air Gap faucet to be installed with a RO system.  So, if unsure an Air Gap faucet is needed, search up on the building code under the jurisdiction where the system is going to be installed.<\/p><p><\/p><p><strong>What comes in Metpure Air Gap faucets? <\/strong>To achieve backflow prevention on Air Gap faucets, the design on the Air Gap faucets are different than the Non-Air Gap counterparts. Besides the air gap vent hole on the base of the airgap faucet, two additional ports, drain IN and drain OUT,  need to be added to the bottom of the faucet. Metpure Air Gap faucets have included these ports in the design, <em>plus<\/em>, the Air Gap faucets all come with pre-attached tubings to these ports for easy installations. <\/p>","width":"50%","alignment":"center","align_text":"center","text_size":"medium","text_color":"inherit","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"","block_custom_class":"","animations":"inherit"}},"image_h6ihYF":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/
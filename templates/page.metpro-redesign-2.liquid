<body>
<section>
  <div class="bg-auto w-full py-8 md:min-h-550 bg-cover" style="background-image: url('https://cdn.shopify.com/s/files/1/0620/0016/9151/files/Rectangle_143.jpg?v=1679435373'); background-size: cover;"> 
  <div class="container">
    <div class="flex flex-col items-center">
      <div class="container-sm">
        <div class="flex justify-center pt-8" style="justify-content: center;margin-top: 3rem;margin-bottom: 2rem;">
          <img class="sm:w-auto logo-desktop" src="https://cdn.shopify.com/s/files/1/0620/0016/9151/files/metpure_logo_white_1.svg?v=1679957006" width="25%" display="block" atl="metpro-logo"></div>
          <p class="heading py-10 md:py-16 text-center md:pb-16" style="font-family: Lemon Milk; font-weight: bold;text-align: center; margin-bottom: 4rem;">ONLINE WHOLESALE SUPPLIER <br> FOR TRADE PROFESSIONALS.</p>
         <p class="subheading text-center py-2" style="text-align: center; color: #ffff; font-wieght: bold;">Join&nbsp <img class="mp-logo" src="https://cdn.shopify.com/s/files/1/0620/0016/9151/files/Metpro_logo_white_1.png?v=1680199882"> for FREE and get wholesale price on water filtration and plumbing supplies!</p>
        <!-- Shopify Sign-Up Form -->
        {% form 'customer' %}
          {% if form.posted_successfully? %} <script> window.location = "/pages/met-pro-onboarding"; </script> 
           {% endif %}
          <div class="form-wrapper" style="text-align: center;padding: 3%">
            <form id="customer-form" method="post" style="display: inline-block;">
              <input type="hidden" name="contact[tags]" value="Marketing,MPLandingPG,MPRStep1">
              <div class="form-fields">
                <input type="text" id="first-name" name="contact[first_name]" placeholder="First Name" style="font-size: 24px; padding: 20px; border-radius: 20px; border: none; margin-right: 5px; margin-top: 10px; width: 300px;" required>
                <input type="email" id="email" name="contact[email]" placeholder="Email" style="font-size: 24px; padding: 20px; border-radius: 20px; border: none; margin-right: 5px; margin-top: 10px; width: 300px;" required>
                <div class="sms-consent" style="margin: 15px 0; color: white; display: flex; align-items: center; justify-content: center;">
                  <input type="checkbox" id="sms-consent1" name="contact[accepts_sms]" style="margin-right: 8px;">
                  <label for="sms-consent1" style="display: inline-block;">I agree to receive SMS updates about products, services and promotions</label>
                </div>
                <button type="submit" class="btn-black" style="font-size: 24px; padding: 20px 35px; border-radius: 20px; margin-top: 10px; border: none; background-color: black; color: white;">Start Free Membership</button>
              </div>
            </form>
          </div>
        {% endform %}
        <!-- Shopify Sign-up Form End -->
        <!--<div class="globo-formbuilder" data-id="MTA5NDM5"></div> -->          
        <p class="subheading text-center pt-4" style="color: white;font-size: 16px;text-align: center;margin-bottom: 2rem;margin-top: 2rem; ">To get wholesale price, you must be a Met Pro member. Membership is restricted to trade professionals such as suppliers, <br>plumbers, installers, technicians, and business entities engaging in selling plumbing and water filtration products. </p>
        <!-- Video Button & Modal --> 
       <div class="flex items-center justify-center h-full" style="justify-content: center;">
        <div class="text-center my-4">
          <u><button id="watch-video-button" class="sf__btn sf__btn-primary" style="font-size: 24px; padding: 15px 35px; border-radius: 20px; margin-top: 10px; border: none; background-color: linear-gradient(125.47deg, #E3E3E3 29.2%, #A1A1A1 72.75%); color: white;background-color:black;">Learn More</button></u>
        </div>
      </div>
        <div id="video-modal" class="modal">
          <div class="modal-content">
            <span class="close">&times;</span>
            <div class="video-container">
            <a href="https://link.metpure.com/metpro_membership_video" target="_blank">
              <iframe src="https://www.youtube.com/embed/deq75as-soU?showinfo=0" frameborder="0" allowfullscreen></iframe>
            </a>
          </div>
          </div>
        </div>
      <!-- Video Button & Modal End -->
      <img class="mx-auto img-desktop" src="https://cdn.shopify.com/s/files/1/0620/0016/9151/files/Metpro_website_main_2.png?v=1680133242" width="100%" style="padding-bottom: 30px;"></img>
          </div>
        </div>
      </div>
    </div>
</section>


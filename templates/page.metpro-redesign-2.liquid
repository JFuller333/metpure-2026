.modal {
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  display: none;
  margin: 10% auto;
}

/* Modal Content */
.modal-content {
  margin: auto;
  padding: 20px;
  border-radius: 20px;
  width: 80%;
  max-width: 700px;
  position: relative;
}
iframe {
  border: none;
  outline: none;
  border-radius: 20px;
}

/* Close Button */
.close {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding-right: 2px;
  transition: all 0.2s ease-in-out;
}

.close:hover,
.close:focus {
  color: #000;
  text-decoration: none;
  cursor: pointer;
}

.video-container {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    overflow: hidden;
  }
  
  .video-container iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border: none;
  }
  
  /* Responsive adjustments for mobile */
  @media only screen and (max-width: 767px) {
    .video-container {
      padding-bottom: 75%; /* 4:3 aspect ratio */
    }
  }
  
  @media only screen and (max-width: 479px) {
    .video-container {
      padding-bottom: 100%; /* 1:1 aspect ratio */
    }
  }
/* Responsive Styles */
@media only screen and (max-width: 767px) {
  .modal {
    width: 100%;
    height: 75%;
    top: 0;
    left: 0;
    margin: 0;
    padding: 0;
  }
  .modal-dialog {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }
  .modal-content {
    width: 100%;
  }
  .modal-content iframe {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .modal-body {
    height: calc(100% - 56px);
  }
}



<div>
      <div class="full-welcome-container">
      <div class="flex flex-col items-center welcome-container">
        <h3 class="font-montserrat font-bold"> Congratulations!</h3>

         <div class="py-4">
         <h4 class="text-center"> You are now a </h4> 
            <img class="metpro-members-only-logo w-full md:w-2/3" 
     src="https://cdn.shopify.com/s/files/1/0620/0016/9151/files/Metpro_Member__logo.png?v=1680626123" 
     style="min-width: 30%; max-width: 90%;">
         </div>
        <div>
        <p style="text-align:center; padding-bottom: 15x; margin: 5px;">Sign-in using your username and password.</p>
        </div>
        
              <div>
                    <div class="metpro-login-form"> 
                    <script>
                          if( sessionStorage.getItem("wcp_account_login") != null ){
                            sessionStorage.removeItem("wcp_account_login");
                          }
                      </script> 
                    <div data-login-form class="flex flex-col-reverse">
                        {% form 'customer_login' %}
                        {%- comment -%}
                        {% if form.posted_successfully? %}
                        <div class="notification show success mb-3 text-base ">
                            {{ 'customer.recover_password.success' | t }}
                        </div>
                        {% endif %}
                        {%- endcomment -%}
                        {% render 'form__error', form: form %}
                    
                        <input type="email" name="customer[email]" placeholder="{{ 'customer.login.email' | t }}" class="form-control" />
                        <input type="password" name="customer[password]" placeholder="{{ 'customer.login.password' | t }}" class="form-control" />
                        <input type="hidden" name="return_to" value="/account#/orders">
                      
                        <a class="underline block my-3 sf-customer__reset-password-btn">{{ 'customer.login.forgot_password' | t }}</a>
                        <button class="sf__btn sf__btn-primary mt-4  mb-3 w-full" type="submit">
                        <a>Login</a> 
                        </button>
                        <br>
                        <div>
                        </h5>
                        </div>
                        {% endform %}
                        <h4 style="text-align:center;padding-bottom: 5%"></h4>
                  </div>
            </div>                
      </div>
    <p class="text-center py-2" style="color: grey;"> © 2023 Metpure Inc. All Rights Reserved.</p>  
</div>


<style> 


body {
  background: #f5f5f5;
  padding: 2%;
}

  
.full-welcome-container {
  max-width: 700px;
  margin: 0 auto;
  background-color: #FFFFFF;
  border-radius: 8px;
  box-shadow: 0px 0px 15px rgba(0,0,0,0.1);
  padding: 48px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 80vh;
}
  
.welcome-container { 
   border-radius: 30px;
}
.metpro-members-only-logo {
    margin: auto;
}
@media (min-width: 375px) {
    .metpro-login-form  {
    padding: 0 10%;
    }
}
@media (min-width: 575px) {
    .metpro-login-form {
        padding: 0 10%;
    }
</style>   




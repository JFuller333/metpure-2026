 hand.<\/p>","width":"25%","alignment":"start","align_text":"left","text_size":"medium","text_color":"black","button_label":"","button_link":"","button_style":"sf__btn-primary","button_size":"","block_custom_class":""}},"ebac487f-f22e-43cf-b1f7-627188a205b7":{"type":"text","settings":{"title":"","subheading":"4 Adapter Sizes","text":"<p>Whether you need 3\/8\" or 1\/4\" straignts or reducers, we got you covered.<\/p>","width":"25%","alignment":"start","align_text":"left","text_size":"medium","text_color":"black","button_label":"","button_link":"","button_style":"sf__btn-primary","button_size":"","block_custom_class":""}}},"block_order":["template--16004927946943__3545c748-17b4-4610-9b4c-ad22c04c89ae-167898636713a67f55-1","f258a1a3-623d-448c-908f-a266311278be","d7169af0-bec9-452a-b55b-23a2aabf6a5d","ca323cb2-923a-48ab-975b-d4e1b652846e","2fcdc034-9707-4bad-a15c-9af0a8515083","c310c175-4532-4935-9b35-481e05988d0f","6e354834-53ee-4ba3-8e2d-d1088c1ba086","96c61a9e-1e8c-47cf-b5b8-14bb77054e33","ebac487f-f22e-43cf-b1f7-627188a205b7"],"settings":{"heading":"","subheading":"","description":"","header_alignment":"center","container":"container","gap":30,"gap_mobile":16,"use_scroll_mobile":false,"custom_class":""}},"main":{"type":"main-collection-product-grid","disabled":true,"settings":{"container":"container-fluid","grid_layout":"grid","grid_columns":"4","show_columns_switcher":false,"pagination_limit":12,"paginate_type":"infinite","show_sorting":true,"show_filter":true,"filters_type":"storefront_filters","sidebar":"leftColumn","sidebar_title":"","limit_height_widget":false,"limit_height":300,"change_product_variant_on_fitlering":true,"show_product_count":true,"collapsed_groups":"Brand, Vendor, Size","color_swatches":"color,colour,couleur,farbe"}},"28b3bffd-3be4-4f06-88d8-ab60378d2c5a":{"type":"custom-content","settings":{"heading":"","subheading":"","description":"","header_alignment":"center","container":"container-fluid","gap":30,"gap_mobile":16,"use_scroll_mobile":false
{%- style -%}
  .blog-section {
    padding: 60px 80px;
    background-color: {{ section.settings.section_bg_color }};
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    gap: 20px;
  }

  .blog-title {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    margin: 0;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .blog-card {
    position: relative;
    border-radius: 0;            /* removed radius */
    overflow: hidden;
    height: 400px;
    transition: filter 0.2s ease;
    cursor: pointer;
    box-shadow: none;            /* ensure no shadow */
  }

  .blog-card:hover {
    filter: brightness(1.02);    /* tiny, clean hover cue; no movement */
  }

  .blog-card:focus-visible {
    outline: 2px solid rgba(0,0,0,.4);
    outline-offset: 2px;
  }

  .blog-card-image {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness({{ section.settings.image_brightness }}%);
    transition: filter 0.2s ease;
  }

  .blog-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,0.6)); /* softer, cleaner */
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
  }

  .divider-line {
    width: 100%;
    height: 1px;
    background-color: rgba(255,255,255,0.22); /* subtle line */
    margin: {{ section.settings.line_spacing }}px 0;
  }

  .blog-meta {
    display: flex;
    justify-content: space-between;
    font-size: {{ section.settings.meta_text_size }}px;
    color: {{ section.settings.meta_text_color }};
    opacity: 0.9;
  }

  .blog-card-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    text-align: {{ section.settings.title_alignment }};
    margin: 0;
    color: {{ section.settings.title_color }};
    line-height: 1.25;
  }

  .view-all-btn {
    padding: {{ section.settings.button_padding }}px {{ section.settings.button_padding | times: 2 }}px;
    border-radius: 0;            /* removed radius */
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_text_size }}px;
    text-decoration: none;
    transition: opacity 0.2s ease;
    box-shadow: none;            /* ensure no shadow */
  }

  .view-all-btn:hover { opacity: 0.9; }

  @media (prefers-reduced-motion: reduce) {
    .blog-card, .blog-card-image, .view-all-btn { transition: none; }
  }

  @media screen and (max-width: 1200px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media screen and (max-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 768px) {
    .blog-section { padding: 40px 30px; }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .blog-header {
      flex-direction: column;
      text-align: center;
    }

    .blog-card { height: 300px; }

    .blog-card-title {
      font-size: {{ section.settings.mobile_title_size }}px;
      text-align: {{ section.settings.mobile_title_alignment }};
    }

    .blog-meta { font-size: {{ section.settings.mobile_meta_text_size }}px; }

    .blog-card-overlay { padding: 16px; }
  }
{%- endstyle -%}

<div class="blog-section">
  <div class="page-width">
    <div class="blog-header">
      <h2 class="blog-title">{{ section.settings.heading }}</h2>
      <a href="{{ section.settings.button_link }}" class="view-all-btn">
        {{ section.settings.button_text }}
      </a>
    </div>

    <div class="blog-grid">
      {%- for article in blogs[section.settings.blog].articles limit: section.settings.post_limit -%}
        <a href="{{ article.url }}" class="blog-card">
          {%- if article.image -%}
            {{ article.image | image_url: width: 800 | image_tag: class: 'blog-card-image', loading: 'lazy' }}
          {%- endif -%}
          <div class="blog-card-overlay">
            <h3 class="blog-card-title">{{ article.title }}</h3>
            <div class="divider-line"></div>
            <div class="blog-meta">
              <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
              <span>{{ article.content | strip_html | size | divided_by: 250 | round }} min read</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog Posts Grid",
  "settings": [
    { "type": "color", "id": "section_bg_color", "label": "Section Background Color", "default": "#FFFFFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Blog Posts" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 60, "step": 2, "unit": "px", "label": "Heading Size", "default": 32 },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_limit", "min": 1, "max": 12, "step": 1, "label": "Number of posts", "default": 4 },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "View All Blogs" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "color", "id": "button_bg_color", "label": "Button Background Color", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "button_text_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Button Text Size", "default": 16 },
    { "type": "range", "id": "button_padding", "min": 8, "max": 24, "step": 2, "unit": "px", "label": "Button Padding", "default": 12 },
    { "type": "range", "id": "title_size", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Title Size (Desktop)", "default": 24 },
    { "type": "range", "id": "mobile_title_size", "min": 14, "max": 32, "step": 1, "unit": "px", "label": "Title Size (Mobile)", "default": 18 },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#FFFFFF" },
    { "type": "select", "id": "title_alignment", "label": "Title Alignment (Desktop)", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "select", "id": "mobile_title_alignment", "label": "Title Alignment (Mobile)", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "range", "id": "line_spacing", "min": 5, "max": 30, "step": 1, "unit": "px", "label": "Line Spacing", "default": 15 },
    { "type": "range", "id": "meta_text_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Meta Text Size (Desktop)", "default": 14 },
    { "type": "range", "id": "mobile_meta_text_size", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Meta Text Size (Mobile)", "default": 12 },
    { "type": "color", "id": "meta_text_color", "label": "Meta Text Color", "default": "#FFFFFF" },
    { "type": "range", "id": "image_brightness", "min": 50, "max": 150, "step": 5, "unit": "%", "label": "Image Brightness", "default": 100 }
  ],
  "presets": [{ "name": "Blog Posts Grid", "category": "Blog" }]
}
{% endschema %}

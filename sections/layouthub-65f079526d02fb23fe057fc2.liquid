															{%- assign option_index = forloop.index0 -%}
																{%- if arr_swatch contains option -%}
																	{%- assign index = 'option' | append: forloop.index -%}
																		<div class="lh-swatch-images  swatch-index lh-swatch-variations"  data-option-index="{{ option_index }}">
																			<ul class="list-swatch-images">
																						{%- assign values = ""  -%}
																						{%- for variant in product.variants -%}
																							{%- assign option_value = variant[index] -%}
																							{%- assign option_value_downcase = variant[index] | downcase -%}
																							{%- if values != ""%}
																								{%- assign tmp = values | split: '|' -%}
																								{%- if tmp contains option_value_downcase  -%} {%- continue-%}{%- endif -%}
																								{%- assign values = values  | append:   '|' | append: option_value_downcase -%}
																							{%- else -%}
																								{%- assign values =   option_value_downcase -%}
																							{%- endif -%}
																							<li data-option-index="{{ option_index }}" class="lh-swatch-select lh-swatch-image lh-tooltip {% if option_value == variant_slected[index] %} active{% endif %}" data-value="{{option_value | escape}}" data-tooltip-type="top" data-tooltip-text="{{option_value | escape}}">
																								 

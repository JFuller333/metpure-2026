{% schema %}
{
  "name": "Button with Image",
  "settings": [
    {
      "type": "header", 
      "content": "Left Section Content"
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "label": "Content Vertical Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end", 
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button1_text",
      "label": "Button 1 Text",
      "default": "Button 1"
    },
    {
      "type": "url",
      "id": "button1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "color",
      "id": "button1_color",
      "label": "Button 1 Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color", 
      "id": "button1_bg_color",
      "label": "Button 1 Background Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Button 2 Text", 
      "default": "Button 2"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "color",
      "id": "button2_color", 
      "label": "Button 2 Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button2_bg_color",
      "label": "Button 2 Background Color", 
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "Main Heading"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph Text",
      "default": "<p>Add your paragraph text here</p>"
    },
    {
      "type": "header",
      "content": "Right Section Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Image Width",
      "default": 500
    },
    {
      "type": "range", 
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Button Styles"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Button Border Width",
      "default": 2
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 5
    },
    {
      "type": "header",
      "content": "Text Styles"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 40
    },
    {
      "type": "font",
      "id": "heading_font",
      "label": "Heading Font Family"
    },
    {
      "type": "checkbox",
      "id": "heading_bold",
      "label": "Bold Heading",
      "default": true
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Paragraph Font Size",
      "default": 16
    },
    {
      "type": "font",
      "id": "paragraph_font",
      "label": "Paragraph Font Family"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Button with Image",
      "category": "Custom Content"
    }
  ]
}
{% endschema %}

<style>
.button-image-section {
  background-color: {{ section.settings.section_bg_color }};
  padding: 50px 20px;
}

.button-image-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  gap: 40px;
  align-items: center;
}

.content-left {
  flex: 1;
  text-align: {{ section.settings.text_alignment }};
  display: flex;
  flex-direction: column;
  justify-content: {{ section.settings.content_vertical_alignment }};
  min-height: 400px; /* Add minimum height to make vertical alignment visible */
}

.button-container {
  margin-bottom: 30px;
}

.custom-button {
  display: inline-block;
  font-size: {{ section.settings.button_size }}px;
  border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
  border-radius: {{ section.settings.button_border_radius }}px;
  padding: 10px 20px;
  margin-right: 15px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.custom-button.button1 {
  color: {{ section.settings.button1_color }};
  background-color: {{ section.settings.button1_bg_color }};
}

.custom-button.button2 {
  color: {{ section.settings.button2_color }};
  background-color: {{ section.settings.button2_bg_color }};
}

.custom-button:hover {
  opacity: 0.8;
}

.content-heading {
  font-size: {{ section.settings.heading_size }}px;
  font-family: {{ section.settings.heading_font.family }};
  font-weight: {{ section.settings.heading_bold | default: true | ternary: 'bold', 'normal' }};
  margin-bottom: 20px;
}

.content-paragraph {
  font-size: {{ section.settings.paragraph_size }}px;
  font-family: {{ section.settings.paragraph_font.family }};
}

.image-right {
  flex: 1;
  text-align: center;
}

.section-image {
  width: {{ section.settings.image_width }}px;
  max-width: 100%;
  border-radius: {{ section.settings.image_border_radius }}px;
}

@media screen and (max-width: 768px) {
  .button-image-container {
    flex-direction: column;
  }
  
  .content-left,
  .image-right {
    width: 100%;
  }
  
  .content-left {
    min-height: auto; /* Remove minimum height on mobile */
  }
  
  .button-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 10px;
  }
  
  .custom-button {
    margin-right: 0;
    text-align: center;
    width: calc(50% - 5px); /* Subtracting half of the gap */
  }
  
  .content-heading {
    font-size: calc({{ section.settings.heading_size }}px * 0.7);
  }
  
  .section-image {
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
  }
}
</style>

<div class="button-image-section">
  <div class="button-image-container">
    <div class="content-left">
      <div class="button-container">
        <a href="{{ section.settings.button1_link }}" class="custom-button button1">{{ section.settings.button1_text }}</a>
        <a href="{{ section.settings.button2_link }}" class="custom-button button2">{{ section.settings.button2_text }}</a>
      </div>
      <h2 class="content-heading">{{ section.settings.heading }}</h2>
      <div class="content-paragraph">{{ section.settings.paragraph }}</div>
    </div>
    <div class="image-right">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | img_url: 'master' }}" 
             alt="Section Image"
             class="section-image"
             loading="lazy">
      {% endif %}
    </div>
  </div>
</div>

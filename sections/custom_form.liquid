<section>
  <div class="bg-auto w-full py-8 md:min-h-550 bg-cover" style="background-image: url('https://cdn.shopify.com/s/files/1/0620/0016/9151/files/Rectangle_143.jpg?v=1679435373');"> 
  <div class="container">
    <div class="flex flex-col items-center">
      <div class="container-sm">
        <div class="flex justify-center pt-8">
          <img class="sm:w-auto logo-desktop" src="https://cdn.shopify.com/s/files/1/0620/0016/9151/files/metpure_logo_white_1.svg?v=1679957006" width="25%" display="block" atl="metpro-logo"></div>
          <p class="heading py-10 md:py-16 text-center md:pb-16">ONLINE WHOLESALE SUPPLIER <br> FOR TRADE PROFESSIONALS.</p>
         <p class="subheading text-center py-2">Join&nbsp<img class="mp-logo" src="https://cdn.shopify.com/s/files/1/0620/0016/9151/files/Metpro_logo_white.png?v=1680133698"> for FREE and save on your water filtration and plumbing supplies!</p>
        {{ section.settings.form_embed_code }}
        <p class="subheading text-center pt-4" style="color: white;font-size: 16px;">To get wholesale price, you must be a Met Pro member. Membership is restricted to trade professionals such as suppliers, <br>plumbers, installers, technicians, and business entities engaging in selling plumbing and water filtration products. </p>
        <!-- Video Button & Modal --> 
       <div class="flex items-center justify-center h-full">
        <div class="text-center my-4">
          <u><button id="watch-video-button" class="sf__btn sf__btn-primary" style="margin: 10px;">Watch video</button></u>
        </div>
      </div>
        <div id="video-modal" class="modal">
          <div class="modal-content">
            <span class="close">&times;</span>
            <iframe width="650" height="350" src="https://www.youtube.com/embed/7XqpPkD160M" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
          </div>
        </div>
      <!-- Video Button & Modal End -->
      <img class="mx-auto img-desktop" src="https://cdn.shopify.com/s/files/1/0620/0016/9151/files/Metpro_website_main_2.png?v=1680133242" width="100%" style="padding-bottom: 30px;"></img>
          </div>
        </div>
      </div>
    </div>
</section>

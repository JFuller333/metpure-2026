<!-- Video Modal CSS -->

/* Button Styles */
.bttn {
  background-color: #DEDCDC;
  border: none;
  color: white;
  padding: 12px 24px;
  text-align: center;
  text-decoration: underline;
  display: inline-block;
  font-size: 32px !important;
  margin: 4px 2px;
  cursor: pointer;
}

/* Modal Styling */
.modal {
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  display: none;
  margin: 10% auto;
}

/* Modal Content */
.modal-content {
  background: radial-gradient(101.01% 96.32% at 11.11% 9.35%, #B8B8B8 0%, #5F5F5F 100%) /* warning: gradient uses a rotation that is not supported by CSS and may not behave as expected */;
  margin: auto;
  padding: 20px;
  border-radius: 20px;
  width: 80%;
  max-width: 700px;
  position: relative;
}

/* Close Button */
.close {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 28px;
  font-weight: bold;
  color: #fff;
  padding: 12px 16px;
  transition: all 0.2s ease-in-out;
}

.close:hover,
.close:focus {
  color: #000;
  text-decoration: none;
  cursor: pointer;
}

/* Responsive Styles */
@media only screen and (max-width: 767px) {
  .modal {
    width: 100%;
    height: 75%;
    top: 0;
    left: 0;
    margin: 0;
    padding: 0;
  }
  .modal-dialog {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }
  .modal-content {
    width: 100%;
    height: 100%;
  }
  .modal-content iframe {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .modal-body {
    height: calc(100% - 56px);
  }
}


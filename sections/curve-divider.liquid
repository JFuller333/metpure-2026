<style>
  .bord-st--{{section.id}} {
    height: {{section.settings.hd_border}}px;
    border: {{section.settings.border_line}}px {{section.settings.div_style}};
    border-radius: {{section.settings.border_rad}}px;
  }
  
  .page-divider--{{section.id}} {
    opacity: 0;
    color: {{ section.settings.hd_border_color }};
  }
  
  .active-divider { opacity: 1; }
  
  .curve-divider {
    position: relative;
    height: {{section.settings.curve_height}}px;
    overflow: hidden;
  }
  
  .curve-divider svg {
    position: absolute;
    width: 100%;
    height: 100%;
    fill: {{ section.settings.curve_color }};
  }
  
  @media only screen and (max-width: 749px) {
    .small--hide { display: none !important; }
  }
  
  @media only screen and (min-width: 750px) {
    .medium-up--hide { display: none !important; }
  }
</style>

{% assign halfmarg = 100 | minus: section.settings.div_width | divided_by: 2 %}
{% assign show_border = section.show_border %}
{% assign divider_border = section.settings.divider_border %}
{% assign divider_spacing = section.settings.divider_spacing %}

<div class="{% if section.settings.divider_type == 'curve' %}container-fluid{% else %}container{% endif %} {{section.settings.divider-visibility }}" style="padding: 0; max-width: 100%;">
  <div class="{% if section.settings.divider_type == 'curve' %}full-width{% else %}sixteen columns{% endif %}">
    {% if section.settings.divider_type == 'line' %}
      <hr width="{{section.settings.div_width}}%" class="page-divider--{{section.id}} {% if divider_border %}active-divider bord-st--{{section.id}}{% endif %}" 
          style="margin-left:{{halfmarg}}% !important; margin-right:{{halfmarg}}% !important;{% if divider_spacing %}margin: {{ divider_spacing }}px 0px;{% endif %}">
    {% else %}
      <div class="curve-divider">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
          <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z"></path>
        </svg>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Divider",
  "settings": [
    {
      "type": "select",
      "id": "divider_type",
      "label": "Divider Type",
      "options": [
        {
          "value": "line",
          "label": "Line"
        },
        {
          "value": "curve",
          "label": "Curve"
        }
      ],
      "default": "line"
    },
    {
      "type": "color",
      "id": "curve_color",
      "label": "Curve Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "curve_height",
      "label": "Curve Height",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    // ... existing settings ...
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "Layout"
    }
  ]
}
{% endschema %}
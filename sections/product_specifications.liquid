<div class="container mx-auto p-4">
    <div class="w-full overflow-x-auto">
        <table class="w-full bg-white border-collapse table-auto"> 
            <tbody>
                <tr>
                    <td class="border p-2">Brand: <span style="color: #52A09E;">{{ product.metafields.custom.brand }}</span></td>
                    <td class="border p-2">Length: <span style="color: #52A09E;">{{ product.metafields.custom.length }}</span></td>
                </tr>
                <tr style="background-color: #F4F4F4;">
                    <td class="border p-2">Style: <span style="color: #52A09E;">{{ product.metafields.custom.style }}</span></td>
                    <td class="border p-2">Width: <span style="color: #52A09E;">{{ product.metafields.custom.width }}</span></td>
                </tr>
                <tr>
                    <td class="border p-2">Shape: <span style="color: #52A09E;">{{ product.metafields.custom.shape }}</span></td>
                    <td class="border p-2">Height: <span style="color: #52A09E;">{{ product.metafields.custom.height }}</span></td>
                </tr>
                <tr style="background-color: #F4F4F4;">
                    <td class="border p-2">Material: <span style="color: #52A09E;">{{ product.metafields.custom.material }}</span></td>
                    <td class="border p-2">Diameter: <span style="color: #52A09E;">{{ product.metafields.custom.diameter }}</span></td>
                </tr>
                <tr>
                    <td class="border p-2">Color/finish: <span style="color: #52A09E;">{{ product.metafields.custom.color_finish }}</span></td>
                    <td class="border p-2">Product Dimensions: <span style="color: #52A09E;">{{ product.metafields.custom.product_dimensions }}</span></td>
                </tr>
                <tr style="background-color: #F4F4F4;">
                    <td class="border p-2">Part Number: <span style="color: #52A09E;">{{ product.metafields.custom.part_number }}</span></td>
                    <td class="border p-2">Temperature Rating: <span style="color: #52A09E;">{{ product.metafields.custom.temperature_ratings }}</span></td>
                </tr>
                <tr>
                    <td class="border p-2">Size: <span style="color: #52A09E;">{{ product.metafields.custom.size }}</span></td>
                    <td class="border p-2">Pressure Rating: <span style="color: #52A09E;">{{ product.metafields.custom.pressure_ratings }}</span></td>
                </tr>
                <tr style="background-color: #F4F4F4;">
                    <td class="border p-2">Number of Pieces: <span style="color: #52A09E;">{{ product.metafields.custom.number_of_pieces }}</span></td>
                    <td class="border p-2">Item Weight: <span style="color: #52A09E;">{{ product.metafields.custom.item_weight }}</span></td>
                </tr>
                <tr>
                    <td class="border p-2">Water Flow: <span style="color: #52A09E;">{{ product.metafields.custom.water_flow }}</span></td>
                    <td class="border p-2">Miscellaneous: <span style="color: #52A09E;">{{ product.metafields.custom.miscellaneous }}</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div> 
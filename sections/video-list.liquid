{% liquid
  assign video_list = section.blocks
  assign first_video = video_list | first
%}

<section class="m-video-gallery" id="m-video-gallery--{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="video-gallery">
  <div class="{{ container }} m-section-my m-section-py" style="padding-left: {{ section.settings.section_padding }}px; padding-right: {{ section.settings.section_padding }}px;">
    {% if section.settings.title != blank %}
      <h2 class="m-video-gallery__title" 
        style="
          font-size: {{ section.settings.title_size }}px; 
          color: {{ section.settings.title_color }};
          text-align: {{ section.settings.title_alignment }};
          margin-bottom: 30px;
        "
      >
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div class="m-video-gallery__grid">
      <!-- Thumbnails sidebar -->
      <nav class="m-video-gallery__thumbnails" aria-label="Video Thumbnails">
        {% for block in video_list %}
          <div class="m-video-thumbnail-card">
            <button 
              class="m-video-thumbnail{% if forloop.first %} is-active{% endif %}"
              data-video-id="{{ block.settings.video_link.id }}"
              data-video-type="{{ block.settings.video_type }}"
              data-video-title="{{ block.settings.video_title }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Play {{ block.settings.video_title }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                <div class="m-video-thumbnail__image">
                  {{ block.settings.image | image_url: width: 150 | image_tag }}
                </div>
              {% else %}
                <div class="m-video-thumbnail__image m-video-thumbnail__image--placeholder">
                  <svg width="100%" height="84" viewBox="0 0 150 84" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="150" height="84" rx="8" fill="#f3f4f6"/><path d="M60 42L90 58V26L60 42Z" fill="#d1d5db"/></svg>
                </div>
              {% endif %}
            </button>
            <div class="m-video-thumbnail__title-wrapper" style="width: 100%; text-align: center; margin-top: 8px;">
              <span class="m-video-thumbnail__title" style="
                font-size: {{ section.settings.list_title_size }}px;
                color: {{ section.settings.list_title_color }};
              ">{{ block.settings.video_title }}</span>
            </div>
          </div>
        {% endfor %}
      </nav>

      <!-- Main video player -->
      <div class="m-video-gallery__player">
        <div class="m-video__wrapper" style="width: 100%;">
          <div class="m-video__inner" style="--aspect-ratio: 16/9">
            <video-gallery
              class="deferred-media"
              data-media-id="{{ first_video.settings.video_link.id }}"
              data-auto-play="true"
            >
              <div id="m-video-gallery-player">
                {% if first_video.settings.video_type == 'youtube' %}
                  <iframe
                    src="https://www.youtube.com/embed/{{ first_video.settings.video_link.id }}?enablejsapi=1"
                    class="js-youtube"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ first_video.settings.video_title }}"
                  ></iframe>
                {% elsif first_video.settings.video_type == 'vimeo' %}
                  <iframe
                    src="https://player.vimeo.com/video/{{ first_video.settings.video_link.id }}"
                    class="js-vimeo"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ first_video.settings.video_title }}"
                  ></iframe>
                {% endif %}
              </div>
            </video-gallery>
          </div>
        </div>
        <h3 class="m-video-gallery__current-title" style="
          font-size: {{ section.settings.video_title_size }}px;
          color: {{ section.settings.video_title_color }};
          text-align: {{ section.settings.video_title_alignment }};
          margin-top: 15px;
        ">{{ first_video.settings.video_title }}</h3>
      </div>
    </div>
  </div>
</section>

<script>
  class VideoGallery extends HTMLElement {
    constructor() {
      super();
      this.player = null;
      this.currentVideo = null;
      this.thumbnails = document.querySelectorAll('.m-video-thumbnail');
      this.currentTitle = document.querySelector('.m-video-gallery__current-title');
      this.initThumbnails();
    }

    initThumbnails() {
      this.thumbnails.forEach(thumb => {
        thumb.addEventListener('click', () => {
          this.thumbnails.forEach(t => {
            t.classList.remove('is-active');
            t.setAttribute('aria-pressed', 'false');
          });
          thumb.classList.add('is-active');
          thumb.setAttribute('aria-pressed', 'true');
          const videoData = {
            id: thumb.dataset.videoId,
            type: thumb.dataset.videoType,
            title: thumb.dataset.videoTitle
          };
          this.updateVideo(videoData);
        });
      });
    }

    updateVideo(videoData) {
      const playerContainer = document.querySelector('#m-video-gallery-player');
      playerContainer.innerHTML = '';
      if (videoData.type === 'youtube') {
        playerContainer.innerHTML = `
          <iframe
            src="https://www.youtube.com/embed/${videoData.id}?enablejsapi=1&autoplay=1"
            class="js-youtube"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="${videoData.title}"
          ></iframe>
        `;
      } else if (videoData.type === 'vimeo') {
        playerContainer.innerHTML = `
          <iframe
            src="https://player.vimeo.com/video/${videoData.id}?autoplay=1"
            class="js-vimeo"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="${videoData.title}"
          ></iframe>
        `;
      }
      if (this.currentTitle) {
        this.currentTitle.textContent = videoData.title;
      }
    }
  }
  document.addEventListener('DOMContentLoaded', () => {
    if (!customElements.get('video-gallery')) {
      customElements.define('video-gallery', VideoGallery);
    }
  });
</script>

<style>
  :root {
    --video-thumb-bg: #fff;
    --video-thumb-border: #e5e7eb;
    --video-thumb-active: #2563eb;
    --video-thumb-shadow: 0 2px 8px rgba(0,0,0,0.04);
    --video-thumb-radius: 12px;
    --video-thumb-hover: #f3f4f6;
    --video-title-color: #111827;
    --video-title-size: 1rem;
    --gallery-bg: #f9fafb;
    --gallery-radius: 18px;
    --gallery-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .m-video-gallery {
    text-align: center;
    background: url('https://cdn.shopify.com/s/files/1/0620/0016/9151/files/metpure-trans-background-blue2.png?v=1751403759') center center/cover no-repeat;
    border-radius: var(--gallery-radius);
    box-shadow: var(--gallery-shadow);
    padding: 32px 0;
    margin-bottom: 40px;
  }
  .m-video-gallery__grid {
    display: grid;
    gap: 32px;
    grid-template-columns: 220px 1fr;
    max-width: 1200px;
    margin: 0 auto;
    align-items: flex-start;
  }
  @media screen and (max-width: 900px) {
    .m-video-gallery__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .m-video-gallery__thumbnails {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 8px;
    }
  }
  .m-video-gallery__thumbnails {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: auto;
    background: transparent;
    padding: 0 2px;
    border-radius: var(--video-thumb-radius);
  }
  .m-video-thumbnail-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .m-video-thumbnail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 8px 0px;
    border: none;
    border-radius: var(--video-thumb-radius);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(.4,0,.2,1);
    width: 100%;
    background: transparent;
    box-shadow: none;
    outline: none;
    position: relative;
  }
  .m-video-thumbnail:focus {
    box-shadow: 0 0 0 2px #0002;
  }
  .m-video-thumbnail.is-active {
    padding-left: 2px;
    padding-right: 2px;
  }
  .m-video-thumbnail:hover:not(.is-active) {
    background: #f3f4f6;
  }
  .m-video-thumbnail__image {
    width: 100%;
    max-width: 150px;
    aspect-ratio: 16/9;
    background: #f3f4f6;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
  }
  .m-video-thumbnail__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }
  .m-video-thumbnail__image--placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .m-video-thumbnail__title-wrapper {
    margin-top: 8px;
    width: 100%;
    text-align: center;
  }
  .m-video-thumbnail__title {
    line-height: 1.3;
    font-weight: 600;
    display: inline-block;
    color: var(--video-title-color);
    font-size: var(--video-title-size); 
    letter-spacing: 0.01em;
    text-shadow: 0 1px 0 #fff8;
  }
  .m-video__wrapper {
    position: relative;
    background: #000;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    overflow: hidden;
  }
  .m-video__inner {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 12px;
  }
  .m-video__inner iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    border: none;
  }
  .m-video-gallery__current-title {
    margin: 24px 0 0 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--video-title-color);
    letter-spacing: 0.01em;
    text-align: left;
    padding-left: 8px;
  }
  @media screen and (max-width: 600px) {
    .m-video-gallery {
      padding: 16px 0;
    }
    .m-video-gallery__grid {
      gap: 16px;
    }
    .m-video-gallery__current-title {
      font-size: 1rem;
      padding-left: 0;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Video Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Video Gallery"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 16,
      "max": 60,
      "step": 1,
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "list_title_size",
      "label": "List Title Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "color",
      "id": "list_title_color",
      "label": "List Title Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "list_title_alignment",
      "label": "List Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "video_title_size",
      "label": "Video Title Size",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 14
    },
    {
      "type": "color",
      "id": "video_title_color",
      "label": "Video Title Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "video_title_alignment",
      "label": "Video Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "video_title",
          "label": "Video title",
          "default": "Video title"
        },
        {
          "type": "select",
          "id": "video_type",
          "label": "Video type",
          "default": "youtube",
          "options": [
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "vimeo",
              "label": "Vimeo"
            }
          ]
        },
        {
          "type": "video_url",
          "id": "video_link",
          "label": "Video link",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Gallery",
      "blocks": [
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        }
      ]
    }
  ]
}
{% endschema %}
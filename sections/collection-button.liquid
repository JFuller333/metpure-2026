      "id": "heading1",
      "label": "Heading 1",
      "default": "Heading 1"
    },
    {
      "type": "text",
      "id": "badge1",
      "label": "Badge 1 Text",
      "default": "New"
    },
    {
      "type": "text",
      "id": "button1",
      "label": "Button 1 Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "heading2",
      "label": "Heading 2",
      "default": "Heading 2"
    },
    {
      "type": "text",
      "id": "badge2",
      "label": "Badge 2 Text",
      "default": "Sale"
    },
    {
      "type": "text",
      "id": "button2",
      "label": "Button 2 Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image3",
      "label": "Image 3"
    },
    {
      "type": "text",
      "id": "heading3",
      "label": "Heading 3",
      "default": "Heading 3"
    },
    {
      "type": "text",
      "id": "badge3",
      "label": "Badge 3 Text",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "button3",
      "label": "Button 3 Text",
      "default": "View Details"
    },
    {
      "type": "url",
      "id": "button3_link",
      "label": "Button 3 Link"
    },
    {

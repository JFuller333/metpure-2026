          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "badge_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Badge Font Size",
      "default": 14
    },
    {
      "type": "font",
      "id": "badge_font",
      "label": "Badge Font Family"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge Background Color",
      "default": "#ff0000"
    },
    {
      "type": "range",
      "id": "badge_circle_size",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Badge Circle Size",
      "default": 60
    },
    {
      "type": "range",
      "id": "badge_offset_x",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Badge Horizontal Offset",
      "default": 0
    },
    {
      "type": "range",
      "id": "badge_offset_y",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Badge Vertical Offset",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 16
    },
    {
      "type": "font",
      "id": "button_font",
      "label": "Button Font Family"
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "Button Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 5
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Collection with Buttons",
      "category": "Collection"
    }
  ]
}
{% endschema %}

<style>
.collection-section {
  background: {{ section.settings.section_bg }};
  background-position: {{ section.settings.gradient_position }}%;
  {% if section.settings.bg_image %}
    background-image: url({{ section.settings.bg_image | img_url: 'master' }});
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
  {% endif %}
  padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding }}px {{ section.settings.section_padding_bottom }}px;
  width: 100%;
  box-sizing: border-box;
}

.collection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: {{ section.settings.grid_gap }}px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.collection-item {
  position: relative;
  text-align: {{ section.settings.image_alignment }};
  display: flex;
  flex-direction: column;
  align-items: {{ section.settings.image_alignment }};
  width: 100%;
}

.collection-image {
  width: 100%;
  max-width: {{ section.settings.image_size }}px;
  height: auto;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: {{ section.settings.image_border_radius }}px;
  margin-top: {{ section.settings.heading_image_gap }}px;
}

.collection-heading {
  font-size: clamp(18px, {{ section.settings.heading_size }}px, 36px);
  font-family: {{ section.settings.heading_font.family | default: 'Roboto' }};
  font-weight: {{ section.settings.heading_bold | default: true | ternary: 'bold', 'normal' }};
  text-align: {{ section.settings.heading_alignment }};
  margin: 0;
  width: 100%;
}

.collection-badge {
  position: absolute;
  top: {{ section.settings.badge_offset_y | plus: 40 }}px;
  right: {{ section.settings.badge_offset_x }}px;
  width: clamp(40px, {{ section.settings.badge_circle_size }}px, 80px);
  height: clamp(40px, {{ section.settings.badge_circle_size }}px, 80px);
  background-color: {{ section.settings.badge_bg_color }};
  color: {{ section.settings.badge_text_color }};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(12px, {{ section.settings.badge_size }}px, 20px);
  font-family: {{ section.settings.badge_font.family | default: 'Roboto' }};
}

.collection-button {
  display: inline-block;
  padding: 10px 20px;
  margin-top: {{ section.settings.button_image_gap }}px;
  font-size: {{ section.settings.button_size }}px;
  font-family: {{ section.settings.button_font.family | default: 'Roboto' }};
  background-color: {{ section.settings.button_bg_color }};
  color: {{ section.settings.button_text_color }};
  text-decoration: none;
  border-radius: {{ section.settings.button_border_radius }}px;
  border: 1px solid {{ section.settings.button_border_color }};
  transition: all 0.3s ease;
  text-align: {{ section.settings.button_alignment }};
  min-width: 120px;
  order: 3;
}

.collection-button:hover {
  background-color: {{ section.settings.button_hover_color }};
}

@media screen and (max-width: 768px) {
  .collection-section {
    padding: {{ section.settings.section_padding_top | divided_by: 2 }}px {{ section.settings.section_padding | divided_by: 2 }}px {{ section.settings.section_padding_bottom | divided_by: 2 }}px;
    overflow-x: hidden;
  }
  
  .collection-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
    gap: {{ section.settings.grid_gap | divided_by: 1.5 }}px;
    padding: 0 15px;
  }

  .collection-grid::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
  
  .collection-item {
    flex: 0 0 85%;
    scroll-snap-align: start;
    margin-right: {{ section.settings.grid_gap | divided_by: 1.5 }}px;
  }
  
  .collection-badge {
    transform: scale(0.8);
  }
}

@media screen and (max-width: 480px) {
  .collection-section {
    padding: {{ section.settings.section_padding_top | divided_by: 2.5 }}px {{ section.settings.section_padding | divided_by: 2.5 }}px {{ section.settings.section_padding_bottom | divided_by: 2.5 }}px;
  }
  
  .collection-grid {
    gap: {{ section.settings.grid_gap | divided_by: 2 }}px;
  }
  
  .collection-button {
    width: 100%;
    text-align: center;
  }
}
</style>

<div class="collection-section">
  <div class="collection-grid">
    <div class="collection-item">
      <h2 class="collection-heading">{{ section.settings.heading1 }}</h2>
      {% if section.settings.image1 %}
        <img src="{{ section.settings.image1 | img_url: 'master' }}" alt="{{ section.settings.heading1 }}" class="collection-image" loading="lazy">
      {% endif %}
      {% if section.settings.badge1 != blank %}
        <div class="collection-badge">{{ section.settings.badge1 }}</div>
      {% endif %}
      {% if section.settings.button1 != blank and section.settings.button1_link != blank %}
        <a href="{{ section.settings.button1_link }}" class="collection-button">{{ section.settings.button1 }}</a>
      {% endif %}
    </div>

    <div class="collection-item">
      <h2 class="collection-heading">{{ section.settings.heading2 }}</h2>
      {% if section.settings.image2 %}
        <img src="{{ section.settings.image2 | img_url: 'master' }}" alt="{{ section.settings.heading2 }}" class="collection-image" loading="lazy">
      {% endif %}
      {% if section.settings.badge2 != blank %}
        <div class="collection-badge">{{ section.settings.badge2 }}</div>
      {% endif %}
      {% if section.settings.button2 != blank and section.settings.button2_link != blank %}
        <a href="{{ section.settings.button2_link }}" class="collection-button">{{ section.settings.button2 }}</a>
      {% endif %}
    </div>

    <div class="collection-item">
      <h2 class="collection-heading">{{ section.settings.heading3 }}</h2>
      {% if section.settings.image3 %}
        <img src="{{ section.settings.image3 | img_url: 'master' }}" alt="{{ section.settings.heading3 }}" class="collection-image" loading="lazy">
      {% endif %}
      {% if section.settings.badge3 != blank %}
        <div class="collection-badge">{{ section.settings.badge3 }}</div>
      {% endif %}
      {% if section.settings.button3 != blank and section.settings.button3_link != blank %}
        <a href="{{ section.settings.button3_link }}" class="collection-button">{{ section.settings.button3 }}</a>
      {% endif %}
    </div>
  </div>
</div>

    {
      "type": "range",
      "id": "gradient_position",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Gradient Position",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom", 
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section Bottom Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0, 
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section Side Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Images",
      "default": 30
    },
    {
      "type": "range", 
      "id": "heading_image_gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Heading and Image",

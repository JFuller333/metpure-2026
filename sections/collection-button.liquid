      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 24
    },
    {
      "type": "font",
      "id": "heading_font",
      "label": "Heading Font Family"
    },
    {
      "type": "checkbox",
      "id": "heading_bold",
      "label": "Bold Heading",

{% comment %} Added a custom_liquid block type for custom code injection {% endcomment %}
{%- liquid
  assign tab_font_size = section.settings.tab_font_size | append: 'px'
  assign tab_font_family = section.settings.tab_font_family
  assign tab_border_radius = section.settings.tab_border_radius | append: 'px'
  assign tab_border_color = section.settings.tab_border_color
  assign tab_hover_color = section.settings.tab_hover_color
  assign tab_active_color = section.settings.tab_active_color
-%}
<div class="tabs-container">
  <div class="tabs">
    {% for block in section.blocks %}
      {% if block.type == 'tab' or block.type == 'custom_tab' or block.type == 'custom_liquid' or block.type == 'heading_tab' or block.type == 'product_description_tab' or block.type == 'faq_tab' %}
        <button class="tab-button{% if forloop.first %} active{% endif %}" 
                data-tab="{{ block.id }}">
          {{ block.settings.tab_title }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'tab' %}
      <div class="tab-content{% if forloop.first %} active{% endif %}{% if block.settings.reverse_layout %} reverse{% endif %}" 
           id="tab-{{ block.id }}">
        <div class="content-side">
          <h2 class="tab-title" style="
            font-size: {{ block.settings.title_size }}px;
            color: {{ block.settings.title_color }};
            text-align: {{ block.settings.title_alignment }};">
            {{ block.settings.content_title }}
          </h2>

          <div class="tab-paragraph" style="
            font-size: {{ block.settings.text_size }}px;
            color: {{ block.settings.text_color }};
            text-align: {{ block.settings.text_alignment }};">
            {{ block.settings.content_text }}
          </div>
        </div>

        {% if block.settings.image != blank %}
        <div class="image-side">
          <img src="{{ block.settings.image | img_url: 'master' }}"
               alt="{{ block.settings.image.alt }}"
               class="tab-image"
               style="
                 width: {{ block.settings.image_width }}px;
                 height: {{ block.settings.image_height }}px;
                 border-radius: {{ block.settings.image_radius }}px;
               ">
        </div>
        {% endif %}
      </div>
    {% elsif block.type == 'product_description_tab' %}
      <div class="tab-content{% if forloop.first %} active{% endif %}" 
           id="tab-{{ block.id }}">
        <div class="content-side full-width">
          <div class="tab-paragraph" style="
            font-size: {{ block.settings.text_size }}px;
            color: {{ block.settings.text_color }};
            text-align: {{ block.settings.text_alignment }};">
            {% assign paragraphs = product.description | split: '</p>' %}
            {% for paragraph in paragraphs limit: 4 %}
              {{ paragraph | append: '</p>' }}
            {% endfor %}
            {% if paragraphs.size > 4 %}
              <div class="hidden-content">
                {% for paragraph in paragraphs offset: 4 %}
                  {{ paragraph | append: '</p>' }}
                {% endfor %}
              </div>
              <button class="load-more-btn">Read More</button>
              <button class="load-less-btn" style="display: none;">Read Less</button>
            {% endif %}
          </div>
        </div>
      </div>
    {% elsif block.type == 'custom_tab' %}
      <div class="tab-content{% if forloop.first %} active{% endif %}" 
           id="tab-{{ block.id }}">
        <div class="content-side full-width">
          {{ block.settings.custom_html }}
          <style>
            {{ block.settings.custom_css }}
          </style>
        </div>
      </div>
    {% elsif block.type == 'custom_liquid' %}
      <div class="tab-content{% if forloop.first %} active{% endif %}" 
           id="tab-{{ block.id }}">
        <div class="content-side full-width">
          {% if block.settings.custom_liquid_code != blank %}
            {% liquid
              echo block.settings.custom_liquid_code
            %}
          {% endif %}
        </div>
      </div>
    {% elsif block.type == 'heading_tab' %}
      <div class="tab-content{% if forloop.first %} active{% endif %}" 
           id="tab-{{ block.id }}">
        <div class="content-side">
          {% for i in (1..5) %}
            {% assign heading_key = 'heading_' | append: i %}
            {% assign heading_text = block.settings[heading_key] %}
            {% assign url_key = 'heading_url_' | append: i %}
            {% assign size_key = 'heading_size_' | append: i %}
            {% assign color_key = 'heading_color_' | append: i %}
            {% assign alignment_key = 'heading_alignment_' | append: i %}
            
            {% if heading_text != blank %}
              <div class="heading-content">
                <h2>{{ heading_text }}</h2>
                <a href="{{ block.settings[url_key] }}" class="manual-button">
                  Download Manual
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        {% if block.settings.image != blank %}
        <div class="image-side">
          <img src="{{ block.settings.image | img_url: 'master' }}"
               alt="{{ block.settings.image.alt }}"
               class="tab-image"
               style="
                 width: {{ block.settings.image_width }}px;
                 height: {{ block.settings.image_height }}px;
                 border-radius: {{ block.settings.image_radius }}px;
               ">
        </div>
        {% endif %}
      </div>
    {% elsif block.type == 'faq_tab' %}
      <div class="tab-content{% if forloop.first %} active{% endif %}" 
           id="tab-{{ block.id }}">
        <div class="content-side full-width">
          <div class="faq-accordion">
            {% for i in (1..20) %}
              {% assign question_key = 'question_' | append: i %}
              {% assign answer_key = 'answer_' | append: i %}
              {% if block.settings[question_key] != blank %}
                <div class="faq-item">
                  <div class="faq-question">
                    {{ block.settings[question_key] }}
                    <span class="faq-toggle">+</span>
                  </div>
                  <div class="faq-answer">
                    {{ block.settings[answer_key] }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>


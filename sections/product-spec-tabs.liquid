<script>
  const tabButtons = document.querySelectorAll('#shopify-section-{{ section.id }} .tab-button');
  const tabContents = document.querySelectorAll('#shopify-section-{{ section.id }} .tab-content');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-tab');
      
      tabButtons.forEach(btn => btn.classList.remove('active'));
      tabContents.forEach(content => content.classList.remove('active'));
      
      button.classList.add('active');
      document.getElementById(`tab-${tabId}`).classList.add('active');
    });
  });

  // Load More/Less functionality
  const loadMoreBtns = document.querySelectorAll('#shopify-section-{{ section.id }} .load-more-btn');
  const loadLessBtns = document.querySelectorAll('#shopify-section-{{ section.id }} .load-less-btn');
  const hiddenContents = document.querySelectorAll('#shopify-section-{{ section.id }} .hidden-content');

  loadMoreBtns.forEach((btn, index) => {
    btn.addEventListener('click', () => {
      hiddenContents[index].style.display = 'block';
      btn.style.display = 'none';
      loadLessBtns[index].style.display = 'block';
    });
  });

  loadLessBtns.forEach((btn, index) => {
    btn.addEventListener('click', () => {
      hiddenContents[index].style.display = 'none';
      btn.style.display = 'none';
      loadMoreBtns[index].style.display = 'block';
    });
  });

  // FAQ Accordion functionality
  const faqQuestions = document.querySelectorAll('#shopify-section-{{ section.id }} .faq-question');

  faqQuestions.forEach(question => {
    question.addEventListener('click', () => {
      const answer = question.nextElementSibling;
      const isOpen = question.classList.contains('active');
      
      // Close all other answers
      faqQuestions.forEach(q => {
        q.classList.remove('active');
        q.nextElementSibling.style.display = 'none';
      });

      // Toggle current answer
      if (!isOpen) {
        question.classList.add('active');
        answer.style.display = 'block';
      }
    });
  });
</script>

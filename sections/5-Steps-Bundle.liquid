{%- assign step1_title = section.settings.step1_title | default: 'Step 1: Choose Your Base Product' -%}
{%- assign step2_title = section.settings.step2_title | default: 'Step 2: Select Add-ons' -%}
{%- assign step3_title = section.settings.step3_title | default: 'Fixtures (Add-On)' -%}
{%- assign step4_title = section.settings.step4_title | default: 'Step 4: Optional Add-ons' -%}
{%- assign step5_title = section.settings.step5_title | default: 'Step 5: Checkout' -%}

<div class="bundle-steps-container">
  <h1 class="bundle-title">{{ section.settings.bundle_title }}</h1>
  <!-- New layout structure -->
  <div class="bundle-layout">
    <!-- Left side: Products and Steps -->
    <div class="bundle-main-content">
      <!-- Steps Progress Bar -->
      <div class="steps-progress">
        <div class="step-indicators">
          <div class="progress-bar">
            <div class="step-item" data-step="1" onclick="goToStep(1)">
              <div class="step-circle active" style="background-color: {{ section.settings.step_background_color }};">
                <span class="step-number">{% if section.settings.show_step_numbers %}1{% endif %}</span>
              </div>
              <div class="step-label active">{{ step1_title }}</div>
            </div>
            
            <div class="step-connector">
              <div class="connector-line"></div>
            </div>
            
            <div class="step-item" data-step="2" onclick="goToStep(2)">
              <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                <span class="step-number">{% if section.settings.show_step_numbers %}2{% endif %}</span>
              </div>
              <div class="step-label">{{ step2_title }}</div>
            </div>
            
            <div class="step-connector">
              <div class="connector-line"></div>
            </div>
            
            <div class="step-item" data-step="3" onclick="goToStep(3)">
              <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                <span class="step-number">{% if section.settings.show_step_numbers %}3{% endif %}</span>
              </div>
              <div class="step-label">{{ step3_title }}</div>
            </div>

            <div class="step-connector">
              <div class="connector-line"></div>
            </div>
            
            <div class="step-item" data-step="4" onclick="goToStep(4)">
              <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                <span class="step-number">{% if section.settings.show_step_numbers %}4{% endif %}</span>
              </div>
              <div class="step-label">{{ step4_title }}</div>
            </div>

            <div class="step-connector">
              <div class="connector-line"></div>
            </div>
            
            <div class="step-item" data-step="5" onclick="goToStep(5)">
              <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                <span class="step-number">{% if section.settings.show_step_numbers %}5{% endif %}</span>
              </div>
              <div class="step-label">
                {{ step5_title }}
                <div class="step-total">
                  <span class="selected-price">$0.00</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 1 Content -->
      <div class="step-content active" data-step="1">
        <h2>{{ step1_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step1_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    {% if product.variants.size > 1 %}
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="custom-select">
                          <select id="variant-select-{{ product.id }}" class="variant-select" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" 
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-compare-price="{{ variant.compare_at_price }}"
                                      data-variant-image="{{ variant.image | img_url: '800x800' }}"
                                      {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    {% endif %}
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-price="{{ product.price }}" 
                              data-product-compare-price="{{ product.compare_at_price }}"
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: #000000; /* Changed to black */
                                     color: white;
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="skip-step-container">
          <button class="skip-step-btn" onclick="skipToNextStep()">
            Skip this step →
          </button>
        </div>
      </div>

      <!-- Step 2 Content -->
      <div class="step-content" data-step="2" style="display: none;">
        <h2>{{ step2_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step2_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    {% if product.variants.size > 1 %}
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="custom-select">
                          <select id="variant-select-{{ product.id }}" class="variant-select" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" 
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-compare-price="{{ variant.compare_at_price }}"
                                      data-variant-image="{{ variant.image | img_url: '800x800' }}"
                                      {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    {% endif %}
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-compare-price="{{ product.compare_at_price }}"
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: #000000; /* Changed to black */
                                     color: white;
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="skip-step-container">
          <button class="skip-step-btn" onclick="skipToNextStep()">
            Skip this step →
          </button>
        </div>
      </div>

      <!-- Step 3 Content -->
      <div class="step-content" data-step="3" style="display: none;">
        <h2>{{ step3_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step3_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    {% if product.variants.size > 1 %}
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="custom-select">
                          <select id="variant-select-{{ product.id }}" class="variant-select" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" 
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-compare-price="{{ variant.compare_at_price }}"
                                      data-variant-image="{{ variant.featured_image | default: product.featured_image | img_url: '800x800' }}"
                                      {% if forloop.first %}selected{% endif %}>
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    {% endif %}
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-compare-price="{{ product.compare_at_price }}"
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: #000000;
                                     color: white;
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="skip-step-container">
          <button class="skip-step-btn" onclick="skipToNextStep()">
            Skip this step →
          </button>
        </div>
      </div>

      <!-- Step 4 Content -->
      <div class="step-content" data-step="4" style="display: none;">
        <h2>{{ step4_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step4_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    {% if product.variants.size > 1 %}
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="custom-select">
                          <select id="variant-select-{{ product.id }}" class="variant-select" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" 
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-compare-price="{{ variant.compare_at_price }}"
                                      data-variant-image="{{ variant.featured_image | default: product.featured_image | img_url: '800x800' }}"
                                      {% if forloop.first %}selected{% endif %}>
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    {% endif %}
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-compare-price="{{ product.compare_at_price }}"
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: #000000;
                                     color: white;
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="skip-step-container">
          <button class="skip-step-btn" onclick="skipToCheckout()">
            Skip this step →
          </button>
        </div>
      </div>
    </div>

    <!-- Right side: Fixed Cart Summary -->
    <div class="bundle-cart-sidebar">
      <div class="cart-summary">
        <div class="cart-header">
          <h3>Your Bundle Summary</h3>
          <span class="total-items">0 items</span>
        </div>
        
        <!-- Base Product Selection -->
        <div class="cart-section">
          <h4>Base Product</h4>
          <div class="step1-selection cart-items">
            <div class="empty-state">
              <p>No base product selected</p>
            </div>
          </div>
        </div>

        <!-- Add-ons Selection -->
        <div class="cart-section">
          <h4>Add-ons</h4>
          <div class="step2-selection cart-items">
            <div class="empty-state">
              <p>No add-ons selected</p>
            </div>
          </div>
        </div>

        <!-- Optional Add-ons -->
        <div class="cart-section">
          <h4>Optional Add-ons</h4>
          <div class="step3-selection cart-items">
            <div class="empty-state">
              <p>No optional add-ons selected</p>
            </div>
          </div>
        </div>

        <!-- Additional Optional Add-ons -->
        <div class="cart-section">
          <h4>Additional Optional Add-ons</h4>
          <div class="step4-selection cart-items">
            <div class="empty-state">
              <p>No additional optional add-ons selected</p>
            </div>
          </div>
        </div>

        <!-- Cart Totals -->
        <div class="cart-totals">
          <div class="savings-display" style="display: none;">
            <span>Your Savings:</span>
            <span class="savings-amount">$0.00</span>
          </div>
          <div class="subtotal">
            <span>Subtotal</span>
            <span class="price-amount">$0.00</span>
          </div>
          <div class="shipping-note">Taxes and shipping calculated at checkout</div>
          <button class="checkout-btn" disabled
            style="background-color: {{ section.settings.checkout_button_color }}; 
                   color: {{ section.settings.checkout_button_text_color }};">
            Proceed to Checkout
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let cartTotal = 0;
let currentStep = 1;
let selectedProducts = {
  step1: null,
  step2: [],
  step3: [],
  step4: []
};

function updateProductImage(swatch, imageUrl) {
  const productWrapper = swatch.closest('.product-wrapper');
  const productImage = productWrapper.querySelector('.product-image-main');
  
  if (productImage && imageUrl) {
    productImage.src = imageUrl;
  }
  
  const allSwatches = productWrapper.querySelectorAll('.color-swatch');
  allSwatches.forEach(s => s.classList.remove('selected'));
  swatch.classList.add('selected');
  
  const variantId = swatch.getAttribute('data-variant-id');
  const select = productWrapper.querySelector('.variant-select');
  if (select && variantId) {
    select.value = variantId;
    // Trigger variant change to update cart image
    handleVariantChange(select);
  }
}

function updateCartTotal(price) {
  cartTotal = price / 100;
  document.querySelector('.selected-price').textContent = `$${cartTotal.toFixed(2)}`;
}

function handleVariantChange(select) {
  const selectedOption = select.options[select.selectedIndex];
  const imageUrl = selectedOption.getAttribute('data-variant-image');
  const price = selectedOption.getAttribute('data-variant-price');
  const productWrapper = select.closest('.product-wrapper');
  const productImage = productWrapper.querySelector('.product-image-main');
  const productPrice = productWrapper.querySelector('.product-price');
  
  if (productImage && imageUrl) {
    productImage.src = imageUrl;
    
    // Update cart image if this is the selected product
    const step = productWrapper.closest('.step-content').dataset.step;
    if (step === '1' && selectedProducts.step1) {
      selectedProducts.step1.image = imageUrl;
      updateStep1Selection();
    } else if (step === '2') {
      const productId = select.id.replace('variant-select-', '');
      const addonIndex = selectedProducts.step2.findIndex(p => p.id === productId);
      if (addonIndex >= 0) {
        selectedProducts.step2[addonIndex].image = imageUrl;
        updateStep2Selection();
      }
    } else if (step === '3') {
      const productId = select.id.replace('variant-select-', '');
      const fixtureIndex = selectedProducts.step3.findIndex(p => p.id === productId);
      if (fixtureIndex >= 0) {
        selectedProducts.step3[fixtureIndex].image = imageUrl;
        updateStep3Selection();
      }
    } else if (step === '4') {
      const productId = select.id.replace('variant-select-', '');
      const addonIndex = selectedProducts.step4.findIndex(p => p.id === productId);
      if (addonIndex >= 0) {
        selectedProducts.step4[addonIndex].image = imageUrl;
        updateStep4Selection();
      }
    }
  }
  
  if (price && productPrice) {
    productPrice.textContent = `$${(price/100).toFixed(2)}`;
  }
  
  if (price) {
    updateCartTotal(price);
  }
}

function goToStep(step) {
  currentStep = step;
  updateStepProgress(currentStep);
  updateProgress(currentStep);
}

function updateStepProgress(currentStep) {
  document.querySelectorAll('.step-item').forEach((item, index) => {
    const stepNumber = index + 1;
    const circle = item.querySelector('.step-circle');
    const label = item.querySelector('.step-label');
    const connector = item.nextElementSibling?.querySelector('.connector-line');
    
    if (stepNumber < currentStep) {
      circle.classList.add('completed', 'active');
      label.classList.add('active');
      if (connector) connector.parentElement.classList.add('completed');
    } else if (stepNumber === currentStep) {
      circle.classList.add('active');
      label.classList.add('active');
      if (connector) connector.parentElement.classList.remove('completed');
    } else {
      circle.classList.remove('completed', 'active');
      label.classList.remove('active');
      if (connector) connector.parentElement.classList.remove('completed');
    }
  });
}

function updateProgress(step) {
  document.querySelectorAll('.step-content').forEach(content => {
    content.style.display = 'none';
    content.classList.remove('active');
  });

  const currentContent = document.querySelector(`.step-content[data-step="${step}"]`);
  if (currentContent) {
    currentContent.style.display = 'block';
    currentContent.classList.add('active');
  }
}

function skipToNextStep() {
  currentStep++;
  if (currentStep > 5) currentStep = 5;
  updateStepProgress(currentStep);
  updateProgress(currentStep);
}

function skipToCheckout() {
  currentStep = 5;
  updateStepProgress(currentStep);
  updateProgress(currentStep);
}

document.addEventListener('DOMContentLoaded', function() {
  updateStepProgress(currentStep);
  
  document.querySelectorAll('.choose-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const step = parseInt(this.closest('.step-content').dataset.step);
      const productId = this.dataset.productId;
      const productTitle = this.dataset.productTitle;
      const variantSelect = document.querySelector(`#variant-select-${productId}`);
      const selectedVariant = variantSelect ? variantSelect.options[variantSelect.selectedIndex] : null;
      const variantPrice = selectedVariant ? selectedVariant.dataset.variantPrice : this.dataset.productPrice;
      const variantComparePrice = selectedVariant ? selectedVariant.dataset.variantComparePrice : this.dataset.productComparePrice;
      const variantImage = selectedVariant ? selectedVariant.dataset.variantImage : this.dataset.productImage;
      
      const productData = {
        id: selectedVariant ? selectedVariant.value : productId,
        title: selectedVariant ? `${productTitle} - ${selectedVariant.text}` : productTitle,
        price: variantPrice,
        compare_at_price: variantComparePrice,
        image: variantImage
      };
      
      if (step === 1) {
        selectedProducts.step1 = productData;
        updateStep1Selection();
      } else if (step === 2) {
        selectedProducts.step2.push(productData);
        updateStep2Selection();
      } else if (step === 3) {
        selectedProducts.step3.push(productData);
        updateStep3Selection();
      } else if (step === 4) {
        selectedProducts.step4.push(productData);
        updateStep4Selection();
      }
      
      updateTotal();
      skipToNextStep();
    });
  });
  
  document.querySelector('.checkout-btn').addEventListener('click', handleCheckout);
});

function updateStep1Selection() {
  if (!selectedProducts.step1) return;
  
  document.querySelector('.step1-selection').innerHTML = `
    <div class="product-info">
      <img src="${selectedProducts.step1.image}" alt="${selectedProducts.step1.title}" class="product-image">
      <span>${selectedProducts.step1.title}</span>
      <div class="price-info">
        <div>$${(parseFloat(selectedProducts.step1.price)/100).toFixed(2)}</div>
        ${selectedProducts.step1.compare_at_price > selectedProducts.step1.price ? 
          `<div class="cart-compare-price">$${(parseFloat(selectedProducts.step1.compare_at_price)/100).toFixed(2)}</div>` 
          : ''}
      </div>
      <div class="quantity-selector">
        <button onclick="updateQuantity('step1', -1)">-</button>
        <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
        <button onclick="updateQuantity('step1', 1)">+</button>
      </div>
    </div>
  `;
}

function updateStep2Selection() {
  const step2Selection = document.querySelector('.step2-selection');
  if (selectedProducts.step2.length === 0) {
    step2Selection.innerHTML = `
      <div class="empty-state">
        <p>No add-ons selected</p>
      </div>
    `;
    return;
  }
  
  step2Selection.innerHTML = selectedProducts.step2.map((addon, index) => `
    <div class="product-info" data-addon-index="${index}">
      <img src="${addon.image}" alt="${addon.title}" class="product-image">
      <span>${addon.title}</span>
      <div class="price-info">
        <div>$${(parseFloat(addon.price)/100).toFixed(2)}</div>
        ${addon.compare_at_price > addon.price ? 
          `<div class="cart-compare-price">$${(parseFloat(addon.compare_at_price)/100).toFixed(2)}</div>` 
          : ''}
      </div>
      <div class="quantity-selector">
        <button onclick="updateQuantity('step2', -1, ${index})">-</button>
        <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
        <button onclick="updateQuantity('step2', 1, ${index})">+</button>
      </div>
      <button class="remove-addon" onclick="removeAddon(${index})">Remove</button>
    </div>
  `).join('');
}

function updateStep3Selection() {
  const step3Selection = document.querySelector('.step3-selection');
  if (selectedProducts.step3.length === 0) {
    step3Selection.innerHTML = `
      <div class="empty-state">
        <p>No optional add-ons selected</p>
      </div>
    `;
    return;
  }
  
  step3Selection.innerHTML = selectedProducts.step3.map((fixture, index) => `
    <div class="product-info" data-fixture-index="${index}">
      <img src="${fixture.image}" alt="${fixture.title}" class="product-image">
      <span>${fixture.title}</span>
      <div class="price-info">
        <div>$${(parseFloat(fixture.price)/100).toFixed(2)}</div>
        ${fixture.compare_at_price > fixture.price ? 
          `<div class="cart-compare-price">$${(parseFloat(fixture.compare_at_price)/100).toFixed(2)}</div>` 
          : ''}
      </div>
      <div class="quantity-selector">
        <button onclick="updateQuantity('step3', -1, ${index})">-</button>
        <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
        <button onclick="updateQuantity('step3', 1, ${index})">+</button>
      </div>
      <button class="remove-addon" onclick="removeFixture(${index})">Remove</button>
    </div>
  `).join('');
}

function updateStep4Selection() {
  const step4Selection = document.querySelector('.step4-selection');
  if (selectedProducts.step4.length === 0) {
    step4Selection.innerHTML = `
      <div class="empty-state">
        <p>No additional optional add-ons selected</p>
      </div>
    `;
    return;
  }
  
  step4Selection.innerHTML = selectedProducts.step4.map((addon, index) => `
    <div class="product-info" data-additional-addon-index="${index}">
      <img src="${addon.image}" alt="${addon.title}" class="product-image">
      <span>${addon.title}</span>
      <div class="price-info">
        <div>$${(parseFloat(addon.price)/100).toFixed(2)}</div>
        ${addon.compare_at_price > addon.price ? 
          `<div class="cart-compare-price">$${(parseFloat(addon.compare_at_price)/100).toFixed(2)}</div>` 
          : ''}
      </div>
      <div class="quantity-selector">
        <button onclick="updateQuantity('step4', -1, ${index})">-</button>
        <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
        <button onclick="updateQuantity('step4', 1, ${index})">+</button>
      </div>
      <button class="remove-addon" onclick="removeAdditionalAddon(${index})">Remove</button>
    </div>
  `).join('');
}

function updateQuantity(productType, change, index) {
  const quantityInput = document.querySelector(
    index !== undefined 
      ? `.${productType}-selection [data-${productType === 'step3' ? 'fixture' : productType === 'step4' ? 'additional-addon' : 'addon'}-index="${index}"] .quantity-input`
      : `.${productType}-selection .quantity-input`
  );
  
  if (!quantityInput) return;
  
  let quantity = parseInt(quantityInput.value) + change;
  quantity = Math.max(1, quantity);
  quantityInput.value = quantity;
  
  updateTotal();
}

function updateTotal() {
  let total = 0;
  let compareTotal = 0;
  let hasProducts = false;
  
  if (selectedProducts.step1) {
    hasProducts = true;
    const quantity = parseInt(document.querySelector('.step1-selection .quantity-input')?.value) || 1;
    total += parseFloat(selectedProducts.step1.price) * quantity;
    compareTotal += parseFloat(selectedProducts.step1.compare_at_price || selectedProducts.step1.price) * quantity;
  }
  
  selectedProducts.step2.forEach((addon, index) => {
    const quantity = parseInt(document.querySelector(`.step2-selection [data-addon-index="${index}"] .quantity-input`)?.value) || 1;
    total += parseFloat(addon.price) * quantity;
    compareTotal += parseFloat(addon.compare_at_price || addon.price) * quantity;
  });
  
  selectedProducts.step3.forEach((fixture, index) => {
    const quantity = parseInt(document.querySelector(`.step3-selection [data-fixture-index="${index}"] .quantity-input`)?.value) || 1;
    total += parseFloat(fixture.price) * quantity;
    compareTotal += parseFloat(fixture.compare_at_price || fixture.price) * quantity;
  });
  
  selectedProducts.step4.forEach((addon, index) => {
    const quantity = parseInt(document.querySelector(`.step4-selection [data-additional-addon-index="${index}"] .quantity-input`)?.value) || 1;
    total += parseFloat(addon.price) * quantity;
    compareTotal += parseFloat(addon.compare_at_price || addon.price) * quantity;
  });
  
  const savings = compareTotal - total;
  const savingsDisplay = document.querySelector('.savings-display');
  
  if (hasProducts && savings > 0) {
    savingsDisplay.style.display = 'flex';
    document.querySelector('.savings-amount').textContent = `-$${(savings/100).toFixed(2)}`;
  } else {
    savingsDisplay.style.display = 'none';
  }
  
  document.querySelector('.price-amount').textContent = `$${(total/100).toFixed(2)}`;
  document.querySelector('.selected-price').textContent = `$${(total/100).toFixed(2)}`;
  
  const totalItems = (selectedProducts.step1 ? 1 : 0) + 
                    selectedProducts.step2.length + 
                    selectedProducts.step3.length +
                    selectedProducts.step4.length;
  document.querySelector('.total-items').textContent = `${totalItems} item${totalItems !== 1 ? 's' : ''}`;
  
  const checkoutBtn = document.querySelector('.checkout-btn');
  checkoutBtn.disabled = !hasProducts;
  checkoutBtn.style.opacity = hasProducts ? '1' : '0.5';
  checkoutBtn.style.cursor = hasProducts ? 'pointer' : 'not-allowed';
}

function removeAddon(index) {
  selectedProducts.step2.splice(index, 1);
  updateStep2Selection();
  updateTotal();
}

function removeFixture(index) {
  selectedProducts.step3.splice(index, 1);
  updateStep3Selection();
  updateTotal();
}

function removeAdditionalAddon(index) {
  selectedProducts.step4.splice(index, 1);
  updateStep4Selection();
  updateTotal();
}

async function handleCheckout() {
  if (!document.querySelector('.checkout-btn').disabled) {
    try {
      await fetch('/cart/clear.js', { method: 'POST' });
      
      if (selectedProducts.step1) {
        const step1Quantity = parseInt(document.querySelector('.step1-selection .quantity-input').value) || 1;
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: selectedProducts.step1.id,
            quantity: step1Quantity,
            properties: { 'Bundle': 'Base Product' }
          })
        });
      }
      
      for (const [index, addon] of selectedProducts.step2.entries()) {
        const quantityInput = document.querySelector(`.step2-selection [data-addon-index="${index}"] .quantity-input`);
        const quantity = parseInt(quantityInput?.value) || 1;
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: addon.id,
            quantity: quantity,
            properties: { 'Bundle': 'Add-on Product' }
          })
        });
      }
      
      for (const [index, fixture] of selectedProducts.step3.entries()) {
        const quantityInput = document.querySelector(`.step3-selection [data-fixture-index="${index}"] .quantity-input`);
        const quantity = parseInt(quantityInput?.value) || 1;
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: fixture.id,
            quantity: quantity,
            properties: { 'Bundle': 'Optional Add-on' }
          })
        });
      }
      
      for (const [index, addon] of selectedProducts.step4.entries()) {
        const quantityInput = document.querySelector(`.step4-selection [data-additional-addon-index="${index}"] .quantity-input`);
        const quantity = parseInt(quantityInput?.value) || 1;
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: addon.id,
            quantity: quantity,
            properties: { 'Bundle': 'Additional Optional Add-on' }
          })
        });
      }
      
      window.location.href = '/checkout';
    } catch (error) {
      console.error('Cart Error:', error);
    }
  }
}
</script>


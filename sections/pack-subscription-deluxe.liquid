{%- assign step1_title = section.settings.step1_title | default: 'Step 1: Choose Your Base Product' -%}
{%- assign step2_title = section.settings.step2_title | default: 'Step 2: Select Add-ons' -%}
{%- assign step3_title = section.settings.step3_title | default: 'Fixtures (Add-On)' -%}
{%- assign step4_title = section.settings.step4_title | default: 'Step 4: Additional Add-ons' -%}
{%- assign step5_title = section.settings.step5_title | default: 'Step 5: Checkout' -%}

<div class="bundle-steps-container">
  <h1 class="bundle-title">{{ section.settings.bundle_title }}</h1> 
  <!-- New layout structure -->
  <div class="bundle-layout">
    <!-- Left side: Products and Steps -->
    <div class="bundle-main-content">
      <!-- Steps Progress Bar -->
      <div class="steps-progress">
        <div class="step-indicators">
          <div class="progress-bar">
            <div class="step-item" data-step="1">
              <div class="step-circle active" style="background-color: {{ section.settings.step_background_color }};">
                {% if section.settings.show_step_numbers %}1{% endif %}
              </div>
              <div class="step-label active">{{ step1_title }}</div>
            </div>
            
            {% if section.settings.step2_products != blank %}
              <div class="step-connector">
                <div class="connector-line"></div>
              </div>
              
              <div class="step-item" data-step="2">
                <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                  {% if section.settings.show_step_numbers %}2{% endif %}
                </div>
                <div class="step-label">{{ step2_title }}</div>
              </div>
            {% endif %}
            
            {% if section.settings.step3_products != blank %}
              <div class="step-connector">
                <div class="connector-line"></div>
              </div>
              
              <div class="step-item" data-step="3">
                <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                  {% if section.settings.show_step_numbers %}3{% endif %}
                </div>
                <div class="step-label">{{ step3_title }}</div>
              </div>
            {% endif %}

            {% if section.settings.step4_products != blank %}
              <div class="step-connector">
                <div class="connector-line"></div>
              </div>
              
              <div class="step-item" data-step="4">
                <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                  {% if section.settings.show_step_numbers %}4{% endif %}
                </div>
                <div class="step-label">{{ step4_title }}</div>
              </div>
            {% endif %}

            <div class="step-connector">
              <div class="connector-line"></div>
            </div>
            
            <div class="step-item" data-step="5">
              <div class="step-circle" style="background-color: {{ section.settings.step_background_color }};">
                {% if section.settings.show_step_numbers %}5{% endif %}
              </div>
              <div class="step-label">{{ step5_title }}<div class="step-total"><span class="selected-price"></span></div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 1 Content -->
      <div class="step-content active" data-step="1">
        <h2>{{ step1_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step1_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="custom-select">
                          <select id="variant-select-{{ product.id }}" class="variant-select" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" 
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-compare-price="{{ variant.compare_at_price }}"
                                      data-variant-image="{{ variant.featured_image | default: product.featured_image | img_url: '800x800' }}"
                                      {% if forloop.first %}selected{% endif %}>
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-price="{{ product.price }}"
                              data-product-compare-price="{{ product.compare_at_price }}"
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: #000000;
                                     color: white;
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Step 2 Content -->
      <div class="step-content" data-step="2" style="display: none;">
        <h2>{{ step2_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step2_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="color-swatch-container">
                          {% assign variant_count = product.variants | size %}
                          {% for variant in product.variants %}
                            {% assign option_value = variant.option1 %}
                            {% assign color_value = variant.option_values[0].value %}
                            <div class="color-swatch {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% if forloop.index > 4 %}hidden{% endif %}"
                                 data-variant-id="{{ variant.id }}"
                                 data-variant-price="{{ variant.price }}"
                                 data-variant-image="{{ variant.image | img_url: '800x800' }}"
                                 style="background-color: {{ color_value }}; border: 2px solid #ddd;"
                                 onclick="updateProductImage(this, '{{ variant.image | img_url: '800x800' }}'); updateCartTotal({{ variant.price }})"
                                 title="{{ variant.title }} - {{ variant.price | money }}">
                            </div>
                          {% endfor %}
                          {% if variant_count > 4 %}
                            <div class="more-variants" onclick="showAllVariants(this)">+{{ variant_count | minus: 4 }}</div>
                          {% endif %}
                        </div>
                        <select id="variant-select-{{ product.id }}" class="variant-select hidden" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                          {% for variant in product.variants %}
                            <option value="{{ variant.id }}" 
                                    data-variant-price="{{ variant.price }}"
                                    data-variant-image="{{ variant.image | img_url: '800x800' }}"
                                    {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                              {{ variant.title }} - {{ variant.price | money }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    </div>
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: #000000; /* Changed to black */
                                     color: white;
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Step 3 Content -->
      <div class="step-content" data-step="3" style="display: none;">
        <h2>{{ step3_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step3_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="custom-select">
                          <select id="variant-select-{{ product.id }}" class="variant-select" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" 
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-compare-price="{{ variant.compare_at_price }}"
                                      data-variant-image="{{ variant.featured_image | default: product.featured_image | img_url: '800x800' }}"
                                      {% if forloop.first %}selected{% endif %}>
                                {{ variant.title }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-price="{{ product.price }}"
                              data-product-compare-price="{{ product.compare_at_price }}"
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: {{ section.settings.choose_button_color }};
                                     color: {{ section.settings.choose_button_text_color }};
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="skip-step-container">
          <button class="skip-step-btn" onclick="skipToCheckout()">
            Skip this step →
          </button>
        </div>
      </div>

      <!-- Step 4 Content -->
      <div class="step-content" data-step="4" style="display: none;">
        <h2>{{ step4_title }}</h2>
        <div class="products-grid">
          <div class="products-row">
            {% for product in section.settings.step4_products %}
              <div class="product-wrapper">
                <div class="product-card">
                  <div class="product-image-container">
                    <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" class="product-image-main">
                  </div>
                  <div class="product-info">
                    <h4 class="product-title">{{ product.title }}</h4>
                    <div class="price-container">
                      <span class="product-price">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="compare-price">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    <div class="variant-selection">
                      <div class="variant-row">
                        <label for="variant-select-{{ product.id }}" class="variant-label">Select Variant:</label>
                        <div class="custom-select">
                          <select id="variant-select-{{ product.id }}" class="variant-select" data-product-id="{{ product.id }}" onchange="handleVariantChange(this)">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}" 
                                      data-variant-price="{{ variant.price }}"
                                      data-variant-image="{{ variant.featured_image | default: product.featured_image | img_url: '800x800' }}"
                                      {% if forloop.first %}selected{% endif %}>
                                {{ variant.title }} - {{ variant.price | money }}
                              </option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="button-container">
                      <button class="choose-btn" 
                              data-product-id="{{ product.id }}" 
                              data-product-title="{{ product.title }}" 
                              data-product-price="{{ product.price }}" 
                              data-product-image="{{ product.featured_image | img_url: '150x150' }}"
                              style="background-color: #000000;
                                     color: white;
                                     font-size: {{ section.settings.choose_button_size }}px;
                                     border-radius: {{ section.settings.choose_button_radius }}px;
                                     padding: 12px 20px;
                                     margin-top: 15px;
                                     cursor: pointer;
                                     transition: all 0.3s ease;">
                        Choose Now <span class="arrow">→</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="skip-step-container">
          <button class="skip-step-btn" onclick="skipToCheckout()">
            Skip this step →
          </button>
        </div>
      </div>
    </div>

    <!-- Right side: Fixed Cart Summary -->
    <div class="bundle-cart-sidebar">
      <div class="cart-summary">
        <div class="cart-header">
          <h3>Your Bundle Summary</h3>
          <span class="total-items">0 items</span>
        </div>
        
        <!-- Base Product Selection -->
        <div class="cart-section">
          <h4>Base Product</h4>
          <div class="step1-selection cart-items">
            <div class="empty-state">
              <p>No base product selected</p>
            </div>
          </div>
        </div>

        <!-- Add-ons Selection -->
        <div class="cart-section">
          <h4>Add-ons</h4>
          <div class="step2-selection cart-items">
            <div class="empty-state">
              <p>No add-ons selected</p>
            </div>
          </div>
        </div>

        <!-- Optional Add-ons -->
        <div class="cart-section">
          <h4>Optional Add-ons</h4>
          <div class="step3-selection cart-items">
            <div class="empty-state">
              <p>No optional add-ons selected</p>
            </div>
          </div>
        </div>

        <!-- Additional Add-ons -->
        <div class="cart-section">
          <h4>Additional Add-ons</h4>
          <div class="step4-selection cart-items">
            <div class="empty-state">
              <p>No additional add-ons selected</p>
            </div>
          </div>
        </div>

        <!-- Cart Totals -->
        <div class="cart-totals">
          <div class="savings-display" style="display: none;">
            <span>Your Savings:</span>
            <span class="savings-amount">$0.00</span>
          </div>
          <div class="subtotal">
            <span>Subtotal</span>
            <span class="price-amount">$0.00</span>
          </div>
          <div class="shipping-note">Taxes and shipping calculated at checkout</div>
          <button class="checkout-btn" disabled
            style="background-color: {{ section.settings.checkout_button_color }}; 
                   color: {{ section.settings.checkout_button_text_color }};">
            Proceed to Checkout
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Build Your Bundle",
  "class": "bundle-subscription-section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Bundle Title",
      "default": "Build Your Bundle"
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "Step 1 Title",
      "default": "Step 1: Choose Your Base Product"
    },
    {
      "type": "text",
      "id": "step2_title",
      "label": "Step 2 Title", 
      "default": "Step 2: Select Add-ons"
    },
    {
      "type": "text",
      "id": "step3_title",
      "label": "Step 3 Title",
      "default": "Fixtures (Add-On)"
    },
    {
      "type": "text",
      "id": "step4_title",
      "label": "Step 4 Title",
      "default": "Additional Add-ons"
    },
    {
      "type": "text",
      "id": "step5_title", 
      "label": "Step 5 Title",
      "default": "Step 5: Checkout"
    },
    {
      "type": "range",
      "id": "step_size",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Step Circle Size",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_step_numbers",
      "label": "Show Step Numbers",
      "default": true
    },
    {
      "type": "color",
      "id": "step_number_color",
      "label": "Step Number Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "step_background_color",
      "label": "Step Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color", 
      "id": "step_border_color",
      "label": "Step Circle Border Color",
      "default": "#dcdcdc"
    },
    {
      "type": "range",
      "id": "step_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Step Border Radius",
      "default": 50
    },
    {
      "type": "color",
      "id": "active_step_number_color",
      "label": "Active Step Number Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_step_background_color",
      "label": "Active Step Background Color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "active_step_border_color",
      "label": "Active Step Border Color",
      "default": "#2c3e50"
    },
    {
      "type": "range",
      "id": "step_title_size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Step Title Font Size",
      "default": 20
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "active_step_title_color",
      "label": "Active Step Title Color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "step_title_background_color",
      "label": "Step Title Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_step_title_background_color",
      "label": "Active Step Title Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "select",
      "id": "step_title_alignment",
      "label": "Step Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "step_title_border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Step Title Border Width",
      "default": 0
    },
    {
      "type": "color",
      "id": "step_title_border_color",
      "label": "Step Title Border Color",
      "default": "#dcdcdc"
    },
    {
      "type": "range",
      "id": "step_title_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Step Title Border Radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Product Title Size",
      "default": 24
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product Title Color",
      "default": "#2c3e50"
    },
    {
      "type": "select",
      "id": "product_title_alignment",
      "label": "Product Title Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "choose_button_alignment",
      "label": "Choose Button Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],

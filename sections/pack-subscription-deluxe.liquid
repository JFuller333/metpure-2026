<script>
let cartTotal = 0;

function updateProductImage(swatch, imageUrl) {
  const productWrapper = swatch.closest('.product-wrapper');
  const productImage = productWrapper.querySelector('.product-image-main');
  
  if (productImage && imageUrl) {
    productImage.src = imageUrl;
  }
  
  const allSwatches = productWrapper.querySelectorAll('.color-swatch');
  allSwatches.forEach(s => s.classList.remove('selected'));
  swatch.classList.add('selected');
  
  const variantId = swatch.getAttribute('data-variant-id');
  const select = productWrapper.querySelector('.variant-select');
  if (select && variantId) {
    select.value = variantId;
  }
}

function updateCartTotal(price) {
  cartTotal = price / 100;
  document.querySelector('.selected-price').textContent = `$${cartTotal.toFixed(2)}`;
}

function handleVariantChange(select) {
  const selectedOption = select.options[select.selectedIndex];
  const productCard = select.closest('.product-card');
  const chooseBtn = productCard.querySelector('.choose-btn');
  const price = selectedOption.dataset.variantPrice;
  const comparePrice = selectedOption.dataset.variantComparePrice;
  const imageUrl = selectedOption.dataset.variantImage;
  const productImage = productCard.querySelector('.product-image-main');
  
  // Update product image if available
  if (productImage && imageUrl) {
    productImage.src = imageUrl;
  }

  // Update button data attributes
  chooseBtn.dataset.productPrice = price;
  chooseBtn.dataset.productComparePrice = comparePrice;
  
  // Update price display
  const priceDisplay = productCard.querySelector('.product-price');
  if (priceDisplay) {
    priceDisplay.innerHTML = `$${(parseFloat(price)/100).toFixed(2)}`;
    if (comparePrice && parseFloat(comparePrice) > parseFloat(price)) {
      priceDisplay.innerHTML += `<span class="compare-price">$${(parseFloat(comparePrice)/100).toFixed(2)}</span>`;
    }
  }
}

function showAllVariants(moreButton) {
  const container = moreButton.closest('.color-swatch-container');
  const hiddenSwatches = container.querySelectorAll('.color-swatch.hidden');
  
  hiddenSwatches.forEach(swatch => {
    swatch.classList.remove('hidden');
  });
  
  moreButton.style.display = 'none';
}

document.addEventListener('DOMContentLoaded', function() {
  let currentStep = 1;
  let selectedProducts = {
    step1: null,
    step2: [],
    step3: [],
    step4: [],
    step5: []
  };

  document.querySelectorAll('.step-item').forEach(item => {
    item.addEventListener('click', function() {
      const step = parseInt(this.dataset.step);
      if (currentStep === 5 && step < currentStep) {
        currentStep = step;
        updateStepProgress(currentStep);
        updateProgress(currentStep);
      }
    });
  });

  document.querySelectorAll('.variant-select').forEach(select => {
    select.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const productId = this.dataset.productId;
      const variantId = this.value;
      const variantPrice = selectedOption.dataset.variantPrice;
      const variantTitle = selectedOption.text;
      
      const chooseBtn = document.querySelector(`.choose-btn[data-product-id="${productId}"]`);
      if (chooseBtn) {
        chooseBtn.dataset.variantId = variantId;
        chooseBtn.dataset.variantPrice = variantPrice;
        chooseBtn.dataset.variantTitle = variantTitle;
      }
    });
  });

  function updateProgress(step) {
    document.querySelectorAll('.step-content').forEach(content => {
      content.style.display = 'none';
      content.classList.remove('active');
    });

    const currentContent = document.querySelector(`.step-content[data-step="${step}"]`);
    if (currentContent) {
      currentContent.style.display = 'block';
      currentContent.classList.add('active');
    }
  }

  function handleQuantityChange(input, step, index) {
    const quantity = parseInt(input.value) || 1;
    
    // Ensure minimum quantity is 1
    if (quantity < 1) {
      input.value = 1;
    }

    // Update the stored quantity
    if (step === '1' && selectedProducts.step1) {
      selectedProducts.step1.quantity = quantity;
    } else if (step === '2' && selectedProducts.step2[index]) {
      selectedProducts.step2[index].quantity = quantity;
    } else if (step === '3' && selectedProducts.step3[index]) {
      selectedProducts.step3[index].quantity = quantity;
    }

    // Recalculate totals and savings
    updateTotal();
  }

  function updateTotal() {
    let total = 0;
    let savings = 0;
    const savingsDisplay = document.querySelector('.savings-display');
    const savingsAmount = document.querySelector('.savings-amount');

    // Calculate base product total and savings
    if (selectedProducts.step1) {
      const quantity = selectedProducts.step1.quantity || parseInt(document.querySelector('.step1-selection .quantity-input')?.value) || 1;
      const price = parseFloat(selectedProducts.step1.price) || 0;
      const comparePrice = parseFloat(selectedProducts.step1.compare_at_price) || 0;
      
      total += price * quantity;
      if (comparePrice > price) {
        savings += (comparePrice - price) * quantity;
      }
    }

    // Calculate add-ons total and savings
    selectedProducts.step2.forEach((addon, index) => {
      const quantity = addon.quantity || parseInt(document.querySelector(`.step2-selection [data-addon-index="${index}"] .quantity-input`)?.value) || 1;
      const price = parseFloat(addon.price) || 0;
      const comparePrice = parseFloat(addon.compare_at_price) || 0;
      
      total += price * quantity;
      if (comparePrice > price) {
        savings += (comparePrice - price) * quantity;
      }
    });

    // Calculate optional add-ons total and savings
    selectedProducts.step3.forEach((fixture, index) => {
      const quantity = fixture.quantity || parseInt(document.querySelector(`.step3-selection [data-fixture-index="${index}"] .quantity-input`)?.value) || 1;
      const price = parseFloat(fixture.price) || 0;
      const comparePrice = parseFloat(fixture.compare_at_price) || 0;
      
      console.log('Step 3 Addon Calculations:', {
        index,
        quantity,
        price,
        comparePrice,
        potentialSavings: comparePrice > price ? (comparePrice - price) * quantity : 0
      });
      
      total += price * quantity;
      if (comparePrice > price) {
        savings += (comparePrice - price) * quantity;
      }
    });

    console.log('Final Calculations:', {
      total,
      savings
    });

    // Update total price display
    document.querySelector('.price-amount').textContent = `$${(total/100).toFixed(2)}`;
    
    // Update savings display
    if (savings > 0) {
      console.log('Showing savings:', savings);
      savingsDisplay.style.display = 'flex';
      savingsAmount.textContent = `$${(savings/100).toFixed(2)}`;
    } else {
      console.log('No savings to display');
      savingsDisplay.style.display = 'none';
    }

    // Update checkout button state
    const checkoutBtn = document.querySelector('.checkout-btn');
    checkoutBtn.disabled = !selectedProducts.step1;
  }

  document.querySelectorAll('.step-title').forEach(title => {
    title.addEventListener('click', function() {
      const step = parseInt(this.dataset.step);
      if(step <= currentStep) {
        currentStep = step;
        updateProgress(currentStep);
      }
    });
  });

  document.querySelectorAll('.step-content[data-step="1"] .choose-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const productId = this.dataset.productId;
      const productTitle = this.dataset.productTitle;
      const productImage = this.dataset.productImage;
      const variantSelect = document.querySelector(`#variant-select-${productId}`);
      const selectedVariant = variantSelect.options[variantSelect.selectedIndex];
      const variantPrice = selectedVariant.dataset.variantPrice;
      const variantComparePrice = selectedVariant.dataset.variantComparePrice || this.dataset.productComparePrice;
      
      selectedProducts.step1 = {
        id: variantSelect.value,
        title: `${productTitle} - ${selectedVariant.text}`,
        price: variantPrice,
        compare_at_price: variantComparePrice,
        image: productImage
      };
      
      const step1Selection = document.querySelector('.step1-selection');
      step1Selection.innerHTML = `
        <div class="product-info">
          <img src="${selectedProducts.step1.image}" alt="${selectedProducts.step1.title}" class="product-image">
          <span>${selectedProducts.step1.title}</span>
          <div class="price-info">
            <div>
              <span class="product-price">$${(parseFloat(selectedProducts.step1.price)/100).toFixed(2)}</span>
              ${selectedProducts.step1.compare_at_price && parseFloat(selectedProducts.step1.compare_at_price) > parseFloat(selectedProducts.step1.price) ? 
                `<br><span class="compare-price">$${(parseFloat(selectedProducts.step1.compare_at_price)/100).toFixed(2)}</span>` 
                : ''}
            </div>
          </div>
        </div>`;
      
      currentStep = 2;
      updateStepProgress(currentStep);
      updateProgress(currentStep);
      
      document.querySelector('.step1-selection').innerHTML = `
        <div class="product-info" data-addon-index="0">
          <img src="${productImage}" alt="${productTitle}" class="product-image">
          <span>${selectedProducts.step1.title}</span>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step1', -1)">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step1', 1)">+</button>
          </div>
          <div class="product-total">$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
        </div>
      `;
      updateTotal();
    });
  });

  document.querySelectorAll('.step-content[data-step="2"] .choose-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const productId = this.dataset.productId;
      const productTitle = this.dataset.productTitle;
      const productImage = this.dataset.productImage;
      const variantSelect = document.querySelector(`#variant-select-${productId}`);
      const selectedVariant = variantSelect.options[variantSelect.selectedIndex];
      const variantPrice = selectedVariant.dataset.variantPrice;
      const variantComparePrice = selectedVariant.dataset.variantComparePrice || this.dataset.productComparePrice;
      
      const newAddon = {
        id: variantSelect.value,
        title: `${productTitle} - ${selectedVariant.text}`,
        price: variantPrice,
        compare_at_price: variantComparePrice,
        image: productImage
      };
      
      selectedProducts.step2.push(newAddon);
      
      const step2Selection = document.querySelector('.step2-selection');
      step2Selection.innerHTML = selectedProducts.step2.map((addon, index) => `
        <div class="product-info" data-addon-index="${index}">
          <img src="${addon.image}" alt="${addon.title}" class="product-image">
          <span>${addon.title}</span>
          <div class="price-info">
            <div>
              <span class="product-price">$${(parseFloat(addon.price)/100).toFixed(2)}</span>
              ${addon.compare_at_price && parseFloat(addon.compare_at_price) > parseFloat(addon.price) ? 
                `<br><span class="compare-price">$${(parseFloat(addon.compare_at_price)/100).toFixed(2)}</span>` 
                : ''}
            </div>
          </div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step2', -1, ${index})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step2', 1, ${index})">+</button>
          </div>
          <button class="remove-addon" onclick="removeAddon(${index})">Remove</button>
        </div>
      `).join('');
      
      updateTotal();
      
      currentStep = 3;
      updateStepProgress(currentStep);
      updateProgress(currentStep);
    });
  });

  document.querySelectorAll('.step-content[data-step="3"] .choose-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const productId = this.dataset.productId;
      const productTitle = this.dataset.productTitle;
      const productImage = this.dataset.productImage;
      const variantSelect = document.querySelector(`#variant-select-${productId}`);
      const selectedVariant = variantSelect.options[variantSelect.selectedIndex];
      const variantPrice = selectedVariant.dataset.variantPrice;
      const variantComparePrice = selectedVariant.dataset.variantComparePrice || this.dataset.productComparePrice;
      
      const newFixture = {
        id: variantSelect.value,
        title: `${productTitle} - ${selectedVariant.text}`,
        price: variantPrice,
        compare_at_price: variantComparePrice,
        image: productImage
      };
      
      selectedProducts.step3.push(newFixture);
      
      const step3Selection = document.querySelector('.step3-selection');
      step3Selection.innerHTML = selectedProducts.step3.map((fixture, index) => `
        <div class="product-info" data-fixture-index="${index}">
          <img src="${fixture.image}" alt="${fixture.title}" class="product-image">
          <span>${fixture.title}</span>
          <div class="price-info">
            <div>
              <span class="product-price">$${(parseFloat(fixture.price)/100).toFixed(2)}</span>
              ${fixture.compare_at_price && parseFloat(fixture.compare_at_price) > parseFloat(fixture.price) ? 
                `<br><span class="compare-price">$${(parseFloat(fixture.compare_at_price)/100).toFixed(2)}</span>` 
                : ''}
            </div>
          </div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step3', -1, ${index})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step3', 1, ${index})">+</button>
          </div>
          <button class="remove-addon" onclick="removeFixture(${index})">Remove</button>
        </div>
      `).join('');
      
      updateTotal();
      
      currentStep = 4;
      updateStepProgress(currentStep);
      updateProgress(currentStep);
    });
  });

  document.querySelectorAll('.step-content[data-step="4"] .choose-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const productId = this.dataset.productId;
      const productTitle = this.dataset.productTitle;
      const productImage = this.dataset.productImage;
      const variantSelect = document.querySelector(`#variant-select-${productId}`);
      const selectedVariant = variantSelect.options[variantSelect.selectedIndex];
      const variantPrice = selectedVariant.dataset.variantPrice;
      const variantComparePrice = selectedVariant.dataset.variantComparePrice || this.dataset.productComparePrice;
      
      const newExtra = {
        id: variantSelect.value,
        title: `${productTitle} - ${selectedVariant.text}`,
        price: variantPrice,
        compare_at_price: variantComparePrice,
        image: productImage
      };
      
      selectedProducts.step4.push(newExtra);
      
      const step4Selection = document.querySelector('.step4-selection');
      step4Selection.innerHTML = selectedProducts.step4.map((extra, index) => `
        <div class="product-info" data-extra-index="${index}">
          <img src="${extra.image}" alt="${extra.title}" class="product-image">
          <span>${extra.title}</span>
          <div class="price-info">
            <div>
              <span class="product-price">$${(parseFloat(extra.price)/100).toFixed(2)}</span>
              ${extra.compare_at_price && parseFloat(extra.compare_at_price) > parseFloat(extra.price) ? 
                `<br><span class="compare-price">$${(parseFloat(extra.compare_at_price)/100).toFixed(2)}</span>` 
                : ''}
            </div>
          </div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step4', -1, ${index})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step4', 1, ${index})">+</button>
          </div>
          <button class="remove-addon" onclick="removeExtra(${index})">Remove</button>
        </div>
      `).join('');
      
      updateTotal();
      
      currentStep = 5;
      updateStepProgress(currentStep);
      updateProgress(currentStep);
    });
  });

  document.querySelectorAll('.step-content[data-step="5"] .choose-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const productId = this.dataset.productId;
      const productTitle = this.dataset.productTitle;
      const productPrice = this.dataset.productPrice;
      const compareAtPrice = this.dataset.productComparePrice;
      const productImage = this.dataset.productImage;
      const variantSelect = document.querySelector(`#variant-select-${productId}`);
      const selectedVariant = variantSelect.options[variantSelect.selectedIndex];
      const variantPrice = selectedVariant.dataset.variantPrice;
      
      const productData = {
        id: productId,
        title: productTitle,
        price: selectedVariant ? selectedVariant.dataset.variantPrice : productPrice,
        compare_at_price: selectedVariant ? selectedVariant.dataset.variantComparePrice : compareAtPrice,
        image: selectedVariant ? selectedVariant.dataset.variantImage : productImage
      };
      
      selectedProducts.step5.push(productData);
      
      const step5Selection = document.querySelector('.step5-selection');
      step5Selection.innerHTML = selectedProducts.step5.map((addon, index) => `
        <div class="product-info" data-addon-index="${index}">
          <img src="${addon.image}" alt="${addon.title}" class="product-image">
          <span>${addon.title}</span>
          <div>$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step5', -1, ${index})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step5', 1, ${index})">+</button>
          </div>
          <div class="product-total">$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <button class="remove-addon" onclick="removeStep5Addon(${index})">Remove</button>
        </div>
      `).join('');
      
      updateTotal();
    });
  });

  window.removeAddon = function(index) {
    selectedProducts.step2.splice(index, 1);
    updateTotal();
    
    const step2Selection = document.querySelector('.step2-selection');
    if (selectedProducts.step2.length === 0) {
      step2Selection.innerHTML = `
        <div class="empty-state">
          <p>No add-ons selected</p>
        </div>
      `;
    } else {
      step2Selection.innerHTML = selectedProducts.step2.map((addon, idx) => `
        <div class="product-info" data-addon-index="${idx}">
          <img src="${addon.image}" alt="${addon.title}" class="product-image">
          <span>${addon.title}</span>
          <div>$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step2', -1, ${idx})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step2', 1, ${idx})">+</button>
          </div>
          <div class="product-total">$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <button class="remove-addon" onclick="removeAddon(${idx})">Remove</button>
        </div>
      `).join('');
    }
  };

  window.removeFixture = function(index) {
    selectedProducts.step3.splice(index, 1);
    updateTotal();
    
    const step3Selection = document.querySelector('.step3-selection');
    if (selectedProducts.step3.length === 0) {
      step3Selection.innerHTML = `
        <div class="empty-state">
          <p>No optional add-ons selected</p>
        </div>
      `;
    } else {
      step3Selection.innerHTML = selectedProducts.step3.map((fixture, idx) => `
        <div class="product-info" data-fixture-index="${idx}">
          <img src="${fixture.image}" alt="${fixture.title}" class="product-image">
          <span>${fixture.title}</span>
          <div>$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step3', -1, ${idx})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step3', 1, ${idx})">+</button>
          </div>
          <div class="product-total">$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <button class="remove-addon" onclick="removeFixture(${idx})">Remove</button>
        </div>
      `).join('');
    }
  };

  window.removeStep4Addon = function(index) {
    selectedProducts.step4.splice(index, 1);
    updateTotal();
    
    const step4Selection = document.querySelector('.step4-selection');
    if (selectedProducts.step4.length === 0) {
      step4Selection.innerHTML = `
        <div class="empty-state">
          <p>No additional add-ons selected</p>
        </div>
      `;
    } else {
      step4Selection.innerHTML = selectedProducts.step4.map((addon, idx) => `
        <div class="product-info" data-addon-index="${idx}">
          <img src="${addon.image}" alt="${addon.title}" class="product-image">
          <span>${addon.title}</span>
          <div>$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step4', -1, ${idx})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step4', 1, ${idx})">+</button>
          </div>
          <div class="product-total">$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <button class="remove-addon" onclick="removeStep4Addon(${idx})">Remove</button>
        </div>
      `).join('');
    }
  };

  window.removeStep5Addon = function(index) {
    selectedProducts.step5.splice(index, 1);
    updateTotal();
    
    const step5Selection = document.querySelector('.step5-selection');
    if (selectedProducts.step5.length === 0) {
      step5Selection.innerHTML = `
        <div class="empty-state">
          <p>No additional add-ons selected</p>
        </div>
      `;
    } else {
      step5Selection.innerHTML = selectedProducts.step5.map((addon, idx) => `
        <div class="product-info" data-addon-index="${idx}">
          <img src="${addon.image}" alt="${addon.title}" class="product-image">
          <span>${addon.title}</span>
          <div>$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <div class="quantity-selector">
            <button onclick="updateQuantity('step5', -1, ${idx})">-</button>
            <input type="number" class="quantity-input" value="1" min="1" onchange="updateTotal()">
            <button onclick="updateQuantity('step5', 1, ${idx})">+</button>
          </div>
          <div class="product-total">$${(parseFloat(selectedVariant ? selectedVariant.dataset.variantPrice : productPrice)/100).toFixed(2)}</div>
          <button class="remove-addon" onclick="removeStep5Addon(${idx})">Remove</button>
        </div>
      `).join('');
    }
  };

  document.querySelector('.checkout-btn').addEventListener('click', async function() {
    if (!this.disabled && selectedProducts.step1) {
      try {
        await fetch('/cart/clear.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const step1Quantity = parseInt(document.querySelector('.step1-selection .quantity-input').value) || 1;
        await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: selectedProducts.step1.id,
            quantity: step1Quantity,
            properties: {
              'Bundle': 'Base Product'
            }
          })
        });

        for (const addon of selectedProducts.step2) {
          const addonIndex = selectedProducts.step2.indexOf(addon);
          const quantityInput = document.querySelector(`.step2-selection [data-addon-index="${addonIndex}"] .quantity-input`);
          const quantity = parseInt(quantityInput?.value) || 1;
          
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: addon.id,
              quantity: quantity,
              properties: {
                'Bundle': 'Add-on Product'
              }
            })
          });
        }

        for (const fixture of selectedProducts.step3) {
          const fixtureIndex = selectedProducts.step3.indexOf(fixture);
          const quantityInput = document.querySelector(`.step3-selection [data-fixture-index="${fixtureIndex}"] .quantity-input`);
          const quantity = parseInt(quantityInput?.value) || 1;
          
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: fixture.id,
              quantity: quantity,
              properties: {
                'Bundle': 'Optional Add-on'
              }
            })
          });
        }

        for (const addon of selectedProducts.step4) {
          const addonIndex = selectedProducts.step4.indexOf(addon);
          const quantityInput = document.querySelector(`.step4-selection [data-addon-index="${addonIndex}"] .quantity-input`);
          const quantity = parseInt(quantityInput?.value) || 1;
          
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: addon.id,
              quantity: quantity,
              properties: {
                'Bundle': 'Additional Add-on'
              }
            })
          });
        }

        for (const addon of selectedProducts.step5) {
          const addonIndex = selectedProducts.step5.indexOf(addon);
          const quantityInput = document.querySelector(`.step5-selection [data-addon-index="${addonIndex}"] .quantity-input`);
          const quantity = parseInt(quantityInput?.value) || 1;
          
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: addon.id,
              quantity: quantity,
              properties: {
                'Bundle': 'Final Add-on'
              }
            })
          });
        }

        window.location.href = '/checkout';

      } catch (error) {
        console.error('Cart Error:', error);
      }
    }
  });

  window.updateQuantity = updateQuantity;
  window.updateTotal = updateTotal;
});

function updateStepProgress(currentStep) {
  const stepsProgress = document.querySelector('.steps-progress');
  
  if (currentStep === 5) {
    stepsProgress.classList.add('step-5-active');
  } else {
    stepsProgress.classList.remove('step-5-active');
  }

  document.querySelectorAll('.step-item').forEach((item, index) => {
    const stepNumber = index + 1;
    const circle = item.querySelector('.step-circle');
    const label = item.querySelector('.step-label');
    const connector = item.nextElementSibling?.querySelector('.connector-line');
    
    if (stepNumber < currentStep) {
      circle.classList.add('completed', 'active');
      label.classList.add('active');
      if (connector) connector.parentElement.classList.add('completed');
    } else if (stepNumber === currentStep) {
      circle.classList.add('active');
      label.classList.add('active');
      if (connector) connector.parentElement.classList.remove('completed');
    } else {
      circle.classList.remove('completed', 'active');
      label.classList.remove('active');
      if (connector) connector.parentElement.classList.remove('completed');
    }
  });
}

function updateProgress(step) {
  document.querySelectorAll('.step-content').forEach(content => {
    content.style.display = 'none';
    content.classList.remove('active');
  });

  const currentContent = document.querySelector(`.step-content[data-step="${step}"]`);
  if (currentContent) {
    currentContent.style.display = 'block';
    currentContent.classList.add('active');
  }
}

function skipToCheckout() {
  currentStep = 5;
  updateStepProgress(currentStep);
  updateProgress(currentStep);
}
</script>

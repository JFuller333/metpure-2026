    },
    {
      "type": "color",
      "id": "choose_button_color",
      "label": "Choose Button Color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "choose_button_text_color",
      "label": "Choose Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "choose_button_hover_color",
      "label": "Choose Button Hover Color",
      "default": "#34495e"
    },
    {
      "type": "range",
      "id": "choose_button_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Choose Button Font Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "choose_button_border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Choose Button Border Width",
      "default": 0
    },
    {
      "type": "color",
      "id": "choose_button_border_color",
      "label": "Choose Button Border Color",
      "default": "#2c3e50"
    },
    {
      "type": "range",
      "id": "choose_button_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Choose Button Border Radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "checkout_button_color",
      "label": "Checkout Button Color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "checkout_button_text_color",
      "label": "Checkout Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "checkout_button_alignment",
      "label": "Checkout Button Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {

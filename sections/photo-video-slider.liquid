<div class="slider-section" data-section-id="{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="slider-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  
  <div class="slider-container">
    <div class="slider" id="slider-{{ section.id }}" data-autoslide="{{ section.settings.auto_slide }}">
      {% for block in section.blocks %}
        <div class="slide" {{ block.shopify_attributes }}>
          {% if block.settings.media_type == 'image' %}
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}"
                   alt="{{ block.settings.image.alt | escape }}"
                   loading="lazy"
                   width="{{ block.settings.image.width }}"
                   height="{{ block.settings.image.height }}">
            {% endif %}
          {% else %}
            {% if block.settings.video_url != blank %}
              <div class="video-wrapper">
                <video playsinline autoplay muted loop>
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <button class="slider-nav prev" aria-label="Previous slide">‹</button>
    <button class="slider-nav next" aria-label="Next slide">›</button>
  </div>
</div>

<style>
  .slider-section {
    margin: 20px 0;
    width: 100%;
    padding: 0;
  }

  .slider-heading {
    text-align: center;
    margin-bottom: 20px;
    font-size: 2.3em;
  }

  .slider-container {
    position: relative;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    padding: 10px 0;
  }

  .slider {
    display: flex;
    transition: transform 0.5s ease;
    gap: 15px;
    width: 100%;
  }

  .slide {
    flex: 0 0 calc(33.333% - 10px);
    aspect-ratio: 1/1;
    max-width: 300px;
    height: auto;
    position: relative;
  }

  .slide img,
  .video-wrapper {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1/1;
  }

  .video-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.8);
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    font-size: 20px;
    cursor: pointer;
    z-index: 2;
  }

  .slider-nav.prev {
    left: 10px;
  }

  .slider-nav.next {
    right: 10px;
  }

  @media screen and (max-width: 768px) {
    .slide {
      flex: 0 0 calc(50% - 8px);
      max-width: 220px;
    }
  }

  @media screen and (max-width: 480px) {
    .slide {
      flex: 0 0 100%;
      max-width: 200px;
    }
  }
</style>

<script>
  class Slider {
    constructor(container) {
      this.container = container;
      this.slider = container.querySelector('.slider');
      this.slides = Array.from(container.querySelectorAll('.slide'));
      this.prevBtn = container.querySelector('.prev');
      this.nextBtn = container.querySelector('.next');
      this.autoSlide = false;
      this.currentIndex = 0;
      this.visibleSlides = this.getVisibleSlides();
      this.slideWidth = this.slides[0]?.offsetWidth || 300;
      this.interval = null;
      this.resizeObserver = null;
      this.init();
    }

    getVisibleSlides() {
      if (window.innerWidth <= 480) return 1;
      if (window.innerWidth <= 768) return 2;
      return 3;
    }

    updateSlideWidth() {
      if (this.slides.length > 1) {
        const slideRect = this.slides[0].getBoundingClientRect();
        const nextSlideRect = this.slides[1]?.getBoundingClientRect();
        if (nextSlideRect) {
          this.slideWidth = nextSlideRect.left - slideRect.left;
        } else {
          this.slideWidth = slideRect.width;
        }
      } else {
        this.slideWidth = this.slides[0]?.offsetWidth || 300;
      }
    }

    moveTo(index) {
      this.updateSlideWidth();
      const containerWidth = this.container.querySelector('.slider-container').offsetWidth;
      const totalSlidesWidth = this.slides.length * this.slideWidth;
      const maxOffset = Math.max(0, totalSlidesWidth - containerWidth);
      const maxIndex = Math.max(0, Math.ceil(maxOffset / this.slideWidth));
      if (index < 0) {
        this.currentIndex = 0;
      } else if (index > maxIndex) {
        this.currentIndex = maxIndex;
      } else {
        this.currentIndex = index;
      }
      let offset = this.currentIndex * this.slideWidth;
      if (offset > maxOffset) offset = maxOffset;
      this.slider.style.transform = `translateX(${-offset}px)`;
    }

    next() {
      this.moveTo(this.currentIndex + 1);
    }

    prev() {
      this.moveTo(this.currentIndex - 1);
    }

    startAutoSlide() {
      // Do nothing, auto-slide is off
    }

    stopAutoSlide() {
      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
      }
    }

    handleResize() {
      this.visibleSlides = this.getVisibleSlides();
      this.updateSlideWidth();
      this.moveTo(this.currentIndex);
    }

    init() {
      if (this.slides.length <= 1) return;
      this.updateSlideWidth();
      this.moveTo(0);
      this.prevBtn.addEventListener('click', () => {
        this.stopAutoSlide();
        this.prev();
      });
      this.nextBtn.addEventListener('click', () => {
        this.stopAutoSlide();
        this.next();
      });
      window.addEventListener('resize', () => this.handleResize());
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const sliderContainers = document.querySelectorAll('.slider-section');
    sliderContainers.forEach(container => new Slider(container));
  });
</script>

{% schema %}
{
  "name": "Photo & Video Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Media Slider"
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "Auto-slide",
      "default": true,
      "info": "Automatically slide through images"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Select when Media Type is Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Enter MP4 video URL when Media Type is Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo & Video Slider",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
{% schema %}
{
  "name": "Support Contact",
  "settings": [
    {
      "type": "header",
      "content": "Left Column Settings"
    },
    {
      "type": "text", 
      "id": "left_heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "left_subheading", 
      "label": "Sub Heading",
      "default": "Get in touch with our team"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range", 
      "id": "subheading_size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Sub Heading Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color", 
      "label": "Sub Heading Color",
      "default": "#666666"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "helvetica_n4"
    },
    {
      "type": "font_picker",
      "id": "subheading_font",
      "label": "Sub Heading Font",
      "default": "helvetica_n4"
    },
    {
      "type": "select",
      "id": "left_alignment",
      "label": "Left Column Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "left_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Left Column Width",
      "default": 50
    },
    {
      "type": "header",
      "content": "Center Column Settings"
    },
    {
      "type": "text",
      "id": "phone_btn_text",
      "label": "Phone Button Text",
      "default": "Call Us"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "+1 (555) 123-4567"
    },
    {
      "type": "text",
      "id": "email_btn_text",
      "label": "Email Button Text",
      "default": "Email Us"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "support@example.com"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color", 
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Button Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "btn_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Text Size",
      "default": 16
    },
    {
      "type": "select",
      "id": "btn_alignment",
      "label": "Button Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "center_width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Center Column Width",
      "default": 25
    },
    {
      "type": "header",
      "content": "Right Column Settings"
    },
    {
      "type": "richtext",
      "id": "right_paragraph_1",
      "label": "First Paragraph",
      "default": "<p>We're here to help with any questions you might have.</p>"
    },
    {
      "type": "richtext",
      "id": "right_paragraph_2",
      "label": "Second Paragraph",
      "default": "<p>Our support team is available Monday through Friday, 9am-5pm.</p>"
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Paragraph Text Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph Text Color",
      "default": "#666666"
    },
    {
      "type": "font_picker",
      "id": "paragraph_font",
      "label": "Paragraph Font",
      "default": "helvetica_n4"
    },
    {
      "type": "select",
      "id": "right_alignment",
      "label": "Right Column Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "right_width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%", 
      "label": "Right Column Width",
      "default": 25
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Section Height",
      "default": 400
    },
    {
      "type": "range",
      "id": "section_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Content Max Width",
      "default": 1200
    },
    {
      "type": "select",
      "id": "section_alignment",
      "label": "Section Content Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Support Contact"
    }
  ]
}
{% endschema %}

<style>
.support-contact {
  background-color: {{ section.settings.section_bg_color }};
  min-height: {{ section.settings.section_height }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.support-contact__container {
  width: 100%;
  max-width: {{ section.settings.section_width }}px;
  margin: 0 auto;
  padding: 40px 20px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 30px;
}

.support-contact__left {
  text-align: {{ section.settings.left_alignment }};
  width: {{ section.settings.left_width }}%;
}

.support-contact__heading {
  font-family: {{ section.settings.heading_font.family }};
  font-size: {{ section.settings.heading_size }}px;
  color: {{ section.settings.heading_color }};
  margin-bottom: 1rem;
}

.support-contact__subheading {
  font-family: {{ section.settings.subheading_font.family }};
  font-size: {{ section.settings.subheading_size }}px;
  color: {{ section.settings.subheading_color }};
}

.support-contact__center {
  text-align: {{ section.settings.btn_alignment }};
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: {{ section.settings.center_width }}%;
}

.support-contact__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 24px;
  font-size: {{ section.settings.btn_text_size }}px;
  color: {{ section.settings.btn_text_color }};
  background-color: {{ section.settings.btn_bg_color }};
  border: 1px solid {{ section.settings.btn_border_color }};
  text-decoration: none;
  border-radius: 4px;
  transition: opacity 0.2s ease;
  width: 100%;
}

.support-contact__button svg {
  width: 20px;
  height: 20px;
  fill: {{ section.settings.icon_color }};
}

.support-contact__button:hover {
  opacity: 0.8;
}

.support-contact__right {
  text-align: {{ section.settings.right_alignment }};
  width: {{ section.settings.right_width }}%;
}

.support-contact__paragraph {
  font-family: {{ section.settings.paragraph_font.family }};
  font-size: {{ section.settings.paragraph_size }}px;
  color: {{ section.settings.paragraph_color }};
  margin-bottom: 1rem;
}

@media screen and (max-width: 768px) {
  .support-contact__container {
    flex-direction: column;
    gap: 30px;
    padding: 20px;
  }
  
  .support-contact__left,
  .support-contact__center,
  .support-contact__right {
    width: 100%;
    text-align: center;
  }
}
</style>

<section class="support-contact">
  <div class="support-contact__container">
    <div class="support-contact__left">
      {% if section.settings.left_heading != blank %}
        <h2 class="support-contact__heading">{{ section.settings.left_heading }}</h2>
      {% endif %}
      {% if section.settings.left_subheading != blank %}
        <p class="support-contact__subheading">{{ section.settings.left_subheading }}</p>
      {% endif %}
    </div>

    <div class="support-contact__center">
      {% if section.settings.phone_number != blank %}
        <a href="tel:{{ section.settings.phone_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" 
           class="support-contact__button">
          <svg viewBox="0 0 24 24">
            <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
          </svg>
          {{ section.settings.phone_btn_text }}
        </a>
      {% endif %}

      {% if section.settings.email_address != blank %}
        <a href="mailto:{{ section.settings.email_address }}" 
           class="support-contact__button">
          <svg viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          {{ section.settings.email_btn_text }}
        </a>
      {% endif %}
    </div>

    <div class="support-contact__right">
      {% if section.settings.right_paragraph_1 != blank %}
        <div class="support-contact__paragraph">{{ section.settings.right_paragraph_1 }}</div>
      {% endif %}
      {% if section.settings.right_paragraph_2 != blank %}
        <div class="support-contact__paragraph">{{ section.settings.right_paragraph_2 }}</div>
      {% endif %}
    </div>
  </div>
</section>

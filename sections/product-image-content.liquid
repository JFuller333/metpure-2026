{% schema %}
{
  "name": "Product with Content",
  "settings": [
    {
      "type": "header",
      "content": "Left Section - Image"
    },
    {
      "type": "image_picker", 
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Image Width",
      "default": 500
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 10
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Right Section - Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Title"
    },
    {
      "type": "font",
      "id": "heading_font",
      "label": "Heading Font"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "heading_bold",
      "label": "Bold Heading",
      "default": true
    },
    {
      "type": "text",
      "id": "price",
      "label": "Current Price",
      "default": "$99.99"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare at Price",
      "default": "$149.99"
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Price Font Size",
      "default": 24
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price Color",
      "default": "#000000"
    },
    {
      "type": "font",
      "id": "price_font",
      "label": "Price Font"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Add your product description here</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 16
    },
    {
      "type": "font",
      "id": "description_font",
      "label": "Description Font"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#666666"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button Hover Background Color",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Product Image with Content",
      "category": "Product"
    }
  ]
}
{% endschema %}

<style>
.product-section {
  padding: 50px 20px;
}

.product-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  gap: 40px;
  align-items: center;
}

.product-image-left {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: {{ section.settings.image_alignment }};
}

.product-image {
  width: {{ section.settings.image_width }}px;
  max-width: 100%;
  border-radius: {{ section.settings.image_border_radius }}px;
}

.product-content-right {
  flex: 1;
  text-align: {{ section.settings.content_alignment }};
}

.product-heading {
  font-family: {{ section.settings.heading_font.family }};
  font-size: {{ section.settings.heading_size }}px;
  color: {{ section.settings.heading_color }};
  font-weight: {{ section.settings.heading_bold | default: true | ternary: 'bold', 'normal' }};
  margin-bottom: 20px;
}

.price-container {
  margin-bottom: 20px;
}

.current-price {
  font-family: {{ section.settings.price_font.family }};
  font-size: {{ section.settings.price_size }}px;
  color: {{ section.settings.price_color }};
  margin-right: 10px;
}

.compare-price {
  font-family: {{ section.settings.price_font.family }};
  font-size: calc({{ section.settings.price_size }}px * 0.85);
  color: #999;
  text-decoration: line-through;
}

.product-description {
  font-family: {{ section.settings.description_font.family }};
  font-size: {{ section.settings.description_size }}px;
  color: {{ section.settings.description_color }};
  margin-bottom: 30px;
}

.product-button {
  display: inline-block;
  font-size: {{ section.settings.button_size }}px;
  color: {{ section.settings.button_color }};
  background-color: {{ section.settings.button_bg_color }};
  padding: 12px 30px;
  text-decoration: none;
  border-radius: 5px;
  transition: background-color 0.3s ease;
}

.product-button:hover {
  background-color: {{ section.settings.button_hover_color }};
}

@media screen and (max-width: 768px) {
  .product-container {
    flex-direction: column;
  }
  
  .product-image-left,
  .product-content-right {
    width: 100%;
  }
  
  .product-image {
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
  }
  
  .product-heading {
    font-size: calc({{ section.settings.heading_size }}px * 0.8);
  }
}
</style>

<div class="product-section">
  <div class="product-container">
    <div class="product-image-left">
      {% if section.settings.product_image %}
        <img src="{{ section.settings.product_image | img_url: 'master' }}"
             alt="Product Image"
             class="product-image"
             loading="lazy">
      {% endif %}
    </div>
    <div class="product-content-right">
      <h2 class="product-heading">{{ section.settings.heading }}</h2>
      <div class="price-container">
        <span class="current-price">{{ section.settings.price }}</span>
        <span class="compare-price">{{ section.settings.compare_price }}</span>
      </div>
      <div class="product-description">{{ section.settings.description }}</div>
      <a href="{{ section.settings.button_link }}" class="product-button">
        {{ section.settings.button_text }}
      </a>
    </div>
  </div>
</div>

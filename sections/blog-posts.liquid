{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'article.css' | asset_url | stylesheet_tag }}

{% liquid
  assign show_sidebar = false
  if section.settings.sidebar_show and section.blocks != blank
    assign show_sidebar = true
  endif

  assign design = section.settings.design

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign article_class = 'm-article'
  assign article_class = article_class | append: ' m-article--' | append: design

  if show_sidebar
    if section.settings.sidebar_position == 'left_column'
      assign sidebar_class = 'sidebar-left'
    else
      assign sidebar_class = 'sidebar-right'
    endif
    assign article_class = article_class | append: ' m-article--' | append: sidebar_class
  else
    assign article_class = article_class | append: ' m-article--no-sidebar'
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
%}

<section data-section-type="article-template" data-section-id="{{ section.id }}" class="{{ article_class }}">
  <div class="{{ container }}">
    <div class="m-row{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-article__wrapper">
        {% if section.settings.blog_show_breadcrumb %}
          {% render 'breadcrumb', justify: 'center' %}
        {% endif %}
        {%- if design == 'layout3' -%}
          <style>
            .m-article--layout3 {
              --content-max-width: 100%;
              --heading-color: #1a1a1a;
              --text-color: #333333;
              --spacing-lg: 3rem;
              --spacing-md: 2rem;
              --side-padding: 40px;
              --body-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
            }

            .m-article--layout3 .m-article__wrapper {
              max-width: 100%;
              padding: 0 var(--side-padding);
              width: 100%;
            }

            .m-article--layout3 .m-article__content-container {
              max-width: 100%;
              margin: 0;
              padding: 0;
              width: 100%;
            }

            .m-article--layout3 .m-article__banner {
              width: 100%;
              position: relative;
              overflow: hidden;
              margin-bottom: var(--spacing-lg);
            }

            .m-article--layout3 .m-article__banner img {
              width: 100%;
              height: 100%;
              object-fit: cover;
              object-position: center;
            }

            .m-article--layout3 .m-article__feature-image {
              margin: var(--spacing-md) 0;
              width: 100%;
              position: relative;
              overflow: hidden;
              border-radius: 8px;
            }

            .m-article--layout3 .m-article__feature-image img {
              width: 100%;
              height: 100%;
              object-fit: cover;
              object-position: center;
            }

            .m-article--layout3 .m-article__header {
              margin-bottom: var(--spacing-lg);
              padding-bottom: var(--spacing-md);
              border-bottom: 1px solid #eee;
            }

            .m-article--layout3 .m-article__title {
              font-size: 2.75rem;
              line-height: 1.2;
              color: var(--heading-color);
              margin-bottom: 1.25rem;
              font-weight: 800;
              letter-spacing: -0.02em;
            }

            .m-article--layout3 .m-article__meta {
              color: #666;
              font-size: 1rem;
              line-height: 1.6;
            }

            .m-article--layout3 .m-article__content {
              font-family: var(--body-font);
              font-size: 1.6rem;
              line-height: 1.6;
              color: var(--text-color);
              font-weight: 400;
              letter-spacing: 0.01em;
            }

            .m-article--layout3 .m-article__content p {
              margin-bottom: 1.5rem;
            }

            /* Links in regular content only */
            .m-article--layout3 .m-article__content p a,
            .m-article--layout3 .m-article__content li a {
              color: #54A2D7;
              text-decoration: none;
              transition: opacity 0.2s ease;
            }

            .m-article--layout3 .m-article__content p a:hover,
            .m-article--layout3 .m-article__content li a:hover {
              opacity: 0.8;
            }

            .m-article--layout3 .m-article__content h2 {
              font-size: 2.2rem;
              color: var(--heading-color);
              margin: var(--spacing-lg) 0 var(--spacing-md);
              font-weight: 700;
              letter-spacing: -0.01em;
            }

            .m-article--layout3 .m-article__content h3 {
              font-size: 1.8rem;
              color: var(--heading-color);
              margin: var(--spacing-md) 0;
              font-weight: 600;
            }

            .m-article--layout3 .m-article__content img {
              width: 100%;
              height: auto;
              aspect-ratio: 16/9;
              object-fit: cover;
              border-radius: 8px;
              margin: var(--spacing-md) 0;
            }

            .m-article--layout3 .toc {
              background: #f8f9fa;
              padding: var(--spacing-md);
              border-radius: 8px;
              margin: var(--spacing-md) 0;
            }

            .m-article--layout3 .toc__title {
              margin-bottom: 1rem;
              font-weight: 700;
              font-size: 1.5rem;
            }

            .m-article--layout3 .toc__list {
              list-style: none;
              padding: 0;
            }

            .m-article--layout3 .toc__item {
              margin-bottom: 0.75rem;
              font-size: 1.2rem;
            }

            /* Table of Contents links */
            .m-article--layout3 .toc__link {
              color: inherit;
              text-decoration: none;
              transition: opacity 0.2s ease;
            }

            .m-article--layout3 .toc__link:hover {
              opacity: 0.8;
            }

            .m-article--layout3 .m-article-tags {
              margin-top: var(--spacing-lg);
              padding-top: var(--spacing-md);
              border-top: 1px solid #eee;
            }

            .m-article--layout3 .m-article__content::after {
              content: "";
              display: table;
              clear: both;
            }

            .m-article--layout3 .m-article__banner img,
            .m-article--layout3 .m-article__feature-image img {
              float: none;
              width: 100%;
              height: 400px;
              object-fit: cover;
              object-position: center;
              margin: 0;
            }

            @media screen and (max-width: 768px) {
              .m-article--layout3 {
                --side-padding: 20px;
              }

              .m-article--layout3 .m-article__banner {
                height: 250px;
              }

              .m-article--layout3 .m-article__feature-image {
                height: 300px;
              }

              .m-article--layout3 .m-article__title {
                font-size: 2.25rem;
              }

              .m-article--layout3 .m-article__content h2 {
                font-size: 1.9rem;
              }

              .m-article--layout3 .m-article__content h3 {
                font-size: 1.6rem;
              }

              .m-article--layout3 .m-article__content img {
                float: none;
                width: 100%;
                height: auto;
                aspect-ratio: 3/2;
                margin: var(--spacing-md) 0;
              }

              .m-article--layout3 .m-article__content {
                font-size: 1.4rem;
                line-height: 1.3;
              }

              .m-article--layout3 .m-article__content-container {
                padding: 0;
              }

              .m-article--layout3 .m-article__content p {
                max-width: 100%;
              }
            }

            .m-article--layout3.m-article--sidebar-right,
            .m-article--layout3.m-article--sidebar-left {
              --sidebar-width: 300px;  /* Adjust this value as needed */
              display: flex;
              flex-wrap: wrap;
            }

            .m-article--layout3.m-article--sidebar-right .m-article__wrapper,
            .m-article--layout3.m-article--sidebar-left .m-article__wrapper {
              flex: 1;
              min-width: 0;  /* Prevents flex item from overflowing */
            }

            .m-article--layout3.m-article--sidebar-right .m-blog-sidebar,
            .m-article--layout3.m-article--sidebar-left .m-blog-sidebar {
              width: var(--sidebar-width);
              flex-shrink: 0;
              padding: var(--spacing-md);
            }

            .m-article--layout3.m-article--sidebar-right {
              flex-direction: row;
            }

            .m-article--layout3.m-article--sidebar-left {
              flex-direction: row-reverse;
            }

            /* Responsive handling for sidebar */
            @media screen and (max-width: 991px) {
              .m-article--layout3.m-article--sidebar-right,
              .m-article--layout3.m-article--sidebar-left {
                flex-direction: column;
              }

              .m-article--layout3 .m-blog-sidebar {
                width: 100%;
                margin-top: var(--spacing-lg);
              }
            }

            /* Ensure heading, table, and TOC links maintain their original color */
            .m-article--layout3 .m-article__content h1 a,
            .m-article--layout3 .m-article__content h2 a,
            .m-article--layout3 .m-article__content h3 a,
            .m-article--layout3 .m-article__content h4 a,
            .m-article--layout3 .m-article__content h5 a,
            .m-article--layout3 .m-article__content h6 a,
            .m-article--layout3 .m-article__content td a,
            .m-article--layout3 .m-article__content th a,
            .m-article--layout3 .toc__link {
              color: inherit;
            }

            /* Common aspect ratio utility */
            .aspect-ratio-16-9 {
              position: relative;
              padding-bottom: 56.25%; /* 9/16 = 0.5625 */
              height: 0;
              overflow: hidden;
            }

            .aspect-ratio-16-9 img {
              position: absolute;
              top: 0;
              left: 0;
              width: 100%;
              height: 100%;
              object-fit: cover;
            }

            /* Banner image */
            .m-article--layout3 .m-article__banner {
              width: 100%;
              position: relative;
              overflow: hidden;
              margin-bottom: var(--spacing-lg);
            }

            .m-article--layout3 .m-article__banner .aspect-ratio-16-9 {
              margin: 0;
            }

            /* Feature image */
            .m-article--layout3 .m-article__feature-image {
              margin: var(--spacing-md) 0;
              width: 100%;
              position: relative;
              overflow: hidden;
              border-radius: 8px;
            }

            /* Content images */
            .m-article--layout3 .m-article__content img {
              width: 100%;
              height: auto;
              aspect-ratio: 16/9;
              object-fit: cover;
              border-radius: 8px;
              margin: var(--spacing-md) 0;
            }

            /* Ensure proper image scaling on mobile */
            @media screen and (max-width: 768px) {
              .m-article--layout3 .m-article__content img {
                margin: var(--spacing-md) 0;
              }
            }
          </style>

          {% if article.image %}
            <div class="m-article__banner">
              {% render 'responsive-image', image: article.image, image_class: 'w-full' %}
            </div>
          {% endif %}

          <div class="m-article__wrapper">
            <div class="m-article__content-container">
              <header class="m-article__header">
                <h1 class="m-article__title">{{ article.title }}</h1>
                {% if section.settings.blog_show_author or section.settings.blog_show_date %}
                  <div class="m-article__meta">
                    {% if section.settings.blog_show_author %}
                      {{ 'blogs.article.by_author' | t }}
                      <span>{{ article.author }}</span>
                    {% endif %}
                    {% if section.settings.blog_show_date %}
                      {% if section.settings.blog_show_author %}{{ 'blogs.article.posted_in' | t }}{% endif %}
                      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                        {{ article.published_at | date: '%b %d, %Y' }}
                      </time>
                    {% endif %}
                  </div>
                {% endif %}
              </header>

              {% if section.settings.show_toc %}
                <div class="toc">
                  <h2 class="toc__title">Table of Contents</h2>
                  <ul class="toc__list">
                    {% assign headings = article.content | split: '<h2' %}
                    {% for heading in headings %}
                      {% if forloop.first == false %}
                        {% assign title = heading | split: '</h2>' | first | split: '>' | last %}
                        <li class="toc__item">
                          <a href="#{{ title | handleize }}" class="toc__link">{{ title }}</a>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              <div class="m-article__content rte">
                {{ article.content }}
              </div>

              {% if article.tags.size > 0 and section.settings.blog_show_tags %}
                <div class="m-article-tags">
                  <span class="m-article-tags__heading">{{ 'blogs.article.tags' | t }}</span>
                  {% for tag in article.tags %}
                    <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
                    {%- unless forloop.last %},{% endunless %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {%- else -%}
          {%- if design == 'layout2' and article.image -%}
            <div class="m-article__feature-image">
              {% render 'responsive-image', image: article.image, image_class: 'w-full' %}
            </div>
          {%- endif -%}
          <div role="article" class="m-article__inner">
            <article>
              <div class="m-article__header m:text-center">
                <a class="m-article__blog" href="{{ blog.url }}">{{ blog.title }}</a>
                <h1 class="m-article__title">{{ article.title }}</h1>
                {% if section.settings.blog_show_author or section.settings.blog_show_date %}
                  <div class="m-article__meta">
                    {% if section.settings.blog_show_author %}
                      {{ 'blogs.article.by_author' | t }}
                      <span>{{ article.author }}</span>
                    {% endif %}
                    {% if section.settings.blog_show_date %}
                      {% if section.settings.blog_show_author %}{{ 'blogs.article.posted_in' | t }}{% endif %}
                      <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              {%- if design == 'layout1' and article.image -%}
                <div class="m-article__feature-image">
                  {% render 'responsive-image', image: article.image, image_class: 'w-full' %}
                </div>
              {%- endif -%}

              {% if article.content != blank %}
                <div class="m-article__content rte">
                  {{ article.content }}
                </div>
              {% endif %}

              {%- if section.settings.blog_show_social or section.settings.blog_show_tags -%}
                <div class="m-article__footer">
                  {% if article.tags.size > 0 and section.settings.blog_show_tags %}
                    <div class="m-article-tags">
                      <span class="m-article-tags__heading">{{ 'blogs.article.tags' | t }}</span>
                      {% for tag in article.tags %}
                        <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
                        {%- unless forloop.last %},{% endunless %}
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if section.settings.blog_show_social %}
                    {% assign url = shop.url | append: article.url %}
                    {% render 'social-sharing', url: url, class: 'm:flex m:items-center' %}
                  {% endif %}
                </div>
              {% endif %}

              {%- comment -%}Navigation{%- endcomment -%}
              {% liquid
                assign article_navigation_class = 'm-article-navigation'

                if blog.previous_article != null and blog.next_article != null
                  assign article_navigation_class = article_navigation_class | append: ' m-article-navigation--full m:justify-between'
                elsif blog.previous_article != null
                  assign article_navigation_class = article_navigation_class | append: ' m:justify-start'
                else
                  assign article_navigation_class = article_navigation_class | append: ' m:justify-end'
                endif
              %}
              <div class="{{ article_navigation_class }}">
                {% if blog.previous_article != null %}
                  <a href="{{ blog.previous_article.url }}" class="m-article-navigation__prev">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
                    </svg>
                    <div class="m-article-navigation__inner">
                      <div class="m-article-navigation__label">{{ 'blogs.article.previous_post' | t }}</div>
                      <div class="m-article-navigation__article-title">{{ blog.previous_article.title }}</div>
                    </div>
                  </a>
                {% endif %}
                {% if blog.next_article != null %}
                  <a href="{{ blog.next_article.url }}" class="m-article-navigation__next">
                    <div class="m-article-navigation__inner m:text-right">
                      <div class="m-article-navigation__label">{{ 'blogs.article.next_post' | t }}</div>
                      <div class="m-article-navigation__article-title">{{ blog.next_article.title }}</div>
                    </div>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </a>
                {% endif %}
              </div>

              {%- comment -%}Related Posts{%- endcomment -%}
              {% if section.settings.show_related_articles %}
                <div class="m-related-posts">
                  <h3 class="m-related-posts__heading">{{ 'blogs.article.related_title' | t }}</h3>
                  <div class="m-related-posts__wrapper m-mixed-layout m-mixed-layout--mobile-scroll">
                    <div class="m-mixed-layout__inner m:grid m:grid-2-cols md:m:grid-3-cols">
                      {% liquid
                        assign currentID = article.id
                        assign counter = 0

                        for article in blog.articles limit: 4
                          if counter > 3
                            break
                          endif

                          if article.id == currentID
                            continue
                          endif

                          echo '<div class="m:column">'
                          render 'article-card', article: article, view: 'grid', content_align: section.settings.article_align_content, article_show_date: section.settings.article_show_date, article_show_tags: section.settings.article_show_tags, article_show_excerpt: section.settings.article_show_excerpt, article_show_button: section.settings.article_show_button, animated: animated, animation_effect: animation_effect
                          echo '</div>'
                          assign counter = counter | plus: 1
                        endfor
                      %}
                    </div>
                  </div>
                </div>
              {% endif %}

              {%- comment -%}Comment{%- endcomment -%}
              {%- if blog.comments_enabled? and section.settings.blog_show_comment -%}
                {% liquid
                  assign new_comment = false
                  if comment and comment.created_at
                    assign new_comment = true
                    assign new_comment_id = comment.id
                  endif

                  if new_comment
                    assign duplicate_comment = false
                    for comment in article.comments
                      if comment.id == new_comment_id
                        assign duplicate_comment = true
                        break
                      endif
                    endfor

                    if duplicate_comment
                      assign number_of_comments = article.comments_count
                    else
                      assign number_of_comments = article.comments_count | plus: 1
                    endif
                  else
                    assign number_of_comments = article.comments_count
                  endif
                %}

                {% if number_of_comments > 0 %}
                  <div class="m-comment-section">
                    <h3 class="m-comment-section__heading">
                      {{ 'blogs.comments.comments_with_count' | t: count: number_of_comments }}
                    </h3>
                    {% paginate article.comments by 5 %}
                      <div id="m-comments" class="m-comment-section__wrapper">
                        {% if comment and comment.status and comment.id != blank and paginate.current_page == 1 %}
                          <p class="m-comment-section__form-message">
                            {% if blog.moderated? and comment.status != 'published' %}
                              {{ 'blogs.comments.success_moderated' | t }}
                            {% else %}
                              {{ 'blogs.comments.success' | t }}
                            {% endif %}
                          </p>
                        {% endif %}

                        {% if article.comments_count > 0 %}
                          <ul class="m-comment-list">
                            {% if comment and comment.status != 'published' and comment.id != blank %}
                              <li id="{{ comment.id }}" class="m-comment m-comment--unpublished">
                                <div class="m-comment__author">
                                  {{ comment.author }}
                                </div>
                                <div class="m-comment__content">
                                  {{ comment.content }}
                                </div>
                              </li>
                            {% endif %}

                            {% for comment in article.comments %}
                              <li id="{{ comment.id }}" class="m-comment">
                                <div class="m-comment__meta">
                                  <div class="m-comment__author">{{ comment.author }}</div>
                                  <div class="m-comment__date">
                                    {{ comment.created_at | date: '%b %d, %Y' }}
                                    {{ 'blogs.comments.at_time' | t }}
                                    {{ comment.created_at | date: '%H:%M' }}
                                  </div>
                                </div>
                                <div class="m-comment__content">
                                  {{ comment.content }}
                                </div>
                                <a href="#m-leave-comment" class="m-comment__reply m-button m-button--link">
                                  {{- 'blogs.comments.reply' | t -}}
                                </a>
                              </li>
                            {% endfor %}
                          </ul>

                          {% if paginate.pages > 1 %}
                            {% render 'pagination', paginate: paginate %}
                          {% endif %}
                        {% endif %}
                      </div>
                    {% endpaginate %}
                  </div>
                {% endif %}

                <div class="m-comment-form" id="m-leave-comment">
                  {% form 'new_comment', article %}
                    <div class="m-comment-form__header m:text-center">
                      <h3 class="m-comment-form__heading">{{ 'blogs.comments.title' | t }}</h3>
                      <p class="m-comment-form__text">{{ 'blogs.comments.sub_title' | t }}</p>
                    </div>

                    {% if form.errors %}
                      <ul>
                        {% for error in form.errors %}
                          <li class="notification warning show">
                            <svg
                              class="m-svg-icon"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            {% if error == 'form' %}
                              {{ form.errors.messages[error] }}
                            {% else %}
                              {{ form.errors.translated_fields[error] }} - {{ form.errors.messages[error] }}
                            {% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    <div class="m-comment-form__message">
                      <label for="CommentBody" class="m:hidden">{{ 'blogs.comments.message' | t }}</label>
                      <textarea
                        name="comment[body]"
                        id="CommentBody"
                        class="form-field form-field--input"
                        placeholder="{{ 'blogs.comments.message' | t }}"
                        rows="6"
                      >
                    {{- form.body -}}
                    </textarea>
                    </div>

                    <div class="m-comment-form__fields">
                      <div>
                        <label for="CommentAuthor" class="m:hidden">
                          {{ 'blogs.comments.name' | t }}
                        </label>
                        <input
                          type="text"
                          name="comment[author]"
                          id="CommentAuthor"
                          class="form-field form-field--input"
                          placeholder="{{ 'blogs.comments.name' | t }}"
                          value="{{ form.author }}"
                          autocapitalize="words"
                        >
                      </div>
                      <div>
                        <label for="CommentEmail" class="m:hidden">
                          {{ 'blogs.comments.email' | t }}
                        </label>
                        <input
                          type="email"
                          name="comment[email]"
                          id="CommentEmail"
                          class="form-field form-field--input"
                          placeholder="{{ 'blogs.comments.email' | t }}"
                          value="{{ form.email }}"
                          spellcheck="false"
                          autocomplete="off"
                          autocapitalize="off"
                        >
                      </div>
                    </div>
                    <div class="m-comment-form__submit">
                      <input type="submit" class="m-button m-button--primary" value="{{ 'blogs.comments.post' | t }}">
                    </div>
                  {% endform %}
                </div>
              {%- endif -%}
            </article>
          </div>
        {%- endif -%}
      </div>

      {% if show_sidebar %}
        <div class="m-blog-sidebar">
          {% render 'blog-sidebar' %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ shop.url | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
  {% assign image_size = article.image.width %}
      "image": [
        {{ article | image_url: width: image_size | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      {% if page_image %}
  {% assign image_size = page_image.width %}
        "logo": {
          "@type": "ImageObject",
          "height": {{ page_image.height | json }},
          "url": {{ page_image | image_url: width: image_size | prepend: "https:" | json }},
          "width": {{ page_image.width | json }}
        },
      {% endif %}
      "name": {{ shop.name | json }}
    }
  }
</script>

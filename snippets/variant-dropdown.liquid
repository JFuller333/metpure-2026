<div class="my-4">
  <b>Select a faucet type:</b>
  <span id="faucet-type">
    {% if product.handle contains 'air-gap' %}
    {% elsif product.handle contains 'non-air-gap' %}
      Non-Air Gap
    {% else %}
      Select an option
    {% endif %}
  </span>
</div>

<div class="my-4">
  <div class="custom-select-wrapper">
    <select id="gap-options" class="custom-select" onchange="navigateToLink()">
      <option value="https://www.metpure.com/products/test-water-filtration-faucet-vase-style-chrome-reverse-osmosis-air-gap-with-pre-installed-tubing-certified-by-nsf-copy" data-name="Air Gap" {% if product.handle contains 'air-gap' %}selected{% endif %}>Air Gap</option>
      <option value="https://www.metpure.com/products/test-water-filtration-faucet-vase-style-brushed-nickel-reverse-osmosis-non-air-gap-certified-by-nsf-copy?variant=43569774395583" data-name="Non-Air Gap" {% if product.handle contains 'non-air-gap' %}selected{% endif %}>Non-Air Gap</option>
    </select>
  </div>
</div>

<style>
  .custom-select-wrapper {
    position: relative;
    display: inline-block;
    width: 180px; /* Smaller width for the dropdown */
    padding: 10px 10px 10px 0;
  }

  .custom-select {
    width: 100%;
    padding: 8px 12px; /* Adjusted padding for smaller size */
    font-size: 14px; /* Adjusted font size for smaller dropdown */
    line-height: 1.5;
    border: 1px solid #ccc;
    border-radius: 10px; /* Rounded corners */
    appearance: none;
    background-color: #fff;
    background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%204%205%22%3E%3Cpath%20fill%3D%22%23333%22%20d%3D%22M2%205L0%203h4L2%205zm0-5l2%202H0L2%200z%22/%3E%3C/svg%3E');
    background-repeat: no-repeat;
    background-position: right 10px center;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .custom-select:focus {
    border-color: #007bff;
    outline: none;
  }

  .custom-select::-ms-expand {
    display: none;
  }
</style>

<script>
  function navigateToLink() {
    var selectElement = document.getElementById('gap-options');
    var selectedValue = selectElement.value;
    var selectedText = selectElement.options[selectElement.selectedIndex].getAttribute('data-name');
    document.getElementById('faucet-type').textContent = selectedText;
    if (selectedValue) {
      window.location.href = selectedValue;
    }
  }
</script> 
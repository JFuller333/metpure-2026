{% liquid
  assign enable_variant_group_img = false
  assign variant_groups = product.metafields['foxecom-bs-kit']['variant-images'].value
  if section.settings.enable_variant_group_images and product.metafields['foxecom-bs-kit']['variant-images'].value.enable
    assign enable_variant_group_img = true
  endif
%}

<div class="variant-selector-header">
  <h2 class="selector-title">Select Style: <span class="selected-variant"></span></h2>
</div>

<variant-picker
  data-product-id="{{ product.id }}"
  data-enable-variant-group-images="{{ enable_variant_group_img }}"
  data-section-id="{{ section.id }}"
  data-update-url="{{ update_browser_history }}"
  data-product-url="{{ product.url }}"
  data-disable-selected-variant-default="{{ section.settings.disable_selected_variant_default }}"
  data-show-featured-media="{{ show_featured_media }}"
  data-has-only-default-variant="{{ product.has_only_default_variant }}"
>
  <div class="variant-selector-container">
    <div class="variant-carousel">
      {% for variant in product.variants %}
        {% liquid
          assign variant_image_url = product.featured_image | image_url: width: 800
          if variant.image
            assign variant_image_url = variant.image | image_url: width: 800
          endif
          
          if enable_variant_group_img and variant_groups.mapping
            for media in variant_groups.mapping
              assign media_id = media.id | times: 1
              if media_id == variant.id and media.media.size > 0
                for media_item in media.media
                  assign media_id = media_item | times: 1
                  for product_media in product.media
                    if product_media.id == media_id
                      assign variant_image_url = product_media | image_url: width: 800
                      break
                    endif
                  endfor
                  break
                endfor
                break
              endif
            endfor
          endif
        %}
        
        <div class="variant-option {% if variant.available %}available{% else %}sold-out{% endif %}" 
             data-variant-id="{{ variant.id }}"
             data-price="{{ variant.price | money }}"
             data-variant-name="{{ variant.title }}"
             data-image-url="{{ variant_image_url }}"
             data-option-position="{{ variant.position }}"
             data-option-type="image"
             data-available="{{ variant.available }}">
          
          <div class="variant-image-wrapper">
            <img src="{{ variant_image_url | replace: 'width=800', 'width=300' }}" 
                 alt="{{ variant.title }}"
                 class="variant-image"
                 width="300"
                 height="300"
                 loading="lazy">
                 {% unless variant.available %}
                <div class="sold-out-label">Sold Out</div>
                {% endunless %}
          </div>

          <div class="variant-details">
            <h3 class="variant-title">{{ variant.title }}</h3>
            <span class="variant-price">{{ variant.price | money }}</span>
          </div>

          <!-- Removed radio input -->
        </div>
      {% endfor %}
    </div>
  </div>

  <script id="productVariants" type="application/json">
    {{ product.variants | json }}
  </script>
  
  {%- if section.settings.enable_variant_group_images -%}
    <script id="variantGroup" type="application/json">
      {{ product.metafields.foxecom-bs-kit.variant-images.value | json }}
    </script>
  {%- endif -%}
</variant-picker>

<style>
  .variant-selector-header {
    padding: 15px;
    text-align: left;
  }

  .selector-title {
    font-size: 1.2em;
    margin-bottom: 10px;
    color: #000;
  }

  .selected-variant {
    color: #000;
    font-weight: bold;
  }

  .variant-selector-container {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .variant-selector-container::-webkit-scrollbar {
    display: none;
  }

  .variant-carousel {
    display: flex;
    gap: 15px;
    transition: transform 0.3s ease;
    flex: 1;
    min-width: max-content;
  }

  .variant-option {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 10px;
    transition: all 0.3s ease;
    cursor: pointer;
    min-width: 120px;
    max-width: 120px;
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .variant-option:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .variant-option.sold-out {
    opacity: 0.4;
  }

  .sold-out-label {
  position: absolute;
  top: 8px;
  left: 8px;
  background-color: rgba(244, 85, 85, 0.6);
  color: #fff;
  font-size: 0.7em;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 4px;
  letter-spacing: 0.5px;
  z-index: 2;
  text-transform: uppercase;
}

.variant-image-wrapper {
  position: relative;
}

  /* Active variant styling - blue outline */
  .variant-option.active {
    border: 2px solid #0066cc;
  }

  .variant-image-wrapper {
    width: 100%;
    margin-bottom: 10px;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .variant-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .variant-option:hover .variant-image {
    transform: scale(1.05);
  }

  .variant-details {
    text-align: center;
  }

  .variant-title {
    font-size: 0.8em;
    margin-bottom: 8px;
    color: #333;
    line-height: 1.2;
  }

  .variant-price {
    display: block;
    font-size: 0.9em;
    font-weight: bold;
    color: #000;
    margin-bottom: 6px;
  }

  /* Desktop: Show original grid layout */
  @media screen and (min-width: 1200px) {
    .variant-selector-container {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }
    
    .variant-carousel {
      display: contents;
    }
    
    .variant-option {
      min-width: unset;
      max-width: unset;
      width: 100%;
    }
  }

  @media screen and (max-width: 1199px) {
    .variant-selector-container {
      display: flex;
      gap: 10px;
    }
    
    .variant-carousel {
      display: flex;
      gap: 15px;
    }
    
    .variant-option {
      min-width: 120px;
      max-width: 120px;
      flex-shrink: 0;
    }
  }

  @media screen and (max-width: 768px) {
    .variant-selector-container {
      padding: 10px;
      gap: 8px;
    }

    .variant-option {
      min-width: 100px;
      max-width: 100px;
      padding: 8px;
    }

    .variant-title {
      font-size: 0.7em;
    }

    .variant-price {
      font-size: 0.8em;
    }

    .selector-title {
      font-size: 1em;
    }
  }

  @media screen and (max-width: 480px) {
    .variant-option {
      min-width: 90px;
      max-width: 90px;
      padding: 6px;
    }

    .variant-title {
      font-size: 0.65em;
    }

    .variant-price {
      font-size: 0.75em;
    }
  }

/* Tablet */
@media (max-width: 768px) {
  .sold-out-label {
    top: 5%;
    left: 5%;
    padding: 3px 6px;
    font-size: clamp(0.5rem, 2vw, 0.7rem);
  }
}

/* Mobile */
@media (max-width: 480px) {
  .sold-out-label {
    top: 4%;
    left: 4%;
    padding: 2px 5px;
    font-size: clamp(0.45rem, 3vw, 0.65rem);
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const variantOptions = document.querySelectorAll('.variant-option');
    const selectedVariantSpan = document.querySelector('.selected-variant');
    const productImages = document.querySelectorAll('.product__media-item img, .m-product-media img');
    const productTitle = document.querySelector('.m-product-title');
    const originalTitle = productTitle ? productTitle.textContent : '';
    const addToCartButton = document.querySelector('[name="add"]');
    
    function updateVariantDisplay(variantName) {
      if (selectedVariantSpan) {
        selectedVariantSpan.textContent = variantName;
      }
      if (productTitle) {
        productTitle.textContent = `${originalTitle} - ${variantName}`;
      }
    }

    function updateAddToCartButton(isAvailable) {
      console.log('🔍 DEBUG: updateAddToCartButton called with:', isAvailable);
      
      // Find all add to cart buttons
      const addToCartButtons = document.querySelectorAll('[name="add"], .btn-add-to-cart, .add-to-cart, [data-add-to-cart]');
      console.log('🔍 DEBUG: Found', addToCartButtons.length, 'add to cart buttons');
      
      addToCartButtons.forEach((button, index) => {
        console.log(`🔍 DEBUG: Button ${index}:`, button, 'Current state:', {
          disabled: button.disabled,
          textContent: button.textContent,
          classes: button.className
        });
        
        if (isAvailable) {
          button.textContent = 'Add to Cart';
          button.disabled = false;
          button.classList.remove('disabled', 'btn-disabled', 'm-btn--disabled');
          button.classList.add('enabled', 'btn-enabled');
          button.removeAttribute('disabled');
          console.log(`🔍 DEBUG: Enabled button ${index}`);
        } else {
          button.textContent = 'Unavailable';
          button.disabled = true;
          button.classList.add('disabled', 'btn-disabled', 'm-btn--disabled');
          button.classList.remove('enabled', 'btn-enabled');
          button.setAttribute('disabled', 'disabled');
          console.log(`🔍 DEBUG: Disabled button ${index}`);
        }
      });
    }

    function updateProductImages(imageUrl) {
      console.log('🔍 DEBUG: updateProductImages called with:', imageUrl);
      
      // Only update the main product image, not thumbnails
      // This prevents thumbnails from showing the same image repeatedly
      const mainImageSelectors = [
        // Desktop selectors
        '.product__media-item img:first-child',
        '.m-product-media img:first-child', 
        '.main-product-image img',
        '.product__media img:first-child',
        '.product-media img:first-child',
        '.media-gallery img:first-child',
        '.product-gallery img:first-child',
        '.product__media-wrapper img:first-child',
        // Mobile gallery selectors
        'media-gallery-mobile .swiper-slide:first-child img',
        'media-gallery-mobile .m-product-media--item:first-child img',
        'media-gallery-mobile .swiper-slide[data-index="0"] img',
        'media-gallery-mobile .m-product-media--slider__images img:first-child'
      ];
      
      let imagesUpdated = 0;
      
      mainImageSelectors.forEach(selector => {
        const images = document.querySelectorAll(selector);
        images.forEach(img => {
          // More comprehensive thumbnail detection
          const isThumbnail = img.closest('.thumbnail, .thumb, .media-thumb, .gallery-thumb, [data-thumbnail], .m-product-media--slider__thumbnails, .nav-swiper-container, .swiper-slide:not(:first-child)');
          
          // Also check if this is in a thumbnail container or not the first slide
          const isInThumbnailContainer = img.closest('.m-product-media--slider__thumbnails') || 
                                       img.closest('.nav-swiper-container') ||
                                       img.closest('.swiper-slide:not(:first-child)') ||
                                       img.closest('.swiper-slide[data-index]:not([data-index="0"])');
          
          // Only update if this is definitely the main image, not any thumbnail
          if (!isThumbnail && !isInThumbnailContainer) {
            console.log('🔍 DEBUG: Updating main image:', img, 'from', img.src, 'to', imageUrl);
            
            // Add cache-busting parameter to force image reload on mobile
            const cacheBuster = '?v=' + Date.now();
            const imageUrlWithCacheBuster = imageUrl + cacheBuster;
            
            img.src = imageUrlWithCacheBuster;
            img.srcset = '';
            
            // Force image reload by temporarily changing src
            img.style.opacity = '0.8';
            setTimeout(() => {
              img.style.opacity = '1';
            }, 100);
            
            imagesUpdated++;
          } else {
            console.log('🔍 DEBUG: Skipping thumbnail image:', img);
          }
        });
      });
      
      console.log('🔍 DEBUG: Updated', imagesUpdated, 'main images (thumbnails preserved)');
      
      // Also try to update any media gallery components
      const mediaGalleries = document.querySelectorAll('media-gallery, media-gallery-mobile');
      mediaGalleries.forEach(gallery => {
        if (gallery.updateVariantImage) {
          console.log('🔍 DEBUG: Calling gallery.updateVariantImage');
          gallery.updateVariantImage(imageUrl);
        }
      });
      
      // Specifically target mobile gallery for variant group images
      const mobileGallery = document.querySelector('media-gallery-mobile');
      if (mobileGallery) {
        console.log('🔍 DEBUG: Found mobile gallery, updating variant images');
        
        // Try to call mobile gallery's variant update method
        if (mobileGallery.updateVariantImages) {
          mobileGallery.updateVariantImages(imageUrl);
        }
        
        // Also try to update the first slide image directly
        const firstSlide = mobileGallery.querySelector('.swiper-slide:first-child img, .m-product-media--item:first-child img');
        if (firstSlide) {
          console.log('🔍 DEBUG: Updating mobile gallery first slide image');
          const cacheBuster = '?mobile=' + Date.now();
          firstSlide.src = imageUrl + cacheBuster;
          firstSlide.srcset = '';
        }
      }
      
      // Additional mobile-specific cache busting - ONLY for main images
      if (window.innerWidth <= 768) {
        console.log('🔍 DEBUG: Mobile detected, applying additional cache busting to main images only');
        
        // Only target the main product image, not thumbnails
        const mainImageSelectors = [
          'media-gallery-mobile .swiper-slide:first-child img',
          'media-gallery-mobile .m-product-media--item:first-child img',
          'media-gallery-mobile .swiper-slide[data-index="0"] img'
        ];
        
        mainImageSelectors.forEach(selector => {
          const mainImages = document.querySelectorAll(selector);
          mainImages.forEach(img => {
            // Double-check this is not a thumbnail
            const isThumbnail = img.closest('.m-product-media--slider__thumbnails, .nav-swiper-container');
            if (!isThumbnail) {
              console.log('🔍 DEBUG: Mobile cache busting main image:', img);
              const currentSrc = img.src.split('?')[0]; // Remove existing cache busters
              const newSrc = currentSrc + '?mobile=' + Date.now();
              img.src = newSrc;
            }
          });
        });
      }
    }

    function updateProductPrice(variantPrice, variantComparePrice, variantId) {
      console.log('🔍 DEBUG: updateProductPrice called with:', variantPrice, variantComparePrice, variantId);
      
      // Clean the price data - remove HTML tags and extract just the price
      function cleanPrice(priceString) {
        if (!priceString) return '';
        // Remove HTML tags and extract just the price
        const cleanPrice = priceString.replace(/<[^>]*>/g, '').trim();
        console.log('🔍 DEBUG: Cleaned price from', priceString, 'to', cleanPrice);
        return cleanPrice;
      }
      
      const cleanVariantPrice = cleanPrice(variantPrice);
      const cleanVariantComparePrice = cleanPrice(variantComparePrice);
      
      // Get the actual variant data to check for compare_at_price
      let actualComparePrice = null;
      if (variantId) {
        const variantPicker = document.querySelector('variant-picker');
        if (variantPicker && variantPicker.productData && variantPicker.productData.variants) {
          const variant = variantPicker.productData.variants.find(v => v.id === Number(variantId));
          if (variant && variant.compare_at_price && variant.compare_at_price > variant.price) {
            actualComparePrice = variant.compare_at_price;
            console.log('🔍 DEBUG: Found compare_at_price:', actualComparePrice, 'for variant:', variantId);
          }
        }
      }
      
      // Try to update price using theme's price elements
      const priceWrapper = document.querySelector('.main-product__block-price .m-price');
      console.log('🔍 DEBUG: priceWrapper found:', priceWrapper);
      
      if (priceWrapper) {
        const salePrice = priceWrapper.querySelector('.m-price-item--sale');
        const regularPrice = priceWrapper.querySelector('.m-price-item--regular');
        console.log('🔍 DEBUG: salePrice found:', salePrice);
        console.log('🔍 DEBUG: regularPrice found:', regularPrice);
        
        // Determine if this is a sale price
        const isOnSale = actualComparePrice && actualComparePrice > parseFloat(cleanVariantPrice.replace(/[^0-9.]/g, ''));
        
        if (salePrice) {
          if (isOnSale) {
            // Show sale price
            salePrice.textContent = cleanVariantPrice;
            salePrice.style.display = 'inline';
            console.log('🔍 DEBUG: Updating salePrice to:', cleanVariantPrice);
          } else {
            // Hide sale price if not on sale
            salePrice.style.display = 'none';
          }
        }
        
        if (regularPrice) {
          if (isOnSale) {
            // Show compare at price as regular price (will be strikethrough)
            regularPrice.textContent = formatPrice(actualComparePrice);
            regularPrice.style.display = 'inline';
            console.log('🔍 DEBUG: Updating regularPrice (compare at) to:', formatPrice(actualComparePrice));
          } else {
            // Show regular price
            regularPrice.textContent = cleanVariantPrice;
            regularPrice.style.display = 'inline';
            console.log('🔍 DEBUG: Updating regularPrice to:', cleanVariantPrice);
          }
        }
        
        // Update price classes for sale state
        if (isOnSale) {
          priceWrapper.classList.add('m-price--on-sale');
          console.log('🔍 DEBUG: Added m-price--on-sale class');
        } else {
          priceWrapper.classList.remove('m-price--on-sale');
          console.log('🔍 DEBUG: Removed m-price--on-sale class');
        }
      }
      
      // Also try to update any other price elements
      const allPriceElements = document.querySelectorAll('.m-price-item--sale, .m-price-item--regular');
      console.log('🔍 DEBUG: Found', allPriceElements.length, 'price elements');
      
      const isOnSale = actualComparePrice && actualComparePrice > parseFloat(cleanVariantPrice.replace(/[^0-9.]/g, ''));
      
      allPriceElements.forEach((element, index) => {
        console.log(`🔍 DEBUG: Price element ${index}:`, element, 'Current text:', element.textContent);
        if (element.classList.contains('m-price-item--sale')) {
          if (isOnSale) {
            element.textContent = cleanVariantPrice;
            element.style.display = 'inline';
            console.log(`🔍 DEBUG: Updated sale price element ${index} to:`, cleanVariantPrice);
          } else {
            element.style.display = 'none';
          }
        } else if (element.classList.contains('m-price-item--regular')) {
          if (isOnSale) {
            element.textContent = formatPrice(actualComparePrice);
            element.style.display = 'inline';
            console.log(`🔍 DEBUG: Updated regular price element ${index} to:`, formatPrice(actualComparePrice));
          } else {
            element.textContent = cleanVariantPrice;
            element.style.display = 'inline';
            console.log(`🔍 DEBUG: Updated regular price element ${index} to:`, cleanVariantPrice);
          }
        }
      });
    }
    
    // Helper function to format price
    function formatPrice(price) {
      if (!price) return '';
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD'
      }).format(price / 100);
    }
    
    // Force form validation to recognize variant selection
    function forceFormValidation(variantId, isAvailable) {
      console.log('🔍 DEBUG: forceFormValidation called with:', variantId, isAvailable);
      
      // Find the product form
      const productForm = document.querySelector('form[action*="/cart/add"], .product-form, [data-product-form]');
      if (productForm) {
        console.log('🔍 DEBUG: Found product form:', productForm);
        
        // Set data attributes that the theme might be checking
        productForm.setAttribute('data-variant-id', variantId);
        productForm.setAttribute('data-variant-selected', 'true');
        
        // Trigger form validation events
        const formEvent = new Event('variant:change', { bubbles: true });
        productForm.dispatchEvent(formEvent);
        
        // Also try other common variant change events
        const variantChangeEvent = new Event('variantchange', { bubbles: true });
        productForm.dispatchEvent(variantChangeEvent);
        
        const productChangeEvent = new Event('product:change', { bubbles: true });
        productForm.dispatchEvent(productChangeEvent);
        
        console.log('🔍 DEBUG: Dispatched form validation events');
      }
      
      // Update any product form components
      const productFormComponents = document.querySelectorAll('product-form, .product-form-component');
      productFormComponents.forEach(component => {
        if (component.onVariantChange) {
          component.onVariantChange();
        }
        if (component.updateVariant) {
          component.updateVariant(variantId);
        }
        console.log('🔍 DEBUG: Updated product form component:', component);
      });
      
      // Force update add to cart button state again
      updateAddToCartButton(isAvailable);
    }

    // Set initial variant display
    const selectedVariant = document.querySelector('.variant-option[data-variant-id]');
    if (selectedVariant) {
      const initialVariantId = selectedVariant.dataset.variantId;
      const initialVariantOption = document.querySelector(`[data-variant-id="${initialVariantId}"]`);
      if (initialVariantOption) {
        updateVariantDisplay(initialVariantOption.dataset.variantName);
        updateProductImages(initialVariantOption.dataset.imageUrl);
        updateAddToCartButton(initialVariantOption.dataset.available === 'true');
        updateProductPrice(initialVariantOption.dataset.price, null, initialVariantId);
      }
    }

    variantOptions.forEach(option => {
      option.addEventListener('mouseover', function() {
        const variantName = this.dataset.variantName;
        if (variantName) {
          updateVariantDisplay(variantName);
        }
      });

      // Handle variant selection for both click and touch events
      function handleVariantSelection(event) {
        // Prevent default to avoid double-firing
        event.preventDefault();
        event.stopPropagation();
        
        console.log('🔍 DEBUG: Variant selection triggered!');
        console.log('🔍 DEBUG: Event type:', event.type);
        console.log('🔍 DEBUG: Clicked element:', this);
        console.log('🔍 DEBUG: All dataset values:', this.dataset);
        
        if (!this.classList.contains('sold-out')) {
          // Remove active class from all variants
          variantOptions.forEach(opt => opt.classList.remove('active'));
          
          // Add active class to clicked variant
          this.classList.add('active');
          
          const variantId = this.dataset.variantId;
          const variantName = this.dataset.variantName;
          const imageUrl = this.dataset.imageUrl;
          const isAvailable = this.dataset.available === 'true';
          const variantPrice = this.dataset.price;
          
          console.log('🔍 DEBUG: Extracted data:');
          console.log('  - variantId:', variantId);
          console.log('  - variantName:', variantName);
          console.log('  - variantPrice:', variantPrice);
          console.log('  - imageUrl:', imageUrl);
          console.log('  - isAvailable:', isAvailable);
          
          // Debug: Check if we have variant group images
          const variantGroupData = document.getElementById('variantGroup');
          if (variantGroupData) {
            console.log('🔍 DEBUG: Variant group data found:', JSON.parse(variantGroupData.textContent));
          } else {
            console.log('🔍 DEBUG: No variant group data found');
          }
          
          updateVariantDisplay(variantName);
          updateAddToCartButton(isAvailable);
          updateProductPrice(variantPrice, null, variantId);
          updateProductImages(imageUrl);
          
          // Force form validation to recognize variant selection
          setTimeout(() => {
            forceFormValidation(variantId, isAvailable);
          }, 100);

          // Call theme's variant selection function if available
          if (typeof window.selectVariant === 'function') {
            window.selectVariant(variantId);
          }
          
          // Also try to trigger the variant picker's internal methods
          const variantPicker = document.querySelector('variant-picker');
          if (variantPicker) {
            // Set the current variant in the theme's variant picker
            variantPicker.currentVariant = variantPicker.productData.variants.find(v => v.id === Number(variantId));
            
            // Call the theme's method to get variant group images
            if (variantPicker.getDataImageVariant) {
              variantPicker.getDataImageVariant(Number(variantId));
            }
            
            // Call the theme's method to update media
            if (variantPicker.updateMedia) {
              variantPicker.updateMedia();
            }
            
            // Trigger the variant picker's change event to update prices
            variantPicker.dispatchEvent(new Event('change', { bubbles: true }));
          }
          
          const url = new URL(window.location.href);
          url.searchParams.set('variant', variantId);
          window.history.replaceState({}, '', url);

          // Update all variant-related inputs
          const variantInputs = document.querySelectorAll('input[name="id"]');
          console.log('🔍 DEBUG: Found', variantInputs.length, 'variant inputs');
          
          variantInputs.forEach((input, index) => {
            console.log(`🔍 DEBUG: Updating variant input ${index}:`, input, 'from', input.value, 'to', variantId);
            input.value = variantId;
            input.checked = input.id === `variant-${variantId}`;
            
            // Trigger change event on each input
            const changeEvent = new Event('change', { bubbles: true });
            input.dispatchEvent(changeEvent);
            console.log(`🔍 DEBUG: Dispatched change event on input ${index}`);
          });

          // Also update any radio inputs for variants
          const radioInputs = document.querySelectorAll('input[type="radio"][name*="option"], input[type="radio"][data-option]');
          radioInputs.forEach(radio => {
            if (radio.value === variantId || radio.dataset.variantId === variantId) {
              radio.checked = true;
              radio.dispatchEvent(new Event('change', { bubbles: true }));
              console.log('🔍 DEBUG: Updated radio input:', radio);
            }
          });

          // Update any select elements for variants
          const selectInputs = document.querySelectorAll('select[name*="option"], select[data-option]');
          selectInputs.forEach(select => {
            const option = select.querySelector(`option[value="${variantId}"]`);
            if (option) {
              select.value = variantId;
              select.dispatchEvent(new Event('change', { bubbles: true }));
              console.log('🔍 DEBUG: Updated select input:', select);
            }
          });
        }
      }

      // Add both click and touch event listeners
      option.addEventListener('click', handleVariantSelection);
      option.addEventListener('touchend', handleVariantSelection);
      
      // Add touch feedback for better UX
      option.addEventListener('touchstart', function() {
        this.style.transform = 'scale(0.95)';
      });
      
      option.addEventListener('touchend', function() {
        this.style.transform = 'scale(1)';
      });
    });

    // Set initial active state
    const initialSelectedVariant = document.querySelector('.variant-option[data-variant-id]');
    if (initialSelectedVariant) {
      initialSelectedVariant.classList.add('active');
    }
  });
</script>

{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

{% comment %}
  Accepts:
  - style: {String} Accepted value: bordered/minimal (optional)
  - button_style: {String} Button style (optional)
  - button_type: {String} Accepted value: text/icon (optional)
  - button_label: {String} (optional)
  - button_link: {String} URL the button will link to (optional)
  - extra_classes: {String} Extra classes (optional)

  Usage:
  {% render 'newsletter-button',
    style: 'bordered',
    button_type: 'text',
    button_label: 'Subscribe',
    button_link: '/subscribe',
    extra_classes: 'custom-class'
  %}
{% endcomment %}

{% comment %}
  Accepts:
  - style: {String} Accepted value: bordered/minimal (optional)
  - button_style: {String} Button style (optional)
  - button_type: {String} Accepted value: text/icon (optional)
  - button_label: {String} (optional)
  - extra_classes: {String} Extra classes (optional)

  Usage:
  {% render 'newsletter-button',
    style: 'bordered',
    button_type: 'text',
    button_label: 'Subscribe',
    extra_classes: 'custom-class'
  %}
{% endcomment %}

<div class="m-newsletter-button m-newsletter-button--{{ style | default: 'bordered' }} {{ extra_classes }}" style="padding-top: 20px; padding-bottom: 20px;">
  <a href="https://www.metpure.com/pages/met-pro-onboarding" class="m-newsletter-button__link m-button {{ button_style }}" aria-label="{{ button_label | default: 'Subscribe' }}">
    {% if button_type == 'icon' %}
      <svg class="m-svg-icon" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
        <path d="M218.101 38.101L198.302 57.9c-4.686 4.686-4.686 12.284 0 16.971L353.432 230H12c-6.627 0-12 5.373-12 12v28c0 6.627 5.373 12 12 12h341.432l-155.13 155.13c-4.686 4.686-4.686 12.284 0 16.971l19.799 19.799c4.686 4.686 12.284 4.686 16.971 0l209.414-209.414c4.686-4.686 4.686-12.284 0-16.971L235.071 38.101c-4.686-4.687-12.284-4.687-16.97 0z"/>
      </svg>
    {% else %}
      <span>{{ button_label | default: 'Subscribe' }}</span>
    {% endif %}
  </a>
</div>
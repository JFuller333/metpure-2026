    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
    font-size: 0 !important;
    border: none !important;
    background: none !important;
  }
  .main-product__block + .main-product__block--trust_badge,
  .main-product__block--trust_badge + .main-product__block {
    margin-top: 0 !important;
  }
  .main-product__block .m-product-trust-badge {
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 0 !important;
  }
  .main-product__block .m-product-trust-badge__content {
    margin-top: 0 !important;
  }
  .main-product__block--trust_badge > div {
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
  }
  .trust-badge-content {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: nowrap !important;
    margin: -30px 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
    font-size: 0 !important;
  }
  .trust-badge-image {
    flex-shrink: 0 !important;
    width: 400px !important;
    height: 267px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
  }
  .trust-badge-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
  }
  @media (max-width: 768px) {
    .trust-badge-image {
      width: 350px !important;
      height: 233px !important;
    }
  }
  @media (max-width: 480px) {
    .trust-badge-image {
      width: 280px !important;
      height: 187px !important;
    }
  }
</style>
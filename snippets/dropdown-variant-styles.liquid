<div class="dropdown">
  <div class="dropdown-header">
    <span class="dropdown-title">Select a Style:</span>
    <span class="selected-item"></span>
  </div>
  <button class="dropdown-btn">Select Option</button>
  <div class="dropdown-content">
    <div class="dropdown-item" data-value="Vase">
      <img src="https://www.metpure.com/cdn/shop/files/CHR-NAG_36be8c34-c3a6-41fc-8d5b-59cc6fb9a6dc.png?v=1717012085" alt="Vase">
      <span>Vase</span>
    </div>
    <div class="dropdown-item" data-value="Small Euro">
      <img src="https://www.metpure.com/cdn/shop/files/CHR-NAG_36be8c34-c3a6-41fc-8d5b-59cc6fb9a6dc.png?v=1717012085" alt="Small Euro">
      <span>Small Euro</span>
    </div>
    <div class="dropdown-item" data-value="Large Euro">
      <img src="https://www.metpure.com/cdn/shop/files/CHR-NAG_36be8c34-c3a6-41fc-8d5b-59cc6fb9a6dc.png?v=1717012085" alt="Large Euro">
      <span>Large Euro</span>
    </div>
    <div class="dropdown-item" data-value="Long Reach">
      <img src="https://www.metpure.com/cdn/shop/files/CHR-NAG_36be8c34-c3a6-41fc-8d5b-59cc6fb9a6dc.png?v=1717012085" alt="Long Reach">
      <span>Long Reach</span>
    </div>
  </div>
</div>

<style>
.dropdown {
  position: relative;
  display: inline-block;
  padding: 0px;
}

.dropdown-header {
  margin-bottom: 8px;
}

.dropdown-title {
  font-weight: bold;
  margin-right: 10px;
}

.selected-item {
  color: #666;
}

.dropdown-btn {
   width: 100%;
    padding: 8px 12px; /* Adjusted padding for smaller size */
    font-size: 14px; /* Adjusted font size for smaller dropdown */
    line-height: 1.5;
    border: 1px solid #ccc;
    border-radius: 10px; /* Rounded corners */
    appearance: none;
    background-color: #fff;
    background-repeat: no-repeat;
    background-position: right 10px center;
    cursor: pointer;
    transition: border-color 0.2s;
    text-align: justify;
}

.dropdown-content {
  display: none;
  position: absolute;
  background-color: white;
  min-width: 200px;
  box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
  z-index: 1;
  border: 1px solid black;
  border-radius: 8px;
  margin-top: 5px;
}

.dropdown:hover .dropdown-content {
  display: block;
}

.dropdown-item {
  padding: 12px 16px;
  display: flex;
  align-items: center;
  cursor: pointer;
}

.dropdown-item:hover {
  background-color: #f1f1f1;
}

.dropdown-item img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  margin-right: 10px;
  border-radius: 50%;
}

.dropdown-item span {
  font-size: 14px;
}
</style>

<script>
document.querySelectorAll('.dropdown-item').forEach(item => {
  item.addEventListener('click', function() {
    const value = this.getAttribute('data-value');
    document.querySelector('.selected-item').textContent = value;
    document.querySelector('.dropdown-btn').textContent = value;
    
    // Update product title
    const productTitle = document.querySelector('.m-product-title');
    if (productTitle) {
      const originalTitle = productTitle.getAttribute('data-original-title') || productTitle.textContent;
      productTitle.setAttribute('data-original-title', originalTitle);
      productTitle.textContent = originalTitle + ' - ' + value;
    }
  });
});
</script>

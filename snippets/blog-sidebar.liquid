<!-- Collection Display -->
{% if selected_collection and selected_collection.products.size > 0 %}
  <div class="collection-display">
    <h3 style="text-align: center; font-size: 28px; color: #009B9F; font-weight: bold; margin-bottom: 5px;">SHOP</h3> 
    <h4 style="text-align: center; font-size: 22px; color: black; font-weight: 400; margin-bottom: 20px;">{{ applied_tag }}</h4> <!-- Display applied tag --> 
    <div class="products-grid"> 
      {% for product in selected_collection.products limit: 5 %}
        <div class="product-item">
          <a href="{{ product.url }}" class="product-link">
            <img src="{{ product.featured_image | img_url: 'large' }}" alt="{{ product.title }}" class="product-image" />
            <div class="product-info">
              <span class="product-title">{{ product.title }}</span>
            </div>
          </a>
          <a href="{{ product.url }}" class="buy-now-button">Buy Now</a>
        </div>
      {% endfor %}
    </div>
  </div>
{% else %}
  <p>No products found in this collection.</p>
{% endif %}

<!-- Styles for the Collection Display -->
<style>
.collection-display {
  margin-top: 10px;
  background-color: #f9f9f9; /* Use white background for contrast */
  padding: 20px; 
  border-radius: 10px; /* Rounded corners */
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Subtle shadow */ 
}

.products-grid {
  display: grid; /* Use grid layout for products */
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); /* Responsive grid */
  gap: 20px; /* Space between items */
}

.product-item {
  background-color: #ffffff; /* Light background for product items */
  border-radius: 8px; /* Rounded corners */
  padding: 15px;
  text-align: center; /* Centered text */
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* Subtle shadow */
  transition: transform 0.3s; /* Animation effect */
}

.product-item:hover {
  transform: translateY(-5px); /* Lift effect on hover */
}

.product-link {
  text-decoration: none;
  color: #333; /* Text color */
}

.product-image {
  max-width: 100%; /* Responsive images */
  height: auto;
  margin-bottom: 10px; /* Spacing below the image */
  border-radius: 5px; /* Rounded image corners */
}

.product-title {
  font-size: 16px; /* Size of product title */
  margin: 10px 0; /* Margin around title */
  display: block; /* Ensure title is on its own line */
  padding-bottom: 10px;
}

.buy-now-button {
  background-color: #52A09E; /* Button background color */
  color: white; /* Button text color */
  padding: 10px 15px; /* Padding */
  border-radius: 5px; /* Rounded corners */
  text-align: center; /* Centered text */
  text-decoration: none; /* Remove underline */
  margin: 20px 0; /* Space on top and bottom of the button */
  transition: background-color 0.3s; /* Transition effect */
}

.buy-now-button:hover {
  background-color: #3f8a76; /* Darker shade on hover */
}
</style>  